+func loadFixture(t *testing.T) fixture {
+	t.Helper()
+	dir, appID := os.Getenv("APPLEATTEST_FIXTURES"), os.Getenv("APPLEATTEST_APPID")
+	if dir == "" || appID == "" {
+		t.Skip("APPLEATTEST_FIXTURES / APPLEATTEST_APPID not set — real App Attest fixtures live outside the repo")
+	}
+	read := func(name string) probeJSON {
+		b, err := os.ReadFile(filepath.Join(dir, name))
+		require.NoError(t, err)
+		var p probeJSON
+		require.NoError(t, json.Unmarshal(b, &p))
+		return p
+	}
+	dec := func(s string) []byte {
+		b, err := base64.StdEncoding.DecodeString(s)
+		require.NoError(t, err)
+		return b
+	}
+	hash := func(b []byte) []byte { h := sha256.Sum256(b); return h[:] }
+
+	att := read("attest.json")
+	matches, _ := filepath.Glob(filepath.Join(dir, "assert-*.json"))
+	require.NotEmpty(t, matches, "need at least one assert-*.json")
+	as := read(filepath.Base(matches[0]))
+	return fixture{
+		appID: appID, attObj: dec(att.Attestation), keyID: dec(att.KeyID), attCDH: hash(dec(att.ClientData)),
+		assertObj: dec(as.Assertion), assertCDH: hash(dec(as.ClientData)),
+	}
