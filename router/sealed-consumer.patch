+	_, err := VerifyAttestation(Config{AppID: "A.b", AllowAnyCode: true, MinOSVersion: "v27.1"}, []byte{0xa0}, make([]byte, 32), make([]byte, 32))
+	require.ErrorIs(t, err, ErrConfig, "a malformed minimum must not pass every device")
+}
