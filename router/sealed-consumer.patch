new file mode 100644
index 00000000..2c260c55
--- /dev/null
+++ b/proxy-router/internal/sealed/codesig/compare.go
@@ -0,0 +1,595 @@
+package codesig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+// Expect is what the published app must be: the engine's identity, and
+// optionally the CD hash that was published for it.
+type Expect struct {
+	Team     string
+	BundleID string
+	CDHash   []byte // optional; when set, the published app must have exactly this CD hash
+}
+
+type Check struct {
+	Name   string `json:"name"`
+	Pass   bool   `json:"pass"`
+	Detail string `json:"detail"`
+}
+
+type Result struct {
+	CDHash string  `json:"cdhash"` // what App Attest reports for the published app
+	Checks []Check `json:"checks"`
+	OK     bool    `json:"ok"`
+}
+
+func (r *Result) add(name string, err error, okDetail string) bool {
+	if err != nil {
+		r.Checks = append(r.Checks, Check{name, false, err.Error()})
+		return false
+	}
+	r.Checks = append(r.Checks, Check{name, true, okDetail})
+	return true
+}
+
+const exeRel = "Contents/MacOS/SealedEngine"
+
+// Signer-only files: they exist only in the signed app and are not compared
+// with the rebuild (the profile's contents are checked separately).
+var signerOnly = map[string]bool{
+	"Contents/_CodeSignature/CodeResources": true,
+	"Contents/embedded.provisionprofile":    true,
+}
+
+// Compare checks a published signed app against a verifier's unsigned rebuild.
+// Every check runs where it can, so the report names every mismatch; OK is
+// true only if all of them pass.
+func Compare(publishedApp, rebuildApp string, want Expect) *Result {
+	r := &Result{}
+	if want.Team == "" || want.BundleID == "" {
+		r.add("configuration", errors.New("team and bundle ID are required"), "")
+		return r
+	}
+	appID := want.Team + "." + want.BundleID
+
+	pubFiles, err1 := bundleFiles(publishedApp)
+	rebFiles, err2 := bundleFiles(rebuildApp)
+	if !r.add("bundle layout", errors.Join(err1, err2, layout(pubFiles, rebFiles)),
+		fmt.Sprintf("%d files; the same set in both apart from the signature and the provisioning profile", len(rebFiles))) {
+		return r
+	}
+
+	sig, err := ReadSignature(filepath.Join(publishedApp, exeRel))
+	if !r.add("signature", err, "one SHA-256 CodeDirectory, CMS signature present") {
+		return r
+	}
+	if !sig.HasCMS {
+		r.add("signature", errors.New("no CMS signature: the app is ad-hoc signed"), "")
+	}
+	cd := sig.CD
+	cdh := cd.CDHash()
+	r.CDHash = hex.EncodeToString(cdh[:])
+
+	if len(want.CDHash) > 0 {
+		var err error
+		if !bytes.Equal(want.CDHash, cdh[:]) {
+			err = fmt.Errorf("published app's CD hash is %s, not the expected %s", r.CDHash, hex.EncodeToString(want.CDHash))
+		}
+		r.add("published CD hash", err, r.CDHash)
+	}
+
+	var idErr error
+	if cd.Identifier != want.BundleID {
+		idErr = fmt.Errorf("CodeDirectory identifier %q, want %q", cd.Identifier, want.BundleID)
+	} else if cd.TeamID != want.Team {
+		idErr = fmt.Errorf("CodeDirectory team %q, want %q", cd.TeamID, want.Team)
+	}
+	r.add("identity", idErr, appID)
+
+	r.add("code flags", codeFlags(cd), fmt.Sprintf("flags %#x (hardened runtime), exec-segment flags %#x", cd.Flags, cd.ExecSegFlags))
+
+	rebExe, err := os.ReadFile(filepath.Join(rebuildApp, exeRel))
+	if err == nil {
+		err = compareExecutable(sig, rebExe)
+	}
+	r.add("executable", err, fmt.Sprintf("all %d code pages match the rebuild; page 0 differs only in the signature's header fields", len(cd.Pages)))
+
+	r.add("Info.plist", slotFileMatch(cd, specialInfo, filepath.Join(publishedApp, "Contents/Info.plist"), filepath.Join(rebuildApp, "Contents/Info.plist")),
+		"special slot -1 equals the rebuild's Info.plist")
+
+	r.add("resources", resources(cd, publishedApp, rebuildApp, pubFiles),
+		"CodeResources seals every bundle file except PkgInfo (omitted by Apple's default rule, compared directly), each equal to the rebuild's")
+
+	r.add("entitlements", entitlements(sig, want), "XML and DER entitlements are exactly: application identifier, team identifier, App Attest CD-hash opt-in")
+
+	r.add("requirements", requirements(sig, want), "designated requirement names the bundle ID (the certificate it names is signer-only)")
+
+	r.add("unused slots", unusedSlots(cd), "special slots -4 and -6 are empty")
+
+	r.add("provisioning profile", profile(publishedApp, want), "names "+appID+", grants App Attest opt-in, no get-task-allow")
+
+	r.OK = true
+	for _, c := range r.Checks {
+		r.OK = r.OK && c.Pass
+	}
+	return r
+}
+
+// bundleFiles lists a bundle's regular files relative to the bundle root.
+// Anything else except directories (symlinks, devices, FIFOs) is refused.
+func bundleFiles(root string) (map[string]bool, error) {
+	files := map[string]bool{}
+	err := filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, _ := filepath.Rel(root, p)
+		switch {
+		case d.IsDir():
+			return nil
+		case d.Type().IsRegular():
+			files[filepath.ToSlash(rel)] = true
+			return nil
+		}
+		return fmt.Errorf("%s: %s is not a regular file", filepath.Base(root), rel)
+	})
+	return files, err
+}
+
+func layout(pub, reb map[string]bool) error {
+	var errs []error
+	if !reb[exeRel] || !pub[exeRel] {
+		errs = append(errs, errors.New("missing "+exeRel))
+	}
+	for f := range pub {
+		if strings.HasPrefix(f, "Contents/MacOS/") && f != exeRel {
+			errs = append(errs, errors.New("extra file in Contents/MacOS: "+f))
+		}
+		if strings.Contains(f, "_CodeSignature/") && !signerOnly[f] {
+			errs = append(errs, errors.New("nested code signature: "+f))
+		}
+		if !reb[f] && !signerOnly[f] {
+			errs = append(errs, errors.New("only in the published app: "+f))
+		}
+	}
+	for f := range reb {
+		if !pub[f] {
+			errs = append(errs, errors.New("only in the rebuild: "+f))
+		}
+		if signerOnly[f] {
+			errs = append(errs, errors.New("the rebuild must not contain "+f))
+		}
+	}
+	if !pub["Contents/_CodeSignature/CodeResources"] {
+		errs = append(errs, errors.New("published app has no CodeResources"))
+	}
+	return errors.Join(errs...)
+}
+
+const knownCDFlags = csRuntime | 0x100 | 0x200 | 0x800 | 0x1000 | 0x2000 // runtime, hard, kill, restrict, enforcement, require-lv
+
+func codeFlags(cd *CodeDirectory) error {
+	switch {
+	case cd.Flags&csRuntime == 0:
+		return fmt.Errorf("flags %#x: hardened runtime is off", cd.Flags)
+	case cd.Flags&^uint32(knownCDFlags) != 0:
+		return fmt.Errorf("flags %#x include bits outside the accepted set %#x (ad-hoc %#x, get-task-allow %#x, linker-signed %#x are never accepted)",
+			cd.Flags, knownCDFlags, csAdhoc, csGetTaskAllow, csLinkerSigned)
+	case cd.ExecSegFlags != execSegMain:
+		return fmt.Errorf("exec-segment flags %#x, want exactly %#x (main binary; no unsigned memory, debugging, JIT or CD-hash loading)", cd.ExecSegFlags, execSegMain)
+	}
+	return nil
+}
+
+// Mach-O 64 header and segment_command_64 field offsets.
+const (
+	mhNcmds      = 16
+	mhSizeofcmds = 20
+	mhSize       = 32
+	segVMSize    = 32
+	segFileOff   = 40
+	segFileSize  = 48
+	lcSegment64  = 0x19
+)
+
+type loadCmd struct {
+	off, size int
+	cmd       uint32
+	segname   string
+}
+
+func loadCommands(page []byte) ([]loadCmd, error) {
+	le := littleEndian
+	if len(page) < mhSize {
+		return nil, errors.New("header truncated")
+	}
+	n, total := int(le.Uint32(page[mhNcmds:])), int(le.Uint32(page[mhSizeofcmds:]))
+	if mhSize+total > len(page) {
+		return nil, errors.New("load commands extend past page 0")
+	}
+	var out []loadCmd
+	off := mhSize
+	for i := 0; i < n; i++ {
+		if off+8 > mhSize+total {
+			return nil, errors.New("load command out of range")
+		}
+		c := loadCmd{off: off, cmd: le.Uint32(page[off:]), size: int(le.Uint32(page[off+4:]))}
+		if c.size < 8 || off+c.size > mhSize+total {
+			return nil, errors.New("load command size out of range")
+		}
+		if c.cmd == lcSegment64 && c.size >= 72 {
+			c.segname = string(bytes.TrimRight(page[off+8:off+24], "\x00"))
+		}
+		out = append(out, c)
+		off += c.size
+	}
+	if off != mhSize+total {
+		return nil, errors.New("load commands do not fill sizeofcmds")
+	}
+	return out, nil
+}
+
+// compareExecutable checks the published CodeDirectory against the rebuild:
+// every page hash after page 0 must equal the hash of the rebuild's page, and
+// page 0 (header and load commands) must equal the rebuild's once the fields
+// the signature itself adds are put back: one more load command
+// (LC_CODE_SIGNATURE, the last), and __LINKEDIT's sizes grown to hold it.
+func compareExecutable(sig *Signature, reb []byte) error {
+	cd, pub := sig.CD, sig.File
+	ps := cd.PageSize
+	if uint64(sig.SigOffset) != cd.CodeLimit {
+		return fmt.Errorf("signature starts at %d, code limit is %d", sig.SigOffset, cd.CodeLimit)
+	}
+	if uint64(sig.SigOffset)+uint64(sig.SigSize) != uint64(len(pub)) {
+		return errors.New("published executable has bytes after its signature")
+	}
+	// The published CodeDirectory must describe the published file.
+	for i, h := range cd.Pages {
+		end := min((i+1)*ps, int(cd.CodeLimit))
+		if sum := sha256.Sum256(pub[i*ps : end]); !bytes.Equal(sum[:], h) {
+			return fmt.Errorf("published page %d does not match its own CodeDirectory", i)
+		}
+	}
+	if f, lc, err := thinMachO(reb); err != nil {
+		return fmt.Errorf("rebuild: %w", err)
+	} else if lc != nil {
+		return errors.New("rebuild carries a code signature; build it with verify mode")
+	} else if f.ByteOrder != littleEndian {
+		return errors.New("rebuild is not little-endian")
+	}
+	if uint64(len(reb)) > cd.CodeLimit {
+		return fmt.Errorf("rebuild is %d bytes, longer than the published code (%d)", len(reb), cd.CodeLimit)
+	}
+	// The signer pads the file to the signature's alignment; the padding is zeros.
+	cand := make([]byte, cd.CodeLimit)
+	copy(cand, reb)
+
+	var bad []int
+	for i := 1; i < len(cd.Pages); i++ {
+		end := min((i+1)*ps, int(cd.CodeLimit))
+		if sum := sha256.Sum256(cand[i*ps : end]); !bytes.Equal(sum[:], cd.Pages[i]) {
+			bad = append(bad, i)
+		}
+	}
+	if len(bad) > 0 {
+		return fmt.Errorf("%d of %d code pages differ from the rebuild (first: page %d)", len(bad), len(cd.Pages), bad[0])
+	}
+
+	p0 := append([]byte(nil), pub[:min(ps, len(pub))]...)
+	c0 := cand[:min(ps, len(cand))]
+	pcmds, err := loadCommands(p0)
+	if err != nil {
+		return fmt.Errorf("published header: %w", err)
+	}
+	ccmds, err := loadCommands(c0)
+	if err != nil {
+		return fmt.Errorf("rebuild header: %w", err)
+	}
+	if len(pcmds) != len(ccmds)+1 {
+		return fmt.Errorf("published has %d load commands, rebuild %d; only LC_CODE_SIGNATURE may be added", len(pcmds), len(ccmds))
+	}
+	last := pcmds[len(pcmds)-1]
+	if last.cmd != lcCodeSignature || last.size != 16 {
+		return errors.New("published header's extra load command is not LC_CODE_SIGNATURE")
+	}
+	le := littleEndian
+	le.PutUint32(p0[mhNcmds:], le.Uint32(p0[mhNcmds:])-1)
+	le.PutUint32(p0[mhSizeofcmds:], le.Uint32(p0[mhSizeofcmds:])-16)
+	clear(p0[last.off : last.off+16])
+	linkedit := -1
+	for i, c := range ccmds {
+		if c.segname == "__LINKEDIT" {
+			if linkedit >= 0 {
+				return errors.New("two __LINKEDIT segments")
+			}
+			linkedit = i
+		}
+	}
+	if linkedit < 0 || pcmds[linkedit].off != ccmds[linkedit].off || pcmds[linkedit].segname != "__LINKEDIT" {
+		return errors.New("__LINKEDIT not found at the same place in both headers")
+	}
+	po, co := pcmds[linkedit].off, ccmds[linkedit].off
+	fo, fs := le.Uint64(p0[po+segFileOff:]), le.Uint64(p0[po+segFileSize:])
+	if fo+fs != uint64(len(pub)) {
+		return errors.New("published __LINKEDIT does not end at the end of the file")
+	}
+	if vs, align := le.Uint64(p0[po+segVMSize:]), uint64(0x4000); vs != (fs+align-1)/align*align {
+		return fmt.Errorf("published __LINKEDIT vmsize %#x is not its file size rounded to 16 KB", vs)
+	}
+	copy(p0[po+segVMSize:po+segVMSize+8], c0[co+segVMSize:co+segVMSize+8])
+	copy(p0[po+segFileSize:po+segFileSize+8], c0[co+segFileSize:co+segFileSize+8])
+	if !bytes.Equal(p0, c0) {
+		for i := range p0 {
+			if p0[i] != c0[i] {
+				return fmt.Errorf("page 0 differs from the rebuild at byte %d beyond the signature's header fields", i)
+			}
+		}
+	}
+	// Page 0's hash in the CodeDirectory was already checked against the published bytes.
+
+	// The hardened-runtime version must be the SDK the rebuild was linked against.
+	if cd.Version >= 0x20500 {
+		sdk, err := buildSDK(c0, ccmds)
+		if err != nil {
+			return err
+		}
+		if cd.Runtime != sdk {
+			return fmt.Errorf("CodeDirectory runtime version %#x, rebuild's SDK is %#x", cd.Runtime, sdk)
+		}
+	}
+
+	// The exec segment recorded in the CodeDirectory must be the rebuild's __TEXT.
+	for _, c := range ccmds {
+		if c.segname == "__TEXT" {
+			fo, fs := le.Uint64(c0[c.off+segFileOff:]), le.Uint64(c0[c.off+segFileSize:])
+			if cd.ExecSegBase != fo || cd.ExecSegLimit != fs {
+				return fmt.Errorf("exec segment %d+%d, rebuild __TEXT is %d+%d", cd.ExecSegBase, cd.ExecSegLimit, fo, fs)
+			}
+			return nil
+		}
+	}
+	return errors.New("rebuild has no __TEXT segment")
+}
+
+const lcBuildVersion = 0x32
+
+// buildSDK reads the sdk field of the single LC_BUILD_VERSION command.
+func buildSDK(page []byte, cmds []loadCmd) (uint32, error) {
+	var sdk uint32
+	n := 0
+	for _, c := range cmds {
+		if c.cmd == lcBuildVersion && c.size >= 24 {
+			sdk = littleEndian.Uint32(page[c.off+16:])
+			n++
+		}
+	}
+	if n != 1 {
+		return 0, errors.New("rebuild must have exactly one LC_BUILD_VERSION")
+	}
+	return sdk, nil
+}
+
+func slotFileMatch(cd *CodeDirectory, slot int, pubPath, rebPath string) error {
+	h := cd.Special[slot]
+	if h == nil {
+		return fmt.Errorf("special slot -%d is missing", slot)
+	}
+	for _, p := range []string{pubPath, rebPath} {
+		b, err := os.ReadFile(p)
+		if err != nil {
+			return err
+		}
+		if sum := sha256.Sum256(b); !bytes.Equal(sum[:], h) {
+			return fmt.Errorf("%s does not match special slot -%d", p, slot)
+		}
+	}
+	return nil
+}
+
+func fileSHA(p string) ([]byte, error) {
+	b, err := os.ReadFile(p)
+	if err != nil {
+		return nil, err
+	}
+	s := sha256.Sum256(b)
+	return s[:], nil
+}
+
+// resources checks CodeResources: it must be the one the CodeDirectory seals,
+// its files2 map must list exactly the bundle's files other than the ones the
+// CodeDirectory covers directly, each as a plain file hash, and each hash must
+// match both the published file and the rebuild's (the provisioning profile,
+// signer-only, is matched against the published copy alone).
+func resources(cd *CodeDirectory, pubApp, rebApp string, pubFiles map[string]bool) error {
+	crPath := filepath.Join(pubApp, "Contents/_CodeSignature/CodeResources")
+	raw, err := os.ReadFile(crPath)
+	if err != nil {
+		return err
+	}
+	if sum := sha256.Sum256(raw); cd.Special[specialResources] == nil || !bytes.Equal(sum[:], cd.Special[specialResources]) {
+		return errors.New("CodeResources does not match special slot -3")
+	}
+	v, err := decodeXMLPlist(raw)
+	if err != nil {
+		return fmt.Errorf("CodeResources: %w", err)
+	}
+	top, _ := v.(map[string]any)
+	files2, ok := top["files2"].(map[string]any)
+	if !ok {
+		return errors.New("CodeResources has no files2")
+	}
+	want := map[string]bool{}
+	for f := range pubFiles {
+		if f == exeRel || f == "Contents/Info.plist" || f == "Contents/_CodeSignature/CodeResources" {
+			continue
+		}
+		want[strings.TrimPrefix(f, "Contents/")] = true
+	}
+	var errs []error
+	keys := make([]string, 0, len(files2))
+	for k := range files2 {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		e, ok := files2[k].(map[string]any)
+		if !ok {
+			errs = append(errs, fmt.Errorf("files2 %q is not a plain entry", k))
+			continue
+		}
+		for field := range e {
+			if field != "hash" && field != "hash2" {
+				errs = append(errs, fmt.Errorf("files2 %q has %q (nested code, symlinks and optional files are not accepted)", k, field))
+			}
+		}
+		h2, ok := e["hash2"].([]byte)
+		if !ok || len(h2) != 32 {
+			errs = append(errs, fmt.Errorf("files2 %q has no SHA-256 hash", k))
+			continue
+		}
+		if !want[k] {
+			errs = append(errs, fmt.Errorf("files2 lists %q, which is not a sealed file in the bundle", k))
+			continue
+		}
+		delete(want, k)
+		paths := []string{filepath.Join(pubApp, "Contents", k)}
+		if !signerOnly["Contents/"+k] {
+			paths = append(paths, filepath.Join(rebApp, "Contents", k))
+		}
+		for _, p := range paths {
+			if s, err := fileSHA(p); err != nil || !bytes.Equal(s, h2) {
+				errs = append(errs, fmt.Errorf("%s does not match CodeResources", p))
+			}
+		}
+	}
+	// Apple's default rules omit PkgInfo (legacy type/creator code) from the
+	// seal. Accept that only under that exact rule, and still require the
+	// rebuild's bytes: it is unsealed, so no signature protects it at runtime.
+	if want["PkgInfo"] {
+		rules2, _ := top["rules2"].(map[string]any)
+		rule, _ := rules2["^PkgInfo$"].(map[string]any)
+		if rule["omit"] != true {
+			errs = append(errs, errors.New("PkgInfo is not sealed and no rule omits it"))
+		} else if a, err1 := fileSHA(filepath.Join(pubApp, "Contents/PkgInfo")); err1 != nil {
+			errs = append(errs, err1)
+		} else if b, err2 := fileSHA(filepath.Join(rebApp, "Contents/PkgInfo")); err2 != nil || !bytes.Equal(a, b) {
+			errs = append(errs, errors.New("PkgInfo differs from the rebuild"))
+		}
+		delete(want, "PkgInfo")
+	}
+	for k := range want {
+		errs = append(errs, fmt.Errorf("%q is in the bundle but not sealed by CodeResources", k))
+	}
+	return errors.Join(errs...)
+}
+
+func expectedEntitlements(want Expect) map[string]any {
+	return map[string]any{
+		"com.apple.application-identifier":                  want.Team + "." + want.BundleID,
+		"com.apple.developer.team-identifier":               want.Team,
+		"com.apple.developer.devicecheck.app-attest-opt-in": []any{"CDhash"},
+	}
+}
+
+func entitlements(sig *Signature, want Expect) error {
+	cd := sig.CD
+	if sig.EntXMLRaw == nil || sig.EntDERRaw == nil {
+		return errors.New("XML and DER entitlements must both be present")
+	}
+	if s := sha256.Sum256(sig.EntXMLRaw); !bytes.Equal(s[:], cd.Special[specialEntitlements]) {
+		return errors.New("XML entitlements do not match special slot -5")
+	}
+	if s := sha256.Sum256(sig.EntDERRaw); cd.NSpecial < specialDER || !bytes.Equal(s[:], cd.Special[specialDER]) {
+		return errors.New("DER entitlements do not match special slot -7")
+	}
+	exp := expectedEntitlements(want)
+	x, err := decodeXMLPlist(sig.EntitlementsXML)
+	if err != nil {
+		return fmt.Errorf("XML entitlements: %w", err)
+	}
+	if !reflect.DeepEqual(x, exp) {
+		return fmt.Errorf("XML entitlements are %v, want exactly %v", x, exp)
+	}
+	d, err := decodeDEREntitlements(sig.EntitlementsDER)
+	if err != nil {
+		return fmt.Errorf("DER entitlements: %w", err)
+	}
+	if !reflect.DeepEqual(d, exp) {
+		return fmt.Errorf("DER entitlements are %v, want exactly %v", d, exp)
+	}
+	return nil
+}
+
+func requirements(sig *Signature, want Expect) error {
+	if sig.RequirementsRaw == nil {
+		return errors.New("no requirements blob")
+	}
+	if s := sha256.Sum256(sig.RequirementsRaw); !bytes.Equal(s[:], sig.CD.Special[specialRequirements]) {
+		return errors.New("requirements do not match special slot -2")
+	}
+	// Only a designated requirement (type 3): no host, guest or library
+	// requirements the signer could add.
+	r := sig.RequirementsRaw
+	if len(r) < 20 || be.Uint32(r[8:]) != 1 || be.Uint32(r[12:]) != 3 {
+		return errors.New("requirements must be exactly one designated requirement")
+	}
+	if !bytes.Contains(sig.Requirements, []byte(want.BundleID)) {
+		return errors.New("designated requirement does not name the bundle ID")
+	}
+	return nil
+}
+
+func unusedSlots(cd *CodeDirectory) error {
+	for _, s := range []int{specialApplication, specialRepSpecific} {
+		if h := cd.Special[s]; h != nil && !bytes.Equal(h, make([]byte, 32)) {
+			return fmt.Errorf("special slot -%d is used", s)
+		}
+	}
+	return nil
+}
+
+// profile reads the property list inside the provisioning profile's CMS
+// envelope. The envelope's signature is not checked here: App Attest already
+// proves the app ID, so this only confirms the profile says what it should.
+func profile(pubApp string, want Expect) error {
+	b, err := os.ReadFile(filepath.Join(pubApp, "Contents/embedded.provisionprofile"))
+	if err != nil {
+		return err
+	}
+	i, j := bytes.Index(b, []byte("<?xml")), bytes.LastIndex(b, []byte("</plist>"))
+	if i < 0 || j < i || bytes.Index(b[i+1:], []byte("<?xml")) >= 0 {
+		return errors.New("no single property list in the profile")
+	}
+	v, err := decodeXMLPlist(b[i : j+len("</plist>")])
+	if err != nil {
+		return err
+	}
+	top, _ := v.(map[string]any)
+	ent, _ := top["Entitlements"].(map[string]any)
+	teams, _ := top["TeamIdentifier"].([]any)
+	switch {
+	case ent == nil:
+		return errors.New("profile has no Entitlements")
+	case ent["com.apple.application-identifier"] != want.Team+"."+want.BundleID:
+		return fmt.Errorf("profile is for %v", ent["com.apple.application-identifier"])
+	case len(teams) != 1 || teams[0] != want.Team:
+		return fmt.Errorf("profile team is %v", teams)
+	case ent["get-task-allow"] == true:
+		return errors.New("profile grants get-task-allow")
+	}
+	if !reflect.DeepEqual(ent["com.apple.developer.devicecheck.app-attest-opt-in"], []any{"CDhash"}) {
+		return errors.New("profile does not grant the App Attest CD-hash opt-in")
+	}
+	return nil
+}
diff --git a/proxy-router/internal/sealed/codesig/der.go b/proxy-router/internal/sealed/codesig/der.go
new file mode 100644
index 00000000..6b471e88
--- /dev/null
+++ b/proxy-router/internal/sealed/codesig/der.go
@@ -0,0 +1,165 @@
+package codesig
+
+import (
+	"errors"
+	"fmt"
+)
+
+// DER entitlements are what the kernel enforces, so they are decoded rather
+// than trusted to match the XML copy. The encoding (Apple CoreEntitlements):
+//
+//	[APPLICATION 16] { INTEGER 1, [CONTEXT 16] { SEQUENCE { UTF8String key, value }, ... } }
+//
+// with values UTF8String, BOOLEAN, INTEGER, SEQUENCE (array) or [CONTEXT 16]
+// (nested dictionary). Only definite, minimally encoded lengths are accepted.
+
+type tlv struct {
+	tag     byte // identifier octet; tag numbers above 30 are rejected
+	content []byte
+}
+
+func readTLV(b []byte) (tlv, []byte, error) {
+	if len(b) < 2 {
+		return tlv{}, nil, errors.New("der: truncated")
+	}
+	tag := b[0]
+	if tag&0x1f == 0x1f {
+		return tlv{}, nil, errors.New("der: high tag numbers are not used")
+	}
+	n, rest := int(b[1]), b[2:]
+	switch {
+	case n < 0x80:
+	case n == 0x81:
+		if len(rest) < 1 || rest[0] < 0x80 {
+			return tlv{}, nil, errors.New("der: non-minimal length")
+		}
+		n, rest = int(rest[0]), rest[1:]
+	case n == 0x82:
+		if len(rest) < 2 || rest[0] == 0 {
+			return tlv{}, nil, errors.New("der: non-minimal length")
+		}
+		n, rest = int(rest[0])<<8|int(rest[1]), rest[2:]
+		if n < 0x100 {
+			return tlv{}, nil, errors.New("der: non-minimal length")
+		}
+	default:
+		return tlv{}, nil, errors.New("der: unsupported length form")
+	}
+	if n > len(rest) {
+		return tlv{}, nil, errors.New("der: length out of range")
+	}
+	return tlv{tag, rest[:n]}, rest[n:], nil
+}
+
+const (
+	derBoolean     = 0x01
+	derInteger     = 0x02
+	derUTF8        = 0x0c
+	derSequence    = 0x30
+	derDict        = 0xb0 // [CONTEXT 16] constructed
+	derEntitlement = 0x70 // [APPLICATION 16] constructed
+)
+
+func decodeDEREntitlements(b []byte) (map[string]any, error) {
+	root, rest, err := readTLV(b)
+	if err != nil {
+		return nil, err
+	}
+	if len(rest) != 0 || root.tag != derEntitlement {
+		return nil, errors.New("der: not an entitlements blob")
+	}
+	ver, rest, err := readTLV(root.content)
+	if err != nil {
+		return nil, err
+	}
+	if ver.tag != derInteger || len(ver.content) != 1 || ver.content[0] != 1 {
+		return nil, errors.New("der: unsupported entitlements version")
+	}
+	dict, rest, err := readTLV(rest)
+	if err != nil {
+		return nil, err
+	}
+	if len(rest) != 0 || dict.tag != derDict {
+		return nil, errors.New("der: malformed entitlements")
+	}
+	v, err := derValue(dict, 0)
+	if err != nil {
+		return nil, err
+	}
+	return v.(map[string]any), nil
+}
+
+func derValue(t tlv, depth int) (any, error) {
+	if depth > 8 {
+		return nil, errors.New("der: nesting too deep")
+	}
+	switch t.tag {
+	case derUTF8:
+		return string(t.content), nil
+	case derBoolean:
+		if len(t.content) != 1 || (t.content[0] != 0 && t.content[0] != 0xff) {
+			return nil, errors.New("der: bad boolean")
+		}
+		return t.content[0] == 0xff, nil
+	case derInteger:
+		c := t.content
+		if len(c) == 0 || len(c) > 8 || (len(c) > 1 && ((c[0] == 0 && c[1] < 0x80) || (c[0] == 0xff && c[1] >= 0x80))) {
+			return nil, errors.New("der: bad integer")
+		}
+		v := int64(int8(c[0]))
+		for _, x := range c[1:] {
+			v = v<<8 | int64(x)
+		}
+		return v, nil
+	case derSequence:
+		out := []any{}
+		for rest := t.content; len(rest) > 0; {
+			var e tlv
+			var err error
+			if e, rest, err = readTLV(rest); err != nil {
+				return nil, err
+			}
+			v, err := derValue(e, depth+1)
+			if err != nil {
+				return nil, err
+			}
+			out = append(out, v)
+		}
+		return out, nil
+	case derDict:
+		m := map[string]any{}
+		for rest := t.content; len(rest) > 0; {
+			var pair tlv
+			var err error
+			if pair, rest, err = readTLV(rest); err != nil {
+				return nil, err
+			}
+			if pair.tag != derSequence {
+				return nil, errors.New("der: dictionary entry is not a pair")
+			}
+			k, after, err := readTLV(pair.content)
+			if err != nil {
+				return nil, err
+			}
+			if k.tag != derUTF8 {
+				return nil, errors.New("der: dictionary key is not a string")
+			}
+			vt, after, err := readTLV(after)
+			if err != nil {
+				return nil, err
+			}
+			if len(after) != 0 {
+				return nil, errors.New("der: dictionary entry has extra elements")
+			}
+			key := string(k.content)
+			if _, dup := m[key]; dup {
+				return nil, fmt.Errorf("der: duplicate key %q", key)
+			}
+			if m[key], err = derValue(vt, depth+1); err != nil {
+				return nil, err
+			}
+		}
+		return m, nil
+	}
+	return nil, fmt.Errorf("der: unsupported element tag %#x", t.tag)
+}
diff --git a/proxy-router/internal/sealed/codesig/macho.go b/proxy-router/internal/sealed/codesig/macho.go
new file mode 100644
index 00000000..c76356ad
--- /dev/null
+++ b/proxy-router/internal/sealed/codesig/macho.go
@@ -0,0 +1,301 @@
+// Package codesig reads Apple code signatures and compares a published,
+// signed sealed-engine app with an unsigned rebuild of the same source.
+//
+// The attested CD hash is the SHA-256 of the CodeDirectory. A verifier cannot
+// reproduce it, because some of what the CodeDirectory commits to belongs to
+// the signer alone. Compare therefore checks everything else: that every byte
+// of the published executable the kernel will page-check equals the rebuild
+// (apart from the header fields that record the signature itself), that the
+// Info.plist and every other bundle file are the rebuild's, and that the
+// signer-only parts say what they must and nothing more.
+package codesig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"debug/macho"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+)
+
+var (
+	be           = binary.BigEndian
+	littleEndian = binary.LittleEndian
+)
+
+// Blob magics and super-blob slot types (xnu osfmk/kern/cs_blobs.h).
+const (
+	magicEmbeddedSignature = 0xfade0cc0
+	magicCodeDirectory     = 0xfade0c02
+	magicRequirements      = 0xfade0c01
+	magicEntitlements      = 0xfade7171
+	magicDEREntitlements   = 0xfade7172
+	magicBlobWrapper       = 0xfade0b01
+
+	slotCodeDirectory   = 0
+	slotRequirements    = 2
+	slotEntitlements    = 5
+	slotDEREntitlements = 7
+	slotAltCDFirst      = 0x1000
+	slotAltCDLast       = 0x1004
+	slotSignature       = 0x10000
+
+	// Special-slot numbers inside the CodeDirectory.
+	specialInfo         = 1
+	specialRequirements = 2
+	specialResources    = 3
+	specialApplication  = 4
+	specialEntitlements = 5
+	specialRepSpecific  = 6
+	specialDER          = 7
+
+	hashTypeSHA256 = 2
+
+	lcCodeSignature = 0x1d
+)
+
+// CodeDirectory flags and exec-segment flags (cs_blobs.h).
+const (
+	csAdhoc        = 0x00000002
+	csGetTaskAllow = 0x00000004
+	csRuntime      = 0x00010000
+	csLinkerSigned = 0x00020000
+	execSegMain    = 0x1
+)
+
+// CodeDirectory is the parsed SHA-256 CodeDirectory of a signed executable.
+type CodeDirectory struct {
+	Raw          []byte // the whole blob; CDHash() hashes these bytes
+	Version      uint32
+	Flags        uint32
+	Identifier   string
+	TeamID       string
+	CodeLimit    uint64
+	PageSize     int
+	Special      map[int][]byte // special slot number -> hash
+	NSpecial     int
+	Pages        [][]byte
+	Platform     byte
+	Runtime      uint32 // SDK version the hardened-runtime policy is keyed on (v >= 0x20500)
+	ExecSegBase  uint64
+	ExecSegLimit uint64
+	ExecSegFlags uint64
+}
+
+// CDHash is the value App Attest reports as apple_cd_hash_hash_01.
+func (cd *CodeDirectory) CDHash() [32]byte { return sha256.Sum256(cd.Raw) }
+
+// Signature is everything read from one signed Mach-O executable.
+type Signature struct {
+	File            []byte
+	CD              *CodeDirectory
+	Requirements    []byte // blob payload after the 8-byte header, and the whole blob
+	RequirementsRaw []byte
+	EntitlementsXML []byte // payload
+	EntXMLRaw       []byte
+	EntitlementsDER []byte // payload
+	EntDERRaw       []byte
+	HasCMS          bool
+	SigOffset       uint32 // LC_CODE_SIGNATURE dataoff
+	SigSize         uint32
+}
+
+func cstring(b []byte, off uint32) (string, error) {
+	if int(off) >= len(b) {
+		return "", errors.New("string offset out of range")
+	}
+	for i := int(off); i < len(b); i++ {
+		if b[i] == 0 {
+			return string(b[off:i]), nil
+		}
+	}
+	return "", errors.New("unterminated string")
+}
+
+// ParseCodeDirectory parses one CodeDirectory blob and rejects every shape the
+// sealed engine never produces: other hash types, scatter, 64-bit code limits,
+// versions without the exec-segment fields.
+func ParseCodeDirectory(b []byte) (*CodeDirectory, error) {
+	if len(b) < 88 || be.Uint32(b) != magicCodeDirectory {
+		return nil, errors.New("not a CodeDirectory")
+	}
+	length := be.Uint32(b[4:])
+	if int(length) != len(b) {
+		return nil, errors.New("CodeDirectory length mismatch")
+	}
+	cd := &CodeDirectory{Raw: b, Version: be.Uint32(b[8:]), Flags: be.Uint32(b[12:]), Special: map[int][]byte{}}
+	hashOffset := be.Uint32(b[16:])
+	identOffset := be.Uint32(b[20:])
+	nSpecial := be.Uint32(b[24:])
+	nCode := be.Uint32(b[28:])
+	cd.CodeLimit = uint64(be.Uint32(b[32:]))
+	hashSize, hashType, pageShift := b[36], b[37], b[39]
+	cd.Platform = b[38]
+	scatter := be.Uint32(b[44:])
+	teamOffset := be.Uint32(b[48:])
+	codeLimit64 := be.Uint64(b[56:])
+	cd.ExecSegBase, cd.ExecSegLimit, cd.ExecSegFlags = be.Uint64(b[64:]), be.Uint64(b[72:]), be.Uint64(b[80:])
+
+	switch cd.Version {
+	case 0x20400:
+	case 0x20500, 0x20600:
+		if len(b) < 96 {
+			return nil, errors.New("CodeDirectory too short for its version")
+		}
+		cd.Runtime = be.Uint32(b[88:])
+		if be.Uint32(b[92:]) != 0 {
+			return nil, errors.New("pre-encryption hashes are not supported")
+		}
+		if cd.Version == 0x20600 {
+			if len(b) < 108 {
+				return nil, errors.New("CodeDirectory too short for its version")
+			}
+			for _, x := range b[96:108] {
+				if x != 0 {
+					return nil, errors.New("linkage hashes are not supported")
+				}
+			}
+		}
+	default:
+		return nil, fmt.Errorf("CodeDirectory version %#x is not accepted", cd.Version)
+	}
+	switch {
+	case cd.Platform != 0:
+		return nil, fmt.Errorf("platform %d: only non-platform (third-party) code is accepted", cd.Platform)
+	case hashType != hashTypeSHA256 || hashSize != 32:
+		return nil, fmt.Errorf("hash type %d size %d, want SHA-256", hashType, hashSize)
+	case pageShift != 12 && pageShift != 14:
+		return nil, fmt.Errorf("page size 2^%d", pageShift)
+	case scatter != 0:
+		return nil, errors.New("scatter vectors are not supported")
+	case codeLimit64 != 0:
+		return nil, errors.New("64-bit code limit is not supported")
+	case nSpecial > 7:
+		return nil, fmt.Errorf("%d special slots, expected at most 7", nSpecial)
+	case teamOffset == 0:
+		return nil, errors.New("no team identifier")
+	}
+	cd.PageSize = 1 << pageShift
+	cd.NSpecial = int(nSpecial)
+	if want := (cd.CodeLimit + uint64(cd.PageSize) - 1) / uint64(cd.PageSize); uint64(nCode) != want {
+		return nil, fmt.Errorf("%d code slots for code limit %d, want %d", nCode, cd.CodeLimit, want)
+	}
+	if uint64(hashOffset) < uint64(nSpecial)*32 || uint64(hashOffset)+uint64(nCode)*32 > uint64(length) {
+		return nil, errors.New("hash slots out of range")
+	}
+	for i := 1; i <= int(nSpecial); i++ {
+		cd.Special[i] = b[int(hashOffset)-32*i : int(hashOffset)-32*(i-1)]
+	}
+	for i := 0; i < int(nCode); i++ {
+		cd.Pages = append(cd.Pages, b[int(hashOffset)+32*i:int(hashOffset)+32*(i+1)])
+	}
+	var err error
+	if cd.Identifier, err = cstring(b, identOffset); err != nil {
+		return nil, fmt.Errorf("identifier: %w", err)
+	}
+	if cd.TeamID, err = cstring(b, teamOffset); err != nil {
+		return nil, fmt.Errorf("team identifier: %w", err)
+	}
+	return cd, nil
+}
+
+// thinMachO parses a thin 64-bit arm64 executable and returns its
+// LC_CODE_SIGNATURE (nil if absent), which must be the last load command.
+func thinMachO(data []byte) (*macho.File, []byte, error) {
+	f, err := macho.NewFile(bytes.NewReader(data))
+	if err != nil {
+		return nil, nil, fmt.Errorf("not a thin Mach-O: %w", err)
+	}
+	if f.Magic != macho.Magic64 || f.Cpu != macho.CpuArm64 || f.Type != macho.TypeExec {
+		return nil, nil, errors.New("want a 64-bit arm64 executable")
+	}
+	var sig []byte
+	for i, l := range f.Loads {
+		raw := l.Raw()
+		if f.ByteOrder.Uint32(raw) == lcCodeSignature {
+			if i != len(f.Loads)-1 {
+				return nil, nil, errors.New("LC_CODE_SIGNATURE is not the last load command")
+			}
+			sig = raw
+		}
+	}
+	return f, sig, nil
+}
+
+// ReadSignature parses the embedded signature of a signed executable.
+func ReadSignature(path string) (*Signature, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	f, lc, err := thinMachO(data)
+	if err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	if lc == nil || len(lc) != 16 {
+		return nil, errors.New("executable is not signed")
+	}
+	s := &Signature{File: data, SigOffset: f.ByteOrder.Uint32(lc[8:]), SigSize: f.ByteOrder.Uint32(lc[12:])}
+	end := uint64(s.SigOffset) + uint64(s.SigSize)
+	if end > uint64(len(data)) || s.SigSize < 12 {
+		return nil, errors.New("signature out of range")
+	}
+	sb := data[s.SigOffset:end]
+	if be.Uint32(sb) != magicEmbeddedSignature || uint64(be.Uint32(sb[4:])) > uint64(len(sb)) {
+		return nil, errors.New("not an embedded-signature super-blob")
+	}
+	sb = sb[:be.Uint32(sb[4:])]
+	if len(sb) < 12 {
+		return nil, errors.New("super-blob too short")
+	}
+	count := be.Uint32(sb[8:])
+	if 12+uint64(count)*8 > uint64(len(sb)) {
+		return nil, errors.New("super-blob index out of range")
+	}
+	seen := map[uint32]bool{}
+	for i := uint32(0); i < count; i++ {
+		typ, off := be.Uint32(sb[12+8*i:]), be.Uint32(sb[16+8*i:])
+		if seen[typ] {
+			return nil, fmt.Errorf("duplicate super-blob slot %#x", typ)
+		}
+		seen[typ] = true
+		if uint64(off)+8 > uint64(len(sb)) {
+			return nil, errors.New("blob offset out of range")
+		}
+		magic, n := be.Uint32(sb[off:]), be.Uint32(sb[off+4:])
+		if n < 8 || uint64(off)+uint64(n) > uint64(len(sb)) {
+			return nil, errors.New("blob length out of range")
+		}
+		blob := sb[off : off+n]
+		want := map[uint32]uint32{slotCodeDirectory: magicCodeDirectory, slotRequirements: magicRequirements,
+			slotEntitlements: magicEntitlements, slotDEREntitlements: magicDEREntitlements, slotSignature: magicBlobWrapper}
+		switch {
+		case typ >= slotAltCDFirst && typ <= slotAltCDLast:
+			return nil, errors.New("alternate CodeDirectories present; exactly one SHA-256 CodeDirectory is accepted")
+		case want[typ] == 0:
+			return nil, fmt.Errorf("unexpected super-blob slot %#x", typ)
+		case want[typ] != magic:
+			return nil, fmt.Errorf("slot %#x has magic %#x", typ, magic)
+		}
+		switch typ {
+		case slotCodeDirectory:
+			if s.CD, err = ParseCodeDirectory(blob); err != nil {
+				return nil, err
+			}
+		case slotRequirements:
+			s.Requirements, s.RequirementsRaw = blob[8:], blob
+		case slotEntitlements:
+			s.EntitlementsXML, s.EntXMLRaw = blob[8:], blob
+		case slotDEREntitlements:
+			s.EntitlementsDER, s.EntDERRaw = blob[8:], blob
+		case slotSignature:
+			s.HasCMS = n > 8
+		}
+	}
+	if s.CD == nil {
+		return nil, errors.New("no CodeDirectory")
+	}
+	return s, nil
+}
diff --git a/proxy-router/internal/sealed/codesig/plist.go b/proxy-router/internal/sealed/codesig/plist.go
new file mode 100644
index 00000000..00a77032
--- /dev/null
+++ b/proxy-router/internal/sealed/codesig/plist.go
@@ -0,0 +1,205 @@
+package codesig
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/xml"
+	"errors"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// decodeXMLPlist decodes the XML property lists found in code signatures
+// (entitlements, CodeResources). Values become map[string]any, []any, string,
+// []byte (<data>), bool, int64, float64 (<real>) and time.Time (<date>). Duplicate dictionary keys, unknown elements
+// and trailing content are errors: two readers of an ambiguous plist could
+// disagree about what it says.
+func decodeXMLPlist(b []byte) (any, error) {
+	d := xml.NewDecoder(bytes.NewReader(b))
+	d.Strict = true
+	var root any
+	seen := false
+	for {
+		tok, err := d.Token()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+		se, ok := tok.(xml.StartElement)
+		if !ok {
+			if cd, ok := tok.(xml.CharData); ok && len(bytes.TrimSpace(cd)) != 0 {
+				return nil, errors.New("plist: text outside elements")
+			}
+			continue
+		}
+		if se.Name.Local != "plist" || seen {
+			return nil, fmt.Errorf("plist: unexpected <%s>", se.Name.Local)
+		}
+		seen = true
+		v, err := plistValueList(d, "plist")
+		if err != nil {
+			return nil, err
+		}
+		if len(v) != 1 {
+			return nil, errors.New("plist: <plist> must hold exactly one value")
+		}
+		root = v[0]
+	}
+	if !seen {
+		return nil, errors.New("plist: no <plist> element")
+	}
+	return root, nil
+}
+
+// plistValueList reads values until the end tag `end`.
+func plistValueList(d *xml.Decoder, end string) ([]any, error) {
+	var out []any
+	for {
+		tok, err := d.Token()
+		if err != nil {
+			return nil, err
+		}
+		switch t := tok.(type) {
+		case xml.EndElement:
+			if t.Name.Local != end {
+				return nil, fmt.Errorf("plist: mismatched </%s>", t.Name.Local)
+			}
+			return out, nil
+		case xml.CharData:
+			if len(bytes.TrimSpace(t)) != 0 {
+				return nil, errors.New("plist: stray text")
+			}
+		case xml.StartElement:
+			v, err := plistValue(d, t)
+			if err != nil {
+				return nil, err
+			}
+			out = append(out, v)
+		}
+	}
+}
+
+func plistText(d *xml.Decoder, name string) (string, error) {
+	var sb strings.Builder
+	for {
+		tok, err := d.Token()
+		if err != nil {
+			return "", err
+		}
+		switch t := tok.(type) {
+		case xml.CharData:
+			sb.Write(t)
+		case xml.EndElement:
+			if t.Name.Local != name {
+				return "", fmt.Errorf("plist: mismatched </%s>", t.Name.Local)
+			}
+			return sb.String(), nil
+		default:
+			return "", fmt.Errorf("plist: element inside <%s>", name)
+		}
+	}
+}
+
+func plistValue(d *xml.Decoder, se xml.StartElement) (any, error) {
+	switch se.Name.Local {
+	case "dict":
+		m := map[string]any{}
+		for {
+			tok, err := d.Token()
+			if err != nil {
+				return nil, err
+			}
+			switch t := tok.(type) {
+			case xml.EndElement:
+				if t.Name.Local != "dict" {
+					return nil, fmt.Errorf("plist: mismatched </%s>", t.Name.Local)
+				}
+				return m, nil
+			case xml.CharData:
+				if len(bytes.TrimSpace(t)) != 0 {
+					return nil, errors.New("plist: stray text in <dict>")
+				}
+			case xml.StartElement:
+				if t.Name.Local != "key" {
+					return nil, fmt.Errorf("plist: <%s> where <key> expected", t.Name.Local)
+				}
+				k, err := plistText(d, "key")
+				if err != nil {
+					return nil, err
+				}
+				if _, dup := m[k]; dup {
+					return nil, fmt.Errorf("plist: duplicate key %q", k)
+				}
+				var v any
+				for v == nil {
+					tok, err := d.Token()
+					if err != nil {
+						return nil, err
+					}
+					switch vt := tok.(type) {
+					case xml.CharData:
+						if len(bytes.TrimSpace(vt)) != 0 {
+							return nil, errors.New("plist: stray text in <dict>")
+						}
+					case xml.StartElement:
+						if v, err = plistValue(d, vt); err != nil {
+							return nil, err
+						}
+					default:
+						return nil, fmt.Errorf("plist: key %q has no value", k)
+					}
+				}
+				m[k] = v
+			}
+		}
+	case "array":
+		v, err := plistValueList(d, "array")
+		if v == nil && err == nil {
+			v = []any{}
+		}
+		return v, err
+	case "string":
+		return plistText(d, "string")
+	case "data":
+		s, err := plistText(d, "data")
+		if err != nil {
+			return nil, err
+		}
+		s = strings.Map(func(r rune) rune {
+			if r == ' ' || r == '\t' || r == '\n' || r == '\r' {
+				return -1
+			}
+			return r
+		}, s)
+		return base64.StdEncoding.DecodeString(s)
+	case "integer":
+		s, err := plistText(d, "integer")
+		if err != nil {
+			return nil, err
+		}
+		return strconv.ParseInt(strings.TrimSpace(s), 10, 64)
+	case "real":
+		s, err := plistText(d, "real")
+		if err != nil {
+			return nil, err
+		}
+		return strconv.ParseFloat(strings.TrimSpace(s), 64)
+	case "date":
+		s, err := plistText(d, "date")
+		if err != nil {
+			return nil, err
+		}
+		return time.Parse(time.RFC3339, strings.TrimSpace(s))
+	case "true", "false":
+		if err := d.Skip(); err != nil {
+			return nil, err
+		}
+		return se.Name.Local == "true", nil
+	}
+	return nil, fmt.Errorf("plist: unsupported element <%s>", se.Name.Local)
+}
diff --git a/proxy-router/internal/sealed/e2e/plainprompt/main.go b/proxy-router/internal/sealed/e2e/plainprompt/main.go
new file mode 100644
index 00000000..3374b387
--- /dev/null
+++ b/proxy-router/internal/sealed/e2e/plainprompt/main.go
@@ -0,0 +1,314 @@
+// plainprompt is a POSITIVE CONTROL for the local-only sealed-inference
+// privacy test. It sends ONE correctly signed, ordinary (unsealed, plaintext)
+// MOR-RPC "session.prompt" request straight to a provider proxy-router over
+// TCP -- exactly the bytes a consumer proxy-router sends today on the
+// non-sealed path -- and prints the provider's response text. It reuses the
+// repo's own request builder, signer, and response types so the bytes on the
+// wire are byte-faithful to (*ProxyServiceSender).SendPromptV2's non-sealed
+// path (internal/proxyapi/proxy_sender.go), not a reimplementation of
+// the protocol.
+//
+// The session/user records this test relies on (session open in the
+// provider's storage, each side's User record holding the other's
+// addr/pubkey/url) must already exist -- see internal/sealed/e2e/seed.
+//
+//	go run ./internal/sealed/e2e/plainprompt --provider 127.0.0.1:3333 --session 0x<32B hex> --user-key <consumer-priv-hex> --prompt "hello"
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"time"
+
+	gcs "github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/chatstorage/genericchatstorage"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/lib"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/proxyapi"
+	msgs "github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/proxyapi/morrpcmessage"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/crypto"
+	openai "github.com/sashabaranov/go-openai"
+)
+
+type options struct {
+	provider  string
+	session   string
+	userKey   string
+	prompt    string
+	maxTokens int
+	timeout   time.Duration
+}
+
+func main() {
+	o := options{}
+	flag.StringVar(&o.provider, "provider", "", "provider proxy-router host:port (required)")
+	flag.StringVar(&o.session, "session", "", "0x<32-byte hex> session id (required)")
+	flag.StringVar(&o.userKey, "user-key", "", "consumer private key hex (required; not printed by this tool, but visible in argv: local test keys only)")
+	flag.StringVar(&o.prompt, "prompt", "", "prompt text (required)")
+	flag.IntVar(&o.maxTokens, "max-tokens", 64, "max_tokens for the chat completion request")
+	flag.DurationVar(&o.timeout, "timeout", 60*time.Second, "overall dial+request timeout")
+	flag.Parse()
+
+	respText, err := run(o)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "plainprompt: %v\n", err)
+		os.Exit(1)
+	}
+	fmt.Printf("RESPONSE: %s\n", respText)
+}
+
+func run(o options) (string, error) {
+	if o.provider == "" {
+		return "", errors.New("--provider is required")
+	}
+	if o.prompt == "" {
+		return "", errors.New("--prompt is required")
+	}
+	if o.userKey == "" {
+		return "", errors.New("--user-key is required")
+	}
+
+	sessionID, err := hash32("--session", o.session)
+	if err != nil {
+		return "", err
+	}
+
+	var userPrivKey lib.HexString = common.FromHex(o.userKey)
+	if _, err := crypto.ToECDSA(userPrivKey); err != nil {
+		return "", fmt.Errorf("--user-key: invalid private key: %w", err)
+	}
+
+	requestID := lib.GenerateRequestID()
+	promptBody := buildPromptBody(o.prompt, o.maxTokens)
+
+	rpcMessage, err := buildSignedRequest(sessionID, promptBody, userPrivKey, requestID)
+	if err != nil {
+		return "", fmt.Errorf("building session.prompt request: %w", err)
+	}
+
+	return sendAndReceive(o.provider, rpcMessage, userPrivKey, o.timeout)
+}
+
+// hash32 mirrors internal/sealed/e2e/seed/main.go's helper of the same name:
+// parses a required 0x-prefixed 32-byte hex value (the session id).
+func hash32(flagName, s string) (common.Hash, error) {
+	if s == "" {
+		return common.Hash{}, fmt.Errorf("%s is required", flagName)
+	}
+	b := common.FromHex(s)
+	if len(b) != common.HashLength {
+		return common.Hash{}, fmt.Errorf("%s: %q is not a 32-byte hex value", flagName, s)
+	}
+	return common.BytesToHash(b), nil
+}
+
+// buildPromptBody is the OpenAI-style chat completion body sent as the
+// "prompt" payload of a session.prompt request -- the same type
+// SendPromptV2 receives as its *gcs.OpenAICompletionRequestExtra argument
+// (internal/proxyapi/proxy_sender.go).
+func buildPromptBody(prompt string, maxTokens int) *gcs.OpenAICompletionRequestExtra {
+	return &gcs.OpenAICompletionRequestExtra{
+		ChatCompletionRequest: openai.ChatCompletionRequest{
+			Messages: []openai.ChatCompletionMessage{
+				{Role: openai.ChatMessageRoleUser, Content: prompt},
+			},
+			Stream:    false,
+			MaxTokens: maxTokens,
+		},
+	}
+}
+
+// buildSignedRequest builds and signs a MOR-RPC "session.prompt" request the
+// same way the consumer proxy-router does on the non-sealed path:
+//
+//   - internal/proxyapi/proxy_sender.go prepareRequest() calls
+//     morRPC.SessionPromptRequest with the raw prompt payload and the
+//     consumer's private key.
+//   - internal/proxyapi/morrpcmessage/mor_rpc.go SessionPromptRequest
+//     json.Marshals the prompt straight into SessionPromptReq.Message as a
+//     PLAIN STRING -- there is no encryption step for the prompt body (see
+//     morrpcmessage/request.go SessionPromptReq: Message is `string`,
+//     not a ciphertext/hex field) -- signs the struct with generateSignature
+//     (Keccak256 + secp256k1 ECDSA sign, mor_rpc.go), and wraps the
+//     result in an RPCMessage{ID, Method: "session.prompt", Params}.
+//
+// providerPubKey is accepted by SessionPromptRequest's signature but is never
+// read inside the function body (confirmed by reading mor_rpc.go).
+// This control has no --provider-pubkey flag and does not verify the
+// provider's response signature (see decodeRPCError/decodeResult below), so
+// nil is passed for it without affecting a single byte placed on the wire.
+func buildSignedRequest(sessionID common.Hash, promptBody *gcs.OpenAICompletionRequestExtra, userPrivKey lib.HexString, requestID string) (*msgs.RPCMessage, error) {
+	rpc := msgs.NewMorRpc()
+	return rpc.SessionPromptRequest(sessionID, promptBody, nil, userPrivKey, requestID)
+}
+
+// sendAndReceive dials the provider, writes the signed request, and decodes
+// the response stream the same way
+// (*ProxyServiceSender).rpcRequestStreamV2 does for a "chat_completion"
+// request type (internal/proxyapi/proxy_sender.go) -- minus
+// retry-on-timeout/failover (this is a one-shot control, not a resilient
+// client) and provider-signature verification (see decodeRPCError/
+// decodeResult for exactly what is skipped and why).
+func sendAndReceive(providerAddr string, rpcMessage *msgs.RPCMessage, userPrivKey lib.HexString, timeout time.Duration) (string, error) {
+	// Mirrors proxy_sender.go: net.Dialer.Dial("tcp", url).
+	dialer := net.Dialer{Timeout: timeout}
+	conn, err := dialer.Dial("tcp", providerAddr)
+	if err != nil {
+		return "", fmt.Errorf("dial provider %s: %w", providerAddr, err)
+	}
+	defer conn.Close()
+
+	if err := conn.SetDeadline(time.Now().Add(timeout)); err != nil {
+		return "", fmt.Errorf("set deadline: %w", err)
+	}
+
+	// Mirrors proxy_sender.go: TCP keepalive so the connection
+	// survives brief idle gaps while the provider is inferencing.
+	if tcpConn, ok := conn.(*net.TCPConn); ok {
+		_ = tcpConn.SetKeepAlive(true)
+		_ = tcpConn.SetKeepAlivePeriod(10 * time.Second)
+	}
+
+	// Mirrors proxy_sender.go: json.Marshal the RPCMessage and write
+	// the bytes straight to the socket -- no length-prefix framing. This is
+	// the plaintext-on-the-wire claim this control exists to demonstrate: the
+	// entire request, including the prompt text inside Params.message, goes
+	// out as one ordinary JSON document with no sealing/encryption step.
+	msgJSON, err := json.Marshal(rpcMessage)
+	if err != nil {
+		return "", fmt.Errorf("marshal request: %w", err)
+	}
+	if _, err := conn.Write(msgJSON); err != nil {
+		return "", fmt.Errorf("write request: %w", err)
+	}
+
+	// Mirrors proxy_sender.go: response frames are read back-to-back
+	// off the same stream through a single json.Decoder -- JSON's own
+	// self-delimiting structure is the framing (Decode consumes exactly one
+	// value and leaves the reader positioned right after it).
+	reader := bufio.NewReader(conn)
+	decoder := json.NewDecoder(reader)
+
+	var accumulated strings.Builder
+	for {
+		var msg msgs.RpcResponse
+		if err := decoder.Decode(&msg); err != nil {
+			if err == io.EOF {
+				return "", errors.New("provider closed connection without sending a complete response")
+			}
+			return "", fmt.Errorf("decode response: %w", err)
+		}
+
+		if msg.Error != nil {
+			return "", decodeRPCError(msg.Error, userPrivKey)
+		}
+		if msg.Result == nil {
+			return "", errors.New("provider response has neither result nor error")
+		}
+
+		aiResponse, err := decodeResult(*msg.Result, userPrivKey)
+		if err != nil {
+			return "", err
+		}
+
+		done, err := accumulateChatResponse(aiResponse, &accumulated)
+		if err != nil {
+			return "", err
+		}
+		if done {
+			return accumulated.String(), nil
+		}
+	}
+}
+
+// decodeRPCError mirrors proxy_sender.go's handling of msg.Error: an
+// empty/absent signature means an unencrypted infrastructure error (returned
+// as-is); otherwise the message is ECIES-encrypted to the consumer key and is
+// decrypted with lib.DecryptString the same way (proxy_sender.go).
+// Provider-signature verification (proxy_sender.go,
+// p.validateMsgSignature) is intentionally skipped -- this control has no
+// --provider-pubkey flag to verify against.
+func decodeRPCError(rpcErr *msgs.RpcError, userPrivKey lib.HexString) error {
+	sig := rpcErr.Data.Signature
+	if sig == nil || len(sig) == 0 || sig.String() == "0x00" {
+		return fmt.Errorf("provider error: %s (code %d)", rpcErr.Message, rpcErr.Code)
+	}
+	errorMessage, err := lib.DecryptString(rpcErr.Message, userPrivKey.Hex())
+	if err != nil {
+		return fmt.Errorf("decrypt provider error: %w", err)
+	}
+	return fmt.Errorf("provider error: %s", errorMessage)
+}
+
+// decodeResult mirrors proxy_sender.go: unmarshal msg.Result into
+// InferenceRes (internal/proxyapi/requests.go -- reused directly here,
+// not redeclared, for byte fidelity with the sender's own decode step),
+// unwrap the hex-encoded Message field, and ECIES-decrypt it with the
+// consumer's own private key via lib.DecryptBytes (proxy_sender.go).
+// This decrypt step is unrelated to the sealed-engine feature under test --
+// the provider always encrypts its reply to the requesting consumer's key,
+// sealed or not. Signature verification against the provider's pubkey
+// (proxy_sender.go) is skipped for the same reason as decodeRPCError.
+func decodeResult(result json.RawMessage, userPrivKey lib.HexString) ([]byte, error) {
+	var inferenceRes proxyapi.InferenceRes
+	if err := json.Unmarshal(result, &inferenceRes); err != nil {
+		return nil, fmt.Errorf("decode inference result: %w", err)
+	}
+
+	var message lib.HexString
+	if err := json.Unmarshal(inferenceRes.Message, &message); err != nil {
+		return nil, fmt.Errorf("decode inference message envelope: %w", err)
+	}
+
+	aiResponse, err := lib.DecryptBytes(message, userPrivKey)
+	if err != nil {
+		return nil, fmt.Errorf("decrypt provider response: %w", err)
+	}
+	return aiResponse, nil
+}
+
+// accumulateChatResponse mirrors handleChatCompletion's non-streaming and
+// streaming branches (proxy_sender.go): a "[DONE]" control string
+// ends a stream with no content to add; a streaming chunk
+// (gcs.ChatCompletionStreamResponseExtra, Object == "chat.completion.chunk",
+// or a usage-only final chunk) appends Choices[0].Delta.Content and reports
+// done once FinishReason or Usage appears; a full non-streaming response
+// (gcs.ChatCompletionResponseExtra, Object == "chat.completion") appends
+// Choices[0].Message.Content and is done immediately. This control always
+// requests stream:false, so a compliant provider takes the last branch on
+// the first frame; the streaming branch stays in for providers that answer
+// with a chunk sequence regardless, so printing the "concatenated" content
+// is correct either way.
+func accumulateChatResponse(aiResponse []byte, accumulated *strings.Builder) (bool, error) {
+	var controlMsg string
+	if err := json.Unmarshal(aiResponse, &controlMsg); err == nil && controlMsg == "[DONE]" {
+		return true, nil
+	}
+
+	var streamResponse gcs.ChatCompletionStreamResponseExtra
+	streamErr := json.Unmarshal(aiResponse, &streamResponse)
+	hasChoices := len(streamResponse.Choices) > 0
+	hasUsageOnly := streamResponse.Usage != nil && !hasChoices
+	isStreamingChunk := streamResponse.Object == "chat.completion.chunk" || hasUsageOnly
+	if streamErr == nil && isStreamingChunk {
+		if hasChoices {
+			accumulated.WriteString(streamResponse.Choices[0].Delta.Content)
+		}
+		isFinal := streamResponse.Usage != nil || (hasChoices && streamResponse.Choices[0].FinishReason != "")
+		return isFinal, nil
+	}
+
+	var chatResponse gcs.ChatCompletionResponseExtra
+	if err := json.Unmarshal(aiResponse, &chatResponse); err == nil && len(chatResponse.Choices) > 0 && chatResponse.Object == "chat.completion" {
+		accumulated.WriteString(chatResponse.Choices[0].Message.Content)
+		return true, nil
+	}
+
+	return false, fmt.Errorf("unrecognized ai response: %s", string(aiResponse))
+}
diff --git a/proxy-router/internal/sealed/e2e/plainprompt/main_test.go b/proxy-router/internal/sealed/e2e/plainprompt/main_test.go
new file mode 100644
index 00000000..5408e6cb
--- /dev/null
+++ b/proxy-router/internal/sealed/e2e/plainprompt/main_test.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"crypto/rand"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/lib"
+	msgs "github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/proxyapi/morrpcmessage"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/stretchr/testify/require"
+)
+
+// TestBuildSignedRequest builds a session.prompt request with a freshly
+// generated consumer key (crypto.GenerateKey -- no hard-coded private keys)
+// and checks two things a wrong implementation could get wrong silently:
+//
+//  1. The repo's own MOR-RPC signature verifier
+//     (morrpcmessage.VerifySignature, mor_rpc.go) accepts the
+//     request's signature against the consumer's public key -- the same
+//     check a real provider runs on every inbound request.
+//  2. The prompt text sits in Params.message as plaintext JSON, not
+//     ciphertext -- the wire-visible claim this whole control exists to
+//     demonstrate (see buildSignedRequest's doc comment in main.go).
+func TestBuildSignedRequest(t *testing.T) {
+	userKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	var userPrivKey lib.HexString = crypto.FromECDSA(userKey)
+	userPubKey, err := lib.PubKeyFromPrivate(userPrivKey)
+	require.NoError(t, err)
+
+	var sessionID common.Hash
+	_, err = rand.Read(sessionID[:])
+	require.NoError(t, err)
+
+	promptBody := buildPromptBody("the quick brown fox", 64)
+
+	rpcMessage, err := buildSignedRequest(sessionID, promptBody, userPrivKey, "test-request-id")
+	require.NoError(t, err)
+	require.Equal(t, "session.prompt", rpcMessage.Method)
+	require.Equal(t, "test-request-id", rpcMessage.ID)
+
+	var req msgs.SessionPromptReq
+	require.NoError(t, json.Unmarshal(rpcMessage.Params, &req))
+	require.Equal(t, sessionID, req.SessionID)
+	require.NotEmpty(t, req.Signature)
+
+	// Plaintext check: the prompt content is a readable substring of the
+	// signed message, not encrypted bytes.
+	require.Contains(t, req.Message, `"content":"the quick brown fox"`)
+
+	// Signature check: zero the signature field (as generateSignature and
+	// every verify call site in the repo do -- e.g. proxy_sender.go
+	// -- since Signature has `json:",omitempty"` and was empty at sign time)
+	// and confirm the repo's own verifier accepts it against the consumer's
+	// public key.
+	sig := req.Signature
+	req.Signature = nil
+	rpc := msgs.NewMorRpc()
+	require.True(t, rpc.VerifySignature(req, sig, userPubKey, lib.NewTestLogger()))
+
+	// A signature that verifies against a DIFFERENT key must not verify --
+	// otherwise the check above would be vacuous.
+	otherKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	otherPubKey, err := lib.PubKeyFromPrivate(lib.HexString(crypto.FromECDSA(otherKey)))
+	require.NoError(t, err)
+	require.False(t, rpc.VerifySignature(req, sig, otherPubKey, lib.NewTestLogger()))
+}
+
+// TestBuildPromptBody checks the OpenAI-style request body carries stream:
+// false and the user message/max_tokens exactly as given -- the shape
+// SendPromptV2 expects for its *gcs.OpenAICompletionRequestExtra argument.
+func TestBuildPromptBody(t *testing.T) {
+	body := buildPromptBody("hello", 128)
+	require.False(t, body.Stream)
+	require.Equal(t, 128, body.MaxTokens)
+	require.Len(t, body.Messages, 1)
+	require.Equal(t, "user", body.Messages[0].Role)
+	require.Equal(t, "hello", body.Messages[0].Content)
+}
+
+// TestHash32 exercises the required-32-byte-hex parsing shared with
+// internal/sealed/e2e/seed/main.go's identically named helper.
+func TestHash32(t *testing.T) {
+	_, err := hash32("--session", "")
+	require.Error(t, err)
+
+	_, err = hash32("--session", "0x1234")
+	require.Error(t, err)
+
+	want := common.HexToHash("0x" + strings.Repeat("ab", 32))
+	got, err := hash32("--session", want.Hex())
+	require.NoError(t, err)
+	require.Equal(t, want, got)
+}
diff --git a/proxy-router/internal/sealed/e2e/seed/main.go b/proxy-router/internal/sealed/e2e/seed/main.go
new file mode 100644
index 00000000..c8faaef7
--- /dev/null
+++ b/proxy-router/internal/sealed/e2e/seed/main.go
@@ -0,0 +1,159 @@
+// seed pre-populates a proxy-router Badger store with a session and a user
+// record so a LOCAL-ONLY provider/consumer pair can exercise the sealed prompt
+// path without any on-chain session (e.g. against an empty local anvil). It
+// reuses the repo's own storage code (internal/storages) so the on-disk
+// format matches exactly what the running proxy-router writes and reads.
+//
+//	go run ./internal/sealed/e2e/seed --role provider --store <dir> --session 0x<32B> --model 0x<32B> --user-key <consumer-priv-hex> --provider-key <provider-priv-hex>
+//	go run ./internal/sealed/e2e/seed --role consumer --store <dir> --session 0x<32B> --model 0x<32B> --user-key <consumer-priv-hex> --provider-key <provider-priv-hex> --provider-url 127.0.0.1:3333
+package main
+
+import (
+	"flag"
+	"fmt"
+	"math/big"
+	"os"
+	"time"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/lib"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/storages"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+type options struct {
+	store       string
+	session     string
+	model       string
+	userKey     string
+	providerKey string
+	providerURL string
+	ttl         time.Duration
+	role        string
+}
+
+func main() {
+	o := options{}
+	flag.StringVar(&o.store, "store", "", "badger store directory (required)")
+	flag.StringVar(&o.session, "session", "", "0x 32-byte hex session id (required)")
+	flag.StringVar(&o.model, "model", "", "0x 32-byte hex model id (required)")
+	flag.StringVar(&o.userKey, "user-key", "", "consumer private key hex (required; visible in argv: local test keys only)")
+	flag.StringVar(&o.providerKey, "provider-key", "", "provider private key hex (required; visible in argv: local test keys only)")
+	flag.StringVar(&o.providerURL, "provider-url", "", "provider MOR-RPC host:port (required for --role consumer)")
+	flag.DurationVar(&o.ttl, "ttl", 2*time.Hour, "session TTL measured from now")
+	flag.StringVar(&o.role, "role", "", "consumer | provider (required)")
+	flag.Parse()
+
+	if err := seed(o); err != nil {
+		fmt.Fprintf(os.Stderr, "seed: %v\n", err)
+		os.Exit(1)
+	}
+}
+
+// seed opens the store, writes the session record shared by both roles, then
+// writes the one User record that role needs: the provider stores the
+// consumer's address/pubkey (as on InitiateSessionResponse); the consumer
+// stores the provider's address/pubkey/url (as after InitiateSession).
+func seed(o options) error {
+	switch o.role {
+	case "consumer", "provider":
+	default:
+		return fmt.Errorf("--role must be \"consumer\" or \"provider\"")
+	}
+	if o.store == "" {
+		return fmt.Errorf("--store is required")
+	}
+	if o.ttl <= 0 {
+		return fmt.Errorf("--ttl must be positive")
+	}
+	if o.role == "consumer" && o.providerURL == "" {
+		return fmt.Errorf("--provider-url is required for --role consumer")
+	}
+
+	sessionID, err := hash32("--session", o.session)
+	if err != nil {
+		return err
+	}
+	modelID, err := hash32("--model", o.model)
+	if err != nil {
+		return err
+	}
+	userAddr, userPubKey, err := keyMaterial(o.userKey)
+	if err != nil {
+		return fmt.Errorf("--user-key: %w", err)
+	}
+	providerAddr, providerPubKey, err := keyMaterial(o.providerKey)
+	if err != nil {
+		return fmt.Errorf("--provider-key: %w", err)
+	}
+
+	log := lib.NewTestLogger()
+	storage, err := storages.NewStorage(log, o.store)
+	if err != nil {
+		return fmt.Errorf("opening store %s: %w", o.store, err)
+	}
+	defer storage.Close()
+	sessionStorage := storages.NewSessionStorage(storage)
+
+	endsAt := big.NewInt(time.Now().Add(o.ttl).Unix())
+	session := &storages.Session{
+		Id:           sessionID.Hex(),
+		UserAddr:     userAddr.Hex(),
+		ProviderAddr: providerAddr.Hex(),
+		ModelID:      modelID.Hex(),
+		EndsAt:       endsAt,
+	}
+	if err := sessionStorage.AddSession(session); err != nil {
+		return fmt.Errorf("writing session: %w", err)
+	}
+	fmt.Printf("session %s: user=%s provider=%s model=%s endsAt=%d\n",
+		session.Id, session.UserAddr, session.ProviderAddr, session.ModelID, endsAt.Int64())
+
+	switch o.role {
+	case "provider":
+		user := &storages.User{Addr: userAddr.Hex(), PubKey: userPubKey}
+		if err := sessionStorage.AddUser(user); err != nil {
+			return fmt.Errorf("writing consumer user record: %w", err)
+		}
+		fmt.Printf("user %s (consumer) stored for provider-side lookup\n", user.Addr)
+	case "consumer":
+		user := &storages.User{Addr: providerAddr.Hex(), PubKey: providerPubKey, Url: o.providerURL}
+		if err := sessionStorage.AddUser(user); err != nil {
+			return fmt.Errorf("writing provider user record: %w", err)
+		}
+		fmt.Printf("user %s (provider) stored at %s for consumer-side dialing\n", user.Addr, user.Url)
+	}
+
+	return nil
+}
+
+// hash32 parses a required 0x-prefixed 32-byte hex value (session/model id).
+func hash32(flagName, s string) (common.Hash, error) {
+	if s == "" {
+		return common.Hash{}, fmt.Errorf("%s is required", flagName)
+	}
+	b := common.FromHex(s)
+	if len(b) != 32 {
+		return common.Hash{}, fmt.Errorf("%s: %q is not a 32-byte hex value", flagName, s)
+	}
+	return common.BytesToHash(b), nil
+}
+
+// keyMaterial derives the checksummed address and public key string
+// (lib.HexString's "0x"+hex format — matches req.Key.Hex() on the provider
+// side and typedMsg.PubKey.String() on the consumer side, both of which call
+// the same HexString.Hex()/String() method) from a private key hex string.
+func keyMaterial(hexKey string) (common.Address, string, error) {
+	if hexKey == "" {
+		return common.Address{}, "", fmt.Errorf("private key is required")
+	}
+	privKeyBytes := common.FromHex(hexKey)
+	addr, err := lib.PrivKeyBytesToAddr(privKeyBytes)
+	if err != nil {
+		return common.Address{}, "", fmt.Errorf("invalid private key: %w", err)
+	}
+	pubKey, err := lib.PubKeyFromPrivate(privKeyBytes)
+	if err != nil {
+		return common.Address{}, "", fmt.Errorf("invalid private key: %w", err)
+	}
+	return addr, pubKey.Hex(), nil
+}
diff --git a/proxy-router/internal/sealed/e2e/seed/main_test.go b/proxy-router/internal/sealed/e2e/seed/main_test.go
new file mode 100644
index 00000000..1d7408f0
--- /dev/null
+++ b/proxy-router/internal/sealed/e2e/seed/main_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"encoding/hex"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/lib"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/storages"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/stretchr/testify/require"
+)
+
+// TestSeedProviderAndConsumer seeds a provider-side store and a consumer-side
+// store from the same session/model ids and key pair, reopens each store with
+// the repo's own storage code, and checks the records seed wrote are exactly
+// what the running proxy-router would have written itself.
+func TestSeedProviderAndConsumer(t *testing.T) {
+	userKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	providerKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+
+	userKeyHex := hex.EncodeToString(crypto.FromECDSA(userKey))
+	providerKeyHex := hex.EncodeToString(crypto.FromECDSA(providerKey))
+	userAddr := crypto.PubkeyToAddress(userKey.PublicKey)
+	providerAddr := crypto.PubkeyToAddress(providerKey.PublicKey)
+	userPubKey, err := lib.PubKeyFromPrivate(crypto.FromECDSA(userKey))
+	require.NoError(t, err)
+	providerPubKey, err := lib.PubKeyFromPrivate(crypto.FromECDSA(providerKey))
+	require.NoError(t, err)
+
+	sessionID := "0x" + strings.Repeat("11", 32)
+	modelID := "0x" + strings.Repeat("22", 32)
+	providerURL := "127.0.0.1:9999"
+	ttl := time.Hour
+
+	// role=provider: AddUser stores the CONSUMER's address/pubkey.
+	providerStoreDir := filepath.Join(t.TempDir(), "provider-store")
+	before := time.Now()
+	err = seed(options{
+		store: providerStoreDir, session: sessionID, model: modelID,
+		userKey: userKeyHex, providerKey: providerKeyHex, ttl: ttl, role: "provider",
+	})
+	after := time.Now()
+	require.NoError(t, err)
+
+	storage, err := storages.NewStorage(lib.NewTestLogger(), providerStoreDir)
+	require.NoError(t, err)
+	providerStorage := storage
+	t.Cleanup(func() { providerStorage.Close() })
+	sessionStorage := storages.NewSessionStorage(storage)
+
+	ses, err := sessionStorage.GetSession(sessionID)
+	require.NoError(t, err)
+	require.NotNil(t, ses)
+	require.Equal(t, sessionID, ses.Id)
+	require.Equal(t, userAddr.Hex(), ses.UserAddr)
+	require.Equal(t, providerAddr.Hex(), ses.ProviderAddr)
+	require.Equal(t, modelID, ses.ModelID)
+	require.GreaterOrEqual(t, ses.EndsAt.Int64(), before.Add(ttl).Unix())
+	require.LessOrEqual(t, ses.EndsAt.Int64(), after.Add(ttl).Unix())
+
+	consumerUser, err := sessionStorage.GetUser(userAddr.Hex())
+	require.NoError(t, err)
+	require.NotNil(t, consumerUser)
+	require.Equal(t, userAddr.Hex(), consumerUser.Addr)
+	require.Equal(t, userPubKey.Hex(), consumerUser.PubKey)
+	require.Empty(t, consumerUser.Url)
+
+	// role=consumer: AddUser stores the PROVIDER's address/pubkey/url.
+	consumerStoreDir := filepath.Join(t.TempDir(), "consumer-store")
+	err = seed(options{
+		store: consumerStoreDir, session: sessionID, model: modelID,
+		userKey: userKeyHex, providerKey: providerKeyHex, providerURL: providerURL,
+		ttl: ttl, role: "consumer",
+	})
+	require.NoError(t, err)
+
+	consumerStorage, err := storages.NewStorage(lib.NewTestLogger(), consumerStoreDir)
+	require.NoError(t, err)
+	t.Cleanup(func() { consumerStorage.Close() })
+	storage = consumerStorage
+	sessionStorage = storages.NewSessionStorage(storage)
+
+	ses, err = sessionStorage.GetSession(sessionID)
+	require.NoError(t, err)
+	require.NotNil(t, ses)
+	require.Equal(t, userAddr.Hex(), ses.UserAddr)
+	require.Equal(t, providerAddr.Hex(), ses.ProviderAddr)
+	require.Equal(t, modelID, ses.ModelID)
+
+	providerUser, err := sessionStorage.GetUser(providerAddr.Hex())
+	require.NoError(t, err)
+	require.NotNil(t, providerUser)
+	require.Equal(t, providerAddr.Hex(), providerUser.Addr)
+	require.Equal(t, providerPubKey.Hex(), providerUser.PubKey)
+	require.Equal(t, providerURL, providerUser.Url)
+}
diff --git a/proxy-router/internal/sealed/live_test.go b/proxy-router/internal/sealed/live_test.go
new file mode 100644
index 00000000..ea951ad0
--- /dev/null
+++ b/proxy-router/internal/sealed/live_test.go
@@ -0,0 +1,256 @@
+package sealed
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/attestation/appleattest"
+	"github.com/stretchr/testify/require"
+)
+
+func testCfg() appleattest.Config {
+	return appleattest.Config{AppID: "A.b", AllowAnyCode: true}
+}
+
+// liveEngine drives a running sealed-engine. Env: SEALED_ENGINE_URL,
+// APPLEATTEST_APPID, SEALED_EXPECT_CDHASH (hex). SEALED_EXPECT_REJECT=1
+// asserts the engine is NOT the pinned build.
+type liveEngine struct {
+	t      *testing.T
+	base   string
+	client *http.Client
+}
+
+func (e *liveEngine) call(method, path string, body any) (int, map[string]any) {
+	var rdr *bytes.Reader
+	if body != nil {
+		b, _ := json.Marshal(body)
+		rdr = bytes.NewReader(b)
+	} else {
+		rdr = bytes.NewReader(nil)
+	}
+	req, err := http.NewRequest(method, e.base+path, rdr)
+	require.NoError(e.t, err)
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := e.client.Do(req)
+	require.NoError(e.t, err)
+	defer resp.Body.Close()
+	var out map[string]any
+	_ = json.NewDecoder(resp.Body).Decode(&out)
+	return resp.StatusCode, out
+}
+
+func b64(t *testing.T, v any) []byte {
+	s, _ := v.(string)
+	b, err := base64.StdEncoding.DecodeString(s)
+	require.NoError(t, err)
+	return b
+}
+
+// handshake runs /session with a fresh challenge and client key.
+func (e *liveEngine) handshake() Handshake {
+	key, err := NewClientKey()
+	require.NoError(e.t, err)
+	ch := make([]byte, 32)
+	_, _ = rand.Read(ch)
+	status, out := e.call("POST", "/session", map[string]string{
+		"challenge": base64.StdEncoding.EncodeToString(ch),
+		"clientPub": base64.StdEncoding.EncodeToString(key.Public()),
+	})
+	require.Equal(e.t, 200, status, "session: %v", out)
+	return Handshake{
+		SessionID: out["sessionId"].(string), Challenge: ch, Key: key,
+		ClientData: b64(e.t, out["clientData"]), Assertion: b64(e.t, out["assertion"]),
+	}
+}
+
+func (e *liveEngine) infer(f Frame) (int, []Frame) {
+	status, out := e.call("POST", "/infer", f)
+	var frames []Frame
+	raw, _ := json.Marshal(out["frames"])
+	_ = json.Unmarshal(raw, &frames)
+	return status, frames
+}
+
+func TestLiveSealedEngine(t *testing.T) {
+	base, appID, want := os.Getenv("SEALED_ENGINE_URL"), os.Getenv("APPLEATTEST_APPID"), os.Getenv("SEALED_EXPECT_CDHASH")
+	if base == "" || appID == "" || want == "" {
+		t.Skip("SEALED_ENGINE_URL / APPLEATTEST_APPID / SEALED_EXPECT_CDHASH not set")
+	}
+	if os.Getenv("SEALED_EXPECT_WEIGHTS") != "" {
+		t.Skip("engine is in model mode; TestLiveSealedInference covers it")
+	}
+	pinned, err := hex.DecodeString(want)
+	require.NoError(t, err)
+	cfg := appleattest.Config{AppID: appID, Environment: appleattest.Production, ExpectedCDHashes: [][]byte{pinned}}
+	e := &liveEngine{t: t, base: base, client: &http.Client{Timeout: 30 * time.Second}}
+	zeroWeights := [][]byte{make([]byte, 32)} // engine placeholder until P4
+
+	status, att := e.call("GET", "/attest", nil)
+	require.Equal(t, 200, status)
+	attCDH := sha256.Sum256(b64(t, att["clientData"]))
+	verified, err := appleattest.VerifyAttestation(cfg, b64(t, att["attestation"]), b64(t, att["keyId"]), attCDH[:])
+	if os.Getenv("SEALED_EXPECT_REJECT") == "1" {
+		require.ErrorIs(t, err, appleattest.ErrCode, "a build that is not the published one must be refused")
+		return
+	}
+	require.NoError(t, err)
+
+	// Happy path: bound handshake → sealed prompt → complete sealed response.
+	h := e.handshake()
+	cs, counter, err := Establish(cfg, verified, h, zeroWeights)
+	require.NoError(t, err)
+	prompt := []byte(`{"messages":[{"role":"user","content":"CANARY-SEALED-PROMPT-3141"}]}`)
+	f, err := cs.Seal(prompt)
+	require.NoError(t, err)
+	status, frames := e.infer(f)
+	require.Equal(t, 200, status)
+	chunks, err := cs.OpenResponse(frames)
+	require.NoError(t, err, "response must be complete and authentic")
+	sum := sha256.Sum256(prompt)
+	require.Equal(t, "bytes="+strconv.Itoa(len(prompt)), string(chunks[1]))
+	require.Equal(t, "sha256="+hex.EncodeToString(sum[:]), string(chunks[2]), "engine must have decrypted the exact prompt")
+	t.Logf("sealed round trip ok (app attest counter %d): %q", counter, chunks)
+
+	// Replay and tamper are refused by the engine.
+	status, _ = e.infer(f)
+	require.Equal(t, 422, status, "replayed frame must be refused")
+
+	// Truncation: dropping the final frame is detected by the consumer.
+	h2 := e.handshake()
+	cs2, counter, err := Establish(cfg, verified, h2, zeroWeights)
+	require.NoError(t, err)
+	f2, _ := cs2.Seal(prompt)
+	_, frames2 := e.infer(f2)
+	_, err = cs2.OpenResponse(frames2[:len(frames2)-1])
+	require.ErrorIs(t, err, ErrTruncated)
+
+	// Operator hijack: a frame sealed under a key the handshake did not bind
+	// must be refused, and must not break the consumer's own session.
+	h3 := e.handshake()
+	cs3, counter, err := Establish(cfg, verified, h3, zeroWeights)
+	require.NoError(t, err)
+	opKey, _ := NewClientKey()
+	opSession, err := newSession(h3.SessionID, h3.Challenge, h3.ClientData[64:96], opKey.priv)
+	require.NoError(t, err)
+	opFrame, _ := opSession.Seal([]byte("operator prompt"))
+	status, _ = e.infer(opFrame)
+	require.Equal(t, 422, status, "frame under an unbound client key must be refused")
+	f3, _ := cs3.Seal(prompt)
+	status, frames3 := e.infer(f3)
+	require.Equal(t, 200, status, "consumer's bound session must survive the hijack attempt")
+	_, err = cs3.OpenResponse(frames3)
+	require.NoError(t, err)
+
+	// Binding: the asserted clientData must match what the consumer sent/expects.
+	h4 := e.handshake()
+	h4.PrevCounter = counter
+	wrong := h4 // struct copy
+	wrong.Challenge = make([]byte, 32)
+	_, _, err = Establish(cfg, verified, wrong, zeroWeights)
+	require.True(t, errors.Is(err, ErrBinding), "foreign challenge: %v", err)
+	otherWeights := bytes.Repeat([]byte{7}, 32)
+	_, _, err = Establish(cfg, verified, h4, [][]byte{otherWeights})
+	require.True(t, errors.Is(err, ErrBinding), "unexpected weights: %v", err)
+	swappedKey := h4
+	swappedKey.Key, _ = NewClientKey() // engine bound a different client key
+	_, _, err = Establish(cfg, verified, swappedKey, zeroWeights)
+	require.True(t, errors.Is(err, ErrBinding), "client key not the one sent: %v", err)
+
+	// The assertion itself must be verified: tampered signature, replayed counter.
+	badSig := h4
+	badSig.Assertion = bytes.Clone(h4.Assertion)
+	badSig.Assertion[len(badSig.Assertion)-5] ^= 1
+	_, _, err = Establish(cfg, verified, badSig, zeroWeights)
+	require.Error(t, err, "tampered assertion must be refused")
+	replayed := h4
+	replayed.PrevCounter = 1 << 30
+	_, _, err = Establish(cfg, verified, replayed, zeroWeights)
+	require.True(t, errors.Is(err, appleattest.ErrCounter), "replayed counter: %v", err)
+	// Public probe (third-party verification): provider binding, freshness, and
+	// no confusion with handshakes in either direction.
+	if addr := os.Getenv("SEALED_EXPECT_PROVIDER"); addr != "" {
+		pch := make([]byte, 32)
+		_, _ = rand.Read(pch)
+		status, pr := e.call("POST", "/probe", map[string]string{"challenge": base64.StdEncoding.EncodeToString(pch)})
+		require.Equal(t, 200, status)
+		pcd, pas := b64(t, pr["clientData"]), b64(t, pr["assertion"])
+		rep, err := VerifyProbe(cfg, verified, pch, pcd, pas, addr, zeroWeights)
+		require.NoError(t, err)
+		require.True(t, rep.ProviderBound)
+		require.Equal(t, pinned, rep.CDHash)
+		_, err = VerifyProbe(cfg, verified, pch, pcd, pas, "0x000000000000000000000000000000000000dEaD", nil)
+		require.ErrorIs(t, err, ErrProviderBinding, "a probe relayed to another provider's engine")
+		other := make([]byte, 32)
+		_, err = VerifyProbe(cfg, verified, other, pcd, pas, addr, nil)
+		require.ErrorIs(t, err, ErrProbeChallenge)
+		asHandshake := Handshake{SessionID: "probe", Challenge: pch, Key: h4.Key, ClientData: pcd, Assertion: pas}
+		_, _, err = Establish(cfg, verified, asHandshake, zeroWeights)
+		require.ErrorIs(t, err, ErrBinding, "a probe must never establish a session")
+		_, err = VerifyProbe(cfg, verified, h4.Challenge, h4.ClientData, h4.Assertion, "", nil)
+		require.ErrorIs(t, err, ErrBinding, "a handshake assertion must never pass as a probe")
+	}
+
+	forgedData := h4
+	forgedData.ClientData = bytes.Clone(h4.ClientData)
+	forgedData.ClientData[70] ^= 1 // operator swaps the engine key in clientData
+	_, _, err = Establish(cfg, verified, forgedData, zeroWeights)
+	require.True(t, errors.Is(err, appleattest.ErrSignature), "engine key substitution: %v", err)
+}
+
+// TestLiveSealedInference (P4) drives an engine started with SEALED_MODEL_DIR.
+// Env as TestLiveSealedEngine plus SEALED_EXPECT_WEIGHTS = the Go-computed
+// WeightsManifestHash of the same model directory.
+func TestLiveSealedInference(t *testing.T) {
+	base, appID, want, weightsHex := os.Getenv("SEALED_ENGINE_URL"), os.Getenv("APPLEATTEST_APPID"), os.Getenv("SEALED_EXPECT_CDHASH"), os.Getenv("SEALED_EXPECT_WEIGHTS")
+	if base == "" || appID == "" || want == "" || weightsHex == "" {
+		t.Skip("model-mode env not set")
+	}
+	pinned, err := hex.DecodeString(want)
+	require.NoError(t, err)
+	weights, err := hex.DecodeString(weightsHex)
+	require.NoError(t, err)
+	cfg := appleattest.Config{AppID: appID, Environment: appleattest.Production, ExpectedCDHashes: [][]byte{pinned}}
+	e := &liveEngine{t: t, base: base, client: &http.Client{Timeout: 300 * time.Second}}
+
+	status, att := e.call("GET", "/attest", nil)
+	require.Equal(t, 200, status)
+	attCDH := sha256.Sum256(b64(t, att["clientData"]))
+	verified, err := appleattest.VerifyAttestation(cfg, b64(t, att["attestation"]), b64(t, att["keyId"]), attCDH[:])
+	require.NoError(t, err)
+
+	// A consumer that expects different weights must refuse the session.
+	hWrong := e.handshake()
+	_, _, err = Establish(cfg, verified, hWrong, [][]byte{bytes.Repeat([]byte{9}, 32)})
+	require.ErrorIs(t, err, ErrBinding, "engine's loaded weights are not the expected ones")
+
+	h := e.handshake()
+	require.Equal(t, weights, h.ClientData[96:128], "engine's attested weights hash must equal the Go-computed hash of the same files")
+	cs, _, err := Establish(cfg, verified, h, [][]byte{weights})
+	require.NoError(t, err)
+
+	prompt := []byte(`{"messages":[{"role":"system","content":"Answer with just the number."},{"role":"user","content":"What is 2+2?"}],"max_tokens":16,"temperature":0}`)
+	f, err := cs.Seal(prompt)
+	require.NoError(t, err)
+	status, frames := e.infer(f)
+	require.Equal(t, 200, status)
+	chunks, err := cs.OpenResponse(frames)
+	require.NoError(t, err)
+	var answer strings.Builder
+	for _, c := range chunks {
+		answer.Write(c)
+	}
+	t.Logf("sealed inference: %d frames, answer %q", len(frames), answer.String())
+	require.Contains(t, answer.String(), "4", "a real model answered the sealed prompt")
+}
