+
+// SealedModelTag marks a model served by an attested sealed engine.
+const SealedModelTag = "tee-apple"
+
+var (
+	ErrSealedNotConfigured = errors.New("model is sealed but this node has no sealed configuration (pin) for it; refusing to send plaintext")
+	ErrSealedTagsUnknown   = errors.New("cannot determine whether the model is sealed; refusing to send")
+	ErrSealedLaneUnwired   = errors.New("sealed lane not wired in this binary; refusing to send (cannot rule out a sealed model)")
+	ErrSealedRelay         = errors.New("sealed relay failed")
+	ErrSealedRequestType   = errors.New("sealed models only accept sealed chat prompts")
+)
+
+// SealedConfig pins what a consumer accepts from sealed engines.
+//
+// Models is the consumer-side pin: every listed model is ALWAYS sealed,
+// whatever its on-chain tags say (the model owner can rewrite tags), and only
+// the listed weights hashes are accepted for it.
+//
+// PinFromListing (SEALED_MODEL_WEIGHTS=listing) also accepts any model tagged
+// tee-apple, pinned to the weights hash its own listing commits to (the
+// listing's content ID, read from the chain when the channel is set up). The
+// engine pins (AppID + CD hashes) are what keep prompts private; the weights
+// pin only binds the session to the weights the listing names.
+type SealedConfig struct {
+	Attest         appleattest.Config       // AppID, ExpectedCDHashes (fail closed), environment
+	Models         map[common.Hash][][]byte // modelID → allowed 32-byte weights hashes
+	PinFromListing bool
+}
+
+// ModelWeightsLookup reads the weights hash a sealed listing commits to.
+type ModelWeightsLookup interface {
+	GetModelWeightsHash(ctx context.Context, modelID common.Hash) ([32]byte, error)
+}
+
+// SealedConfigFromEnv builds the consumer's sealed-lane policy:
+//
+//	SEALED_APP_ID        "<TeamID>.<BundleID>" of the published engine (empty = lane not configured)
+//	SEALED_CDHASHES      comma-separated hex SHA-256 CD hashes of published engine builds (required)
+//	SEALED_MODEL_WEIGHTS comma-separated "<modelID hex>:<weights SHA-256 hex>" pins (required);
+//	                     a model may appear several times to allow several weights versions
+//	SEALED_ENV           "production" (default) or "development" App Attest environment
+func SealedConfigFromEnv() (*SealedConfig, error) {
+	appID := strings.TrimSpace(os.Getenv("SEALED_APP_ID"))
+	if appID == "" {
+		return nil, nil
+	}
+	hash32 := func(name, h string) ([]byte, error) {
+		b, err := hex.DecodeString(strings.TrimPrefix(strings.TrimSpace(h), "0x"))
+		if err != nil || len(b) != 32 {
+			return nil, fmt.Errorf("%s: %q is not a 32-byte hex hash", name, h)
+		}
+		return b, nil
+	}
+	var cdhashes [][]byte
+	for _, h := range strings.Split(os.Getenv("SEALED_CDHASHES"), ",") {
+		if strings.TrimSpace(h) == "" {
+			continue
+		}
+		b, err := hash32("SEALED_CDHASHES", h)
+		if err != nil {
+			return nil, err
+		}
+		cdhashes = append(cdhashes, b)
+	}
+	if len(cdhashes) == 0 {
+		return nil, fmt.Errorf("SEALED_CDHASHES is required when SEALED_APP_ID is set")
+	}
+	models := map[common.Hash][][]byte{}
+	pinFromListing := false
+	weightsEnv := os.Getenv("SEALED_MODEL_WEIGHTS")
+	if strings.TrimSpace(weightsEnv) == "listing" {
+		pinFromListing, weightsEnv = true, ""
+	}
+	for _, pair := range strings.Split(weightsEnv, ",") {
+		if strings.TrimSpace(pair) == "" {
+			continue
+		}
+		model, weights, ok := strings.Cut(pair, ":")
+		if !ok {
+			return nil, fmt.Errorf("SEALED_MODEL_WEIGHTS: %q is not <modelID>:<weightsHash>", pair)
+		}
+		mid, err := hash32("SEALED_MODEL_WEIGHTS model", model)
+		if err != nil {
+			return nil, err
+		}
+		w, err := hash32("SEALED_MODEL_WEIGHTS weights", weights)
+		if err != nil {
+			return nil, err
+		}
+		key := common.BytesToHash(mid)
+		models[key] = append(models[key], w)
+	}
+	if len(models) == 0 && !pinFromListing {
+		return nil, fmt.Errorf("SEALED_MODEL_WEIGHTS is required when SEALED_APP_ID is set (pairs, or \"listing\")")
+	}
+	env := appleattest.Production
+	switch strings.ToLower(strings.TrimSpace(os.Getenv("SEALED_ENV"))) {
+	case "", "production":
+	case "development":
+		env = appleattest.Development
+	default:
+		return nil, fmt.Errorf("SEALED_ENV must be production or development")
+	}
+	return &SealedConfig{
+		Attest:         appleattest.Config{AppID: appID, Environment: env, ExpectedCDHashes: cdhashes},
+		Models:         models,
+		PinFromListing: pinFromListing,
+	}, nil
+}
+
+// ModelTagsLookup is satisfied by the blockchain service.
+type ModelTagsLookup interface {
+	GetModelTags(ctx context.Context, modelID common.Hash) ([]string, error)
+}
+
+type sealedChannel struct {
+	cs      *sealed.ClientSession
+	created time.Time
+}
+
+type tagEntry struct {
+	tags    []string
+	fetched time.Time
+}
+
+type sealedState struct {
+	cfg      *SealedConfig
+	tags     ModelTagsLookup
+	mu       sync.Mutex
+	channels map[common.Hash]*sealedChannel
+	tagCache map[common.Hash]tagEntry
+	seen     map[common.Hash]bool // models ever seen sealed: never downgraded in this process
+	// relay overrides the MOR-RPC transport in tests; nil = p.sealedRelay.
+	relay func(ctx context.Context, sessionID common.Hash, provider *storages.User, op string, body []byte) (int, []byte, error)
+}
+
+func (p *ProxyServiceSender) doRelay(ctx context.Context, sessionID common.Hash, provider *storages.User, op string, body []byte) (int, []byte, error) {
+	if p.sealed.relay != nil {
+		return p.sealed.relay(ctx, sessionID, provider, op, body)
+	}
+	return p.sealedRelay(ctx, sessionID, provider, op, body)
+}
+
+const (
+	sealedTagTTL      = 10 * time.Minute
+	sealedTagMaxStale = 24 * time.Hour // a failed lookup may reuse an older answer this long
+	sealedChannelTTL  = time.Hour
+	sealedMaxChannels = 512
+)
+
+// SetSealed enables the sealed lane. cfg may be nil (then sealed models are
+// refused rather than sent plaintext); tags must be non-nil.
+func (p *ProxyServiceSender) SetSealed(cfg *SealedConfig, tags ModelTagsLookup) {
+	p.sealed = &sealedState{cfg: cfg, tags: tags, channels: map[common.Hash]*sealedChannel{}, tagCache: map[common.Hash]tagEntry{}, seen: map[common.Hash]bool{}}
+}
+
+// sealedDecision returns (true, nil) when the prompt must take the sealed
+// path, (false, nil) for ordinary models, or an error whenever sending could
+// put plaintext in front of a sealed provider. It fails closed: an unwired
+// lane, an unanswerable tag lookup, or a sealed model without a pin all refuse.
+// A model is sealed if it is pinned in the config, tagged tee-apple, or was
+// ever seen sealed by this process (tags can be rewritten by the model owner).
+func (p *ProxyServiceSender) sealedDecision(ctx context.Context, modelID common.Hash) (bool, error) {
+	st := p.sealed
+	if st == nil || st.tags == nil {
+		return false, ErrSealedLaneUnwired
+	}
+	pinned := false // pinned in the config: sealed whatever its tags say
+	if st.cfg != nil {
+		_, pinned = st.cfg.Models[modelID]
+	}
+	st.mu.Lock()
+	sealedBefore := st.seen[modelID]
+	e, cached := st.tagCache[modelID]
+	st.mu.Unlock()
+
+	isSealed := pinned || sealedBefore
+	if !isSealed {
+		if !cached || time.Since(e.fetched) > sealedTagTTL {
+			tags, err := st.tags.GetModelTags(ctx, modelID)
+			switch {
+			case err == nil:
+				e = tagEntry{tags: tags, fetched: time.Now()}
+				st.mu.Lock()
+				st.tagCache[modelID] = e
+				st.mu.Unlock()
+			case !cached || time.Since(e.fetched) > sealedTagMaxStale:
+				return false, lib.WrapError(ErrSealedTagsUnknown, err)
+			} // lookup failed but a recent-enough answer exists: keep using it
+		}
+		for _, t := range e.tags {
+			if strings.EqualFold(t, SealedModelTag) {
+				isSealed = true
+			}
+		}
+	}
+	if !isSealed {
+		return false, nil
+	}
+	st.mu.Lock()
+	st.seen[modelID] = true
+	st.mu.Unlock()
+	if !pinned && (st.cfg == nil || !st.cfg.PinFromListing) {
+		return false, ErrSealedNotConfigured
+	}
+	return true, nil
+}
+
+// weightsFor returns the weights hashes accepted for a sealed model: the
+// configured pins, or (PinFromListing) the one its listing commits to.
+func (st *sealedState) weightsFor(ctx context.Context, modelID common.Hash) ([][]byte, error) {
+	if w := st.cfg.Models[modelID]; len(w) > 0 {
+		return w, nil
+	}
+	if !st.cfg.PinFromListing {
+		return nil, ErrSealedNotConfigured
+	}
+	lookup, ok := st.tags.(ModelWeightsLookup)
+	if !ok {
+		return nil, ErrSealedNotConfigured
+	}
+	h, err := lookup.GetModelWeightsHash(ctx, modelID)
+	if err != nil {
+		return nil, lib.WrapError(ErrSealedTagsUnknown, err)
+	}
+	if h == ([32]byte{}) {
+		return nil, fmt.Errorf("%w: the listing commits to no weights hash", ErrSealedNotConfigured)
+	}
+	return [][]byte{h[:]}, nil
+}
+
+// sealedRelay sends one signed sealed.relay request and returns the engine's
+// status and body after checking the provider's signature.
+func (p *ProxyServiceSender) sealedRelay(ctx context.Context, sessionID common.Hash, provider *storages.User, op string, body []byte) (int, []byte, error) {
+	requestID := lib.RequestIDFromContext(ctx)
+	if requestID == "" {
+		requestID = lib.GenerateRequestID()
+	}
+	prKey, err := p.privateKey.GetPrivateKey()
+	if err != nil {
+		return 0, nil, ErrMissingPrKey
+	}
+	req, err := p.morRPC.SealedRelayRequest(sessionID, op, body, prKey, requestID)
+	if err != nil {
+		return 0, nil, lib.WrapError(ErrCreateReq, err)
+	}
+	msg, code, err := p.rpcRequest(provider.Url, req)
+	if err != nil {
+		return 0, nil, lib.WrapError(ErrSealedRelay, fmt.Errorf("code %d: %w", code, err))
+	}
+	if msg.Error != nil {
+		return 0, nil, lib.WrapError(ErrSealedRelay, fmt.Errorf("%v", msg.Error.Message))
+	}
+	if msg.Result == nil {
+		return 0, nil, lib.WrapError(ErrSealedRelay, ErrEmpty)
+	}
+	var res msgs.SealedRelayRes
+	if err := json.Unmarshal(*msg.Result, &res); err != nil {
+		return 0, nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	sig := res.Signature
+	res.Signature = lib.HexString{}
+	hexPubKey, err := lib.StringToHexString(provider.PubKey)
+	if err != nil || !p.validateMsgSignature(res, sig, hexPubKey) {
+		return 0, nil, ErrInvalidSig
+	}
+	out, err := base64.StdEncoding.DecodeString(res.Body)
+	if err != nil {
+		return 0, nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	return res.Status, out, nil
+}
+
+// sealedChannelFor returns the session's established channel, running the
+// attest + bound handshake on first use.
+func (p *ProxyServiceSender) sealedChannelFor(ctx context.Context, sessionID, modelID common.Hash, provider *storages.User) (*sealedChannel, error) {
+	st := p.sealed
+	st.mu.Lock()
+	ch := st.channels[sessionID]
+	st.mu.Unlock()
+	if ch != nil && time.Since(ch.created) <= sealedChannelTTL {
+		return ch, nil
+	}
+	cfg := st.cfg
+	weights, err := st.weightsFor(ctx, modelID)
+	if err != nil {
+		return nil, err
+	}
+
+	status, attBody, err := p.doRelay(ctx, sessionID, provider, "attest", nil)
+	if err != nil {
+		return nil, err
+	}
+	if status != 200 {
+		return nil, lib.WrapError(ErrSealedRelay, fmt.Errorf("attest: engine status %d", status))
+	}
+	var att struct {
+		KeyID       string `json:"keyId"`
+		Attestation string `json:"attestation"`
+		ClientData  string `json:"clientData"`
+	}
+	if err := json.Unmarshal(attBody, &att); err != nil {
+		return nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	keyID, e1 := base64.StdEncoding.DecodeString(att.KeyID)
+	attObj, e2 := base64.StdEncoding.DecodeString(att.Attestation)
+	attCD, e3 := base64.StdEncoding.DecodeString(att.ClientData)
+	if err := errors.Join(e1, e2, e3); err != nil {
+		return nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	attCDH := sha256.Sum256(attCD)
+	verified, err := appleattest.VerifyAttestation(cfg.Attest, attObj, keyID, attCDH[:])
+	if err != nil {
+		return nil, err
+	}
+
+	key, err := sealed.NewClientKey()
+	if err != nil {
+		return nil, err
+	}
+	challenge := make([]byte, 32)
+	if _, err := rand.Read(challenge); err != nil {
+		return nil, err
+	}
+	reqBody, _ := json.Marshal(map[string]string{
+		"challenge": base64.StdEncoding.EncodeToString(challenge),
+		"clientPub": base64.StdEncoding.EncodeToString(key.Public()),
+	})
+	status, sesBody, err := p.doRelay(ctx, sessionID, provider, "session", reqBody)
+	if err != nil {
+		return nil, err
+	}
+	if status != 200 {
+		return nil, lib.WrapError(ErrSealedRelay, fmt.Errorf("session: engine status %d", status))
+	}
+	var ses struct {
+		SessionID  string `json:"sessionId"`
+		ClientData string `json:"clientData"`
+		Assertion  string `json:"assertion"`
+	}
+	if err := json.Unmarshal(sesBody, &ses); err != nil {
+		return nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	cd, e1 := base64.StdEncoding.DecodeString(ses.ClientData)
+	as, e2 := base64.StdEncoding.DecodeString(ses.Assertion)
+	if err := errors.Join(e1, e2); err != nil {
+		return nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	cs, _, err := sealed.Establish(cfg.Attest, verified, sealed.Handshake{
+		SessionID: ses.SessionID, Challenge: challenge, Key: key, ClientData: cd, Assertion: as,
+	}, weights)
+	if err != nil {
+		return nil, err
+	}
+	ch = &sealedChannel{cs: cs, created: time.Now()}
+	st.storeChannel(sessionID, ch)
+	return ch, nil
+}
+
+// storeChannel expires old channels, enforces the cap (oldest first), then stores ch.
+func (st *sealedState) storeChannel(sessionID common.Hash, ch *sealedChannel) {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	for id, c := range st.channels { // expire, then cap
+		if time.Since(c.created) > sealedChannelTTL {
+			delete(st.channels, id)
+		}
+	}
+	for len(st.channels) >= sealedMaxChannels {
+		var oldest common.Hash
+		var at time.Time
+		for id, c := range st.channels {
+			if at.IsZero() || c.created.Before(at) {
+				oldest, at = id, c.created
+			}
+		}
+		delete(st.channels, oldest)
+	}
+	st.channels[sessionID] = ch
+}
+
+// refuseSealed blocks request types the sealed lane does not carry (audio,
+// embeddings, agent tools), so their plaintext never reaches a sealed provider.
+func (p *ProxyServiceSender) refuseSealed(ctx context.Context, modelID common.Hash) error {
+	isSealed, err := p.sealedDecision(ctx, modelID)
+	if err != nil {
+		return err
+	}
+	if isSealed {
+		return ErrSealedRequestType
+	}
+	return nil
+}
+
+func (p *ProxyServiceSender) dropSealedChannel(sessionID common.Hash) {
+	p.sealed.mu.Lock()
+	delete(p.sealed.channels, sessionID)
+	p.sealed.mu.Unlock()
+}
+
+// sendPromptSealed seals the prompt to the attested engine, relays it, opens
+// the complete sealed response and hands the text to cb. Any failure ends the
+// sealed channel (the next prompt re-attests and re-handshakes); nothing is
+// ever sent in plaintext.
+func (p *ProxyServiceSender) sendPromptSealed(ctx context.Context, sessionID, modelID common.Hash, provider *storages.User, prompt *gcs.OpenAICompletionRequestExtra, cb gcs.CompletionCallback) (interface{}, error) {
+	ch, err := p.sealedChannelFor(ctx, sessionID, modelID, provider)
+	if err != nil {
+		return nil, err
+	}
+	plaintext, err := json.Marshal(prompt)
+	if err != nil {
+		return nil, err
+	}
+	frame, err := ch.cs.Seal(plaintext)
+	if err != nil {
+		p.dropSealedChannel(sessionID)
+		return nil, err
+	}
+	body, _ := json.Marshal(frame)
+	status, out, err := p.doRelay(ctx, sessionID, provider, "infer", body)
+	if err == nil && status != 200 {
+		err = lib.WrapError(ErrSealedRelay, fmt.Errorf("infer: engine status %d", status))
+	}
+	if err != nil {
+		p.dropSealedChannel(sessionID)
+		return nil, err
+	}
+	var resp struct {
+		Frames []sealed.Frame `json:"frames"`
+	}
+	if err := json.Unmarshal(out, &resp); err != nil {
+		p.dropSealedChannel(sessionID)
+		return nil, lib.WrapError(ErrInvalidResponse, err)
+	}
+	chunks, err := ch.cs.OpenResponse(resp.Frames)
+	if err != nil {
+		p.dropSealedChannel(sessionID)
+		return nil, err
+	}
+	parts := make([]string, len(chunks))
+	for i, c := range chunks {
+		parts[i] = string(c)
+	}
+	text := strings.Join(parts, "") // chunk boundaries are not line boundaries
+	out2 := sealedChunks(text, prompt.Stream, prompt.Model)
+	for _, c := range out2 {
+		if err := cb(ctx, c, nil); err != nil {
+			return nil, err
+		}
+	}
+	return out2[0], nil
+}
+
+// sealedChunks shapes the engine's whole answer the way the client asked for
+// it. A streaming client (the app's chat) reads chat.completion.chunk deltas
+// and waits for [DONE]; a non-streaming one reads a chat.completion message.
+// The engine answers in one piece either way.
+// Every reply carries an id, a creation time and the model, like any OpenAI
+// response: the app's chat drops a stream event without an id, so a sealed
+// answer with "id": "" never appeared (2026-09-29).
+func sealedChunks(text string, stream bool, model string) []gcs.Chunk {
+	idBytes := make([]byte, 12)
+	_, _ = rand.Read(idBytes)
+	id := "chatcmpl-sealed-" + hex.EncodeToString(idBytes)
+	created := time.Now().Unix()
+	if !stream {
+		return []gcs.Chunk{gcs.NewChunkText(&gcs.ChatCompletionResponseExtra{ChatCompletionResponse: openai.ChatCompletionResponse{
+			ID:      id,
+			Created: created,
+			Model:   model,
+			Object:  "chat.completion",
+			Choices: []openai.ChatCompletionChoice{{
+				Index:        0,
+				Message:      openai.ChatCompletionMessage{Role: openai.ChatMessageRoleAssistant, Content: text},
+				FinishReason: openai.FinishReasonStop,
+			}},
+		}})}
+	}
+	return []gcs.Chunk{
+		gcs.NewChunkStreaming(&gcs.ChatCompletionStreamResponseExtra{ChatCompletionStreamResponse: openai.ChatCompletionStreamResponse{
+			ID:      id,
+			Created: created,
+			Model:   model,
+			Object:  "chat.completion.chunk",
+			Choices: []openai.ChatCompletionStreamChoice{{
+				Index:        0,
+				Delta:        openai.ChatCompletionStreamChoiceDelta{Role: openai.ChatMessageRoleAssistant, Content: text},
+				FinishReason: openai.FinishReasonStop,
+			}},
+		}}),
+		gcs.NewChunkControl("[DONE]"),
+	}
+}
