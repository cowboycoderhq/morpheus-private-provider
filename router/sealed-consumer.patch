+// attestation, or an assertion over the caller's challenge. Only the attest
+// and probe ops are reachable, and only for a model configured as sealed-mac.
+func (s *MORRPCController) sealedProbe(ctx context.Context, msg m.RPCMessage, sendResponse SendResponse, sourceLog lib.ILogger) error {
+	var req m.SealedProbeReq
+	if err := json.Unmarshal(msg.Params, &req); err != nil {
+		return lib.WrapError(ErrUnmarshal, err)
+	}
+	if err := s.validator.Struct(req); err != nil {
+		return lib.WrapError(ErrValidation, err)
+	}
+	if len(req.Body) > maxSealedProbeBody {
+		return lib.WrapError(ErrValidation, fmt.Errorf("sealed probe body too large"))
+	}
+	if !sealedProbeLimiter.allow() {
+		return fmt.Errorf("sealed probe rate limited")
+	}
+	res, err := s.service.SealedProbe(ctx, msg.ID, &req, sourceLog.With("model_id", req.ModelID.Hex(), "sealed_op", req.Op))
+	if err != nil {
+		sourceLog.Warnf("sealed probe failed: %s", err)
