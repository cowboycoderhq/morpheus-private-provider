+type fakeTags struct {
+	tags []string
+	err  error
+	n    int
+}
+
+func (f *fakeTags) GetModelTags(context.Context, common.Hash) ([]string, error) {
+	f.n++
+	return f.tags, f.err
+}
+
+func TestSealedDecision(t *testing.T) {
+	model := common.HexToHash("0x0a")
+	pinned := &SealedConfig{Models: map[common.Hash][][]byte{model: {make([]byte, 32)}}}
+	unpinned := &SealedConfig{Models: map[common.Hash][][]byte{common.HexToHash("0x0b"): {make([]byte, 32)}}}
+	down := errors.New("rpc down")
+	cases := []struct {
+		name    string
+		cfg     *SealedConfig
+		tags    *fakeTags
+		want    bool
+		wantErr error
+	}{
+		{"tagged + pinned → sealed", pinned, &fakeTags{tags: []string{"LLM", "TEE-Apple"}}, true, nil},
+		{"pinned, owner removed the tag → still sealed", pinned, &fakeTags{tags: []string{"llm"}}, true, nil},
+		{"pinned, tag lookup down → still sealed", pinned, &fakeTags{err: down}, true, nil},
+		{"tagged, not pinned → refuse", unpinned, &fakeTags{tags: []string{"tee-apple"}}, false, ErrSealedNotConfigured},
+		{"tag match is case-insensitive (unpinned)", unpinned, &fakeTags{tags: []string{"TEE-Apple"}}, false, ErrSealedNotConfigured},
+		{"tagged, no config → refuse", nil, &fakeTags{tags: []string{"tee-apple"}}, false, ErrSealedNotConfigured},
+		{"ordinary model → plaintext allowed", unpinned, &fakeTags{tags: []string{"llm", "tee"}}, false, nil},
+		{"ordinary model, no config → plaintext allowed", nil, &fakeTags{tags: []string{"llm"}}, false, nil},
+		{"tags unknown, configured → refuse", unpinned, &fakeTags{err: down}, false, ErrSealedTagsUnknown},
+		{"tags unknown, no config → refuse", nil, &fakeTags{err: down}, false, ErrSealedTagsUnknown},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			p := &ProxyServiceSender{}
+			p.SetSealed(c.cfg, c.tags)
+			got, err := p.sealedDecision(context.Background(), model)
+			if c.wantErr != nil {
+				require.ErrorIs(t, err, c.wantErr)
