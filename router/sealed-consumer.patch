new file mode 100644
index 00000000..05cb834c
--- /dev/null
+++ b/proxy-router/internal/aiengine/sealed_mac_test.go
@@ -0,0 +1,56 @@
+package aiengine
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/lib"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSealedMacRefusesPlaintext(t *testing.T) {
+	e := NewSealedMacEngine("m", "http://127.0.0.1:1", 0, lib.NewTestLogger())
+	require.ErrorIs(t, e.Prompt(context.Background(), nil, nil), ErrSealedPlaintext)
+	require.ErrorIs(t, e.AudioTranscription(context.Background(), nil, nil), ErrSealedPlaintext)
+	require.ErrorIs(t, e.AudioSpeech(context.Background(), nil, nil), ErrSealedPlaintext)
+	require.ErrorIs(t, e.Embeddings(context.Background(), nil, nil), ErrSealedPlaintext)
+	f, ok := ApiAdapterFactory(API_TYPE_SEALED_MAC, "m", "http://x", "", nil, 0, lib.NewTestLogger(), nil)
+	require.True(t, ok)
+	_, isRelayer := f.(SealedRelayer)
+	require.True(t, isRelayer)
+}
+
+func TestSealedMacRelayMapsOpsAndPassesBytes(t *testing.T) {
+	var seen []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		seen = append(seen, r.Method+" "+r.URL.Path+" "+string(b))
+		w.WriteHeader(201)
+		_, _ = w.Write([]byte("opaque-reply"))
+	}))
+	defer srv.Close()
+	e := NewSealedMacEngine("m", srv.URL+"/", 0, lib.NewTestLogger())
+	for _, op := range []string{"attest", "session", "infer", "probe"} {
+		status, out, err := e.SealedRelay(context.Background(), op, []byte("opaque-"+op))
+		require.NoError(t, err)
+		require.Equal(t, 201, status)
+		require.Equal(t, "opaque-reply", string(out))
+	}
+	require.Equal(t, []string{"GET /attest opaque-attest", "POST /session opaque-session", "POST /infer opaque-infer", "POST /probe opaque-probe"}, seen)
+	_, _, err := e.SealedRelay(context.Background(), "admin", nil)
+	require.Error(t, err)
+}
+
+func TestSealedMacRelayCapsResponse(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(strings.Repeat("x", sealedMaxResponse+10)))
+	}))
+	defer srv.Close()
+	e := NewSealedMacEngine("m", srv.URL, 0, lib.NewTestLogger())
+	_, _, err := e.SealedRelay(context.Background(), "attest", nil)
+	require.Error(t, err)
+}
