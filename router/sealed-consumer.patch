new file mode 100644
index 00000000..bbf7c996
--- /dev/null
+++ b/proxy-router/internal/sealed/modelv2.go
@@ -0,0 +1,55 @@
+package sealed
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// v2TokenizerFiles is the order the v2 engine hashes the tokenizer files in
+// (sealed-engine-v2 ModelPackage.swift, scripts/model-hash.py).
+var v2TokenizerFiles = []string{"tokenizer.json", "tokenizer_config.json", "chat_template.jinja", "config.json", "vocab.json"}
+
+const v2ManifestMagic = "sealed-manifest-v2"
+
+// ModelHashV2 computes the v2 model hash that a consumer pins for the sealed
+// Splash engine, from the package root and the child's CD hash:
+//
+//	manifest_hash  = SHA256(magic18 ‖ u32be(2) ‖ manifest[18:])
+//	tokenizer_hash = SHA256 over the five tokenizer files, each as
+//	                 name ‖ 0x00 ‖ u64be(len) ‖ bytes
+//	model_hash     = SHA256("morpheus-sealed/v2/splash-model" ‖
+//	                 manifest_hash ‖ tokenizer_hash ‖ child CD hash)
+func ModelHashV2(root string, childCDHash []byte) ([]byte, error) {
+	m, err := os.ReadFile(filepath.Join(root, "sealed-manifest.bin"))
+	if err != nil {
+		return nil, err
+	}
+	if len(m) < len(v2ManifestMagic) || !bytes.Equal(m[:len(v2ManifestMagic)], []byte(v2ManifestMagic)) {
+		return nil, fmt.Errorf("%w: sealed-manifest.bin is not a v2 manifest", ErrModelDir)
+	}
+	mh := sha256.New()
+	mh.Write(m[:len(v2ManifestMagic)])
+	_ = binary.Write(mh, binary.BigEndian, uint32(2))
+	mh.Write(m[len(v2ManifestMagic):])
+	th := sha256.New()
+	for _, name := range v2TokenizerFiles {
+		b, err := os.ReadFile(filepath.Join(root, "tokenizer", name))
+		if err != nil {
+			return nil, err
+		}
+		th.Write([]byte(name))
+		th.Write([]byte{0})
+		_ = binary.Write(th, binary.BigEndian, uint64(len(b)))
+		th.Write(b)
+	}
+	h := sha256.New()
+	h.Write([]byte("morpheus-sealed/v2/splash-model"))
+	h.Write(mh.Sum(nil))
+	h.Write(th.Sum(nil))
+	h.Write(childCDHash)
+	return h.Sum(nil), nil
+}
diff --git a/proxy-router/internal/sealed/modelv2_test.go b/proxy-router/internal/sealed/modelv2_test.go
