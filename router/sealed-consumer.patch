+		require.ErrorIs(t, err, ErrSealedNotConfigured)
+		tags.tags = []string{"llm"}                          // owner removes the tag
+		p.sealed.tagCache[model] = tagEntry{tags: tags.tags} // and the cache has expired/refreshed
+		_, err = p.sealedDecision(context.Background(), model)
+		require.ErrorIs(t, err, ErrSealedNotConfigured, "must not fall back to plaintext")
