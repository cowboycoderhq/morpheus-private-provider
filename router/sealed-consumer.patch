+func tamperAuthData(t *testing.T, attObj []byte) []byte {
+	var obj attestationObject
+	require.NoError(t, cbor.Unmarshal(attObj, &obj))
+	obj.AuthData = append([]byte{}, obj.AuthData...)
+	obj.AuthData[len(obj.AuthData)-1] ^= 0x01
+	b, err := cbor.Marshal(obj)
+	require.NoError(t, err)
+	return b
+}
+
+func dropIntermediate(t *testing.T, attObj []byte) []byte {
+	var obj attestationObject
+	require.NoError(t, cbor.Unmarshal(attObj, &obj))
+	obj.AttStmt.X5C = obj.AttStmt.X5C[:1]
+	b, err := cbor.Marshal(obj)
+	require.NoError(t, err)
+	return b
+}
+
+func hexString(b []byte) string {
+	const h = "0123456789abcdef"
+	out := make([]byte, len(b)*2)
+	for i, c := range b {
+		out[i*2], out[i*2+1] = h[c>>4], h[c&0xf]
+	}
+	return string(out)
+}
+
+func TestCompareVersions(t *testing.T) {
+	cmp := func(a, b string) int {
+		c, err := compareVersions(a, b)
+		require.NoError(t, err)
+		return c
+	}
+	require.Equal(t, 0, cmp("27.0", "27.0.0"))
+	require.Equal(t, -1, cmp("27.0", "27.0.1"))
+	require.Equal(t, 1, cmp("27.1", "27.0.9"))
+	require.Equal(t, -1, cmp("26.6.2", "27.0"))
+	for _, bad := range []string{"v27.1", "27.1b1", "27..1", "", "-1"} {
+		_, err := compareVersions(bad, "27.0")
+		require.Error(t, err, bad)
+	}
+}
