+		if err := writeFile(dir, junk, "x"); err != nil {
+			t.Fatalf("write %s: %v", junk, err)
+		}
+	}
+
+	got := cs.GetChats() // must not panic
+	if len(got) != 1 || got[0].ChatID != "chatGood" {
+		t.Errorf("expected only the real chat, got %+v", got)
+	}
+}
+
+// The binding must carry modelId. The renderer drops any chat row whose modelId
+// does not resolve to a known model, so a row persisted without one is invisible
+// in the drawer, claims nothing, and its paid session is handed to the next
+// unbound chat on that model — the exact theft the binding exists to prevent.
+func TestUpdateChatSessionPersistsModelIdSoTheRowIsUsable(t *testing.T) {
+	cs := NewChatStorage(t.TempDir())
+	if err := cs.UpdateChatSession("chatV", "0xsessV", "0xmodelReal"); err != nil {
+		t.Fatalf("bind: %v", err)
+	}
+	var row *struct{ ModelID, SessionID string }
+	for _, c := range cs.GetChats() {
+		if c.ChatID == "chatV" {
+			row = &struct{ ModelID, SessionID string }{c.ModelID, c.SessionID}
+		}
+	}
+	if row == nil {
+		t.Fatal("chat missing from GetChats")
+	}
+	if row.ModelID != "0xmodelReal" {
+		t.Errorf("ModelID = %q — the renderer will discard this row", row.ModelID)
+	}
+	if row.SessionID != "0xsessV" {
+		t.Errorf("SessionID = %q", row.SessionID)
+	}
+}
+
+// The chat LIST stays complete (it carries each chat's session binding) but
+// small: titles are capped, bodies are not kept, and an unchanged file is not
+// read again.
+func TestGetChatsSummariesAreSmallCompleteAndCached(t *testing.T) {
+	dir := t.TempDir()
+	long := strings.Repeat("an agent's whole first prompt ", 400)
+	write := func(id, body string) {
+		if err := os.WriteFile(filepath.Join(dir, id+".json"), []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("0xaa", `{"title":`+strconv.Quote(long)+`,"modelId":"0xm1","sessionId":"0xs1","messages":[{"promptAt":111,"prompt":{"messages":[{"role":"user","content":"`+strings.Repeat("x", 100000)+`"}]}}]}`)
+	write("0xbb", `{"title":"short","modelId":"0xm2","isLocal":true,"messages":[]}`)
+	write("0xcc", `not json`)
+	write("x", `{}`) // not a chat file name
+	os.WriteFile(filepath.Join(dir, "README"), []byte("stray"), 0o644)
+
+	cs := NewChatStorage(dir)
+	chats := cs.GetChats()
+	byID := map[string]gcs.Chat{}
+	for _, c := range chats {
+		byID[c.ChatID] = c
+	}
+	if len(byID) != 3 { // 0xaa, 0xbb, x ({} is a valid empty chat)
+		t.Fatalf("got %d chats: %+v", len(byID), byID)
+	}
+	a := byID["0xaa"]
+	if utf8.RuneCountInString(a.Title) != ListTitleMaxRunes || !strings.HasSuffix(a.Title, "…") {
+		t.Fatalf("title not capped: %d runes", utf8.RuneCountInString(a.Title))
+	}
+	if a.SessionID != "0xs1" || a.ModelID != "0xm1" || a.CreatedAt != 111 {
+		t.Fatalf("summary lost fields: %+v", a)
+	}
+	if b := byID["0xbb"]; b.Title != "short" || !b.IsLocal || b.CreatedAt != 0 {
+		t.Fatalf("short chat: %+v", b)
+	}
+
+	// Unchanged file: served from the cache (make the file unreadable to prove it).
+	os.Chmod(filepath.Join(dir, "0xbb.json"), 0o000)
+	defer os.Chmod(filepath.Join(dir, "0xbb.json"), 0o644)
+	if c := findChat(cs.GetChats(), "0xbb"); c == nil || c.Title != "short" {
+		t.Fatal("an unchanged chat was not served from the cache")
+	}
+	os.Chmod(filepath.Join(dir, "0xbb.json"), 0o644)
+
+	// Changed file: read again. Deleted file: gone.
+	time.Sleep(10 * time.Millisecond)
+	write("0xbb", `{"title":"renamed","modelId":"0xm2","isLocal":true,"sessionId":"0xs2","messages":[]}`)
+	os.Remove(filepath.Join(dir, "0xaa.json"))
+	chats = cs.GetChats()
+	if c := findChat(chats, "0xbb"); c == nil || c.Title != "renamed" || c.SessionID != "0xs2" {
+		t.Fatalf("changed chat not refreshed: %+v", c)
+	}
+	if findChat(chats, "0xaa") != nil {
+		t.Fatal("a deleted chat is still listed")
+	}
+}
+
+func findChat(chats []gcs.Chat, id string) *gcs.Chat {
+	for i := range chats {
+		if chats[i].ChatID == id {
+			return &chats[i]
+		}
+	}
+	return nil
+}
