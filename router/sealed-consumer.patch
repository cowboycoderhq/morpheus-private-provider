+// The body is never parsed or logged here.
+func (s *MORRPCController) sealedRelay(ctx context.Context, msg m.RPCMessage, sendResponse SendResponse, sourceLog lib.ILogger) error {
+	var req m.SealedRelayReq
+	if err := json.Unmarshal(msg.Params, &req); err != nil {
+		return lib.WrapError(ErrUnmarshal, err)
+	}
+	if err := s.validator.Struct(req); err != nil {
+		return lib.WrapError(ErrValidation, err)
+	}
+	sourceLog = sourceLog.With("session_id", req.SessionID.Hex(), "sealed_op", req.Op)
+	if len(req.Body) > maxSealedRelayBody {
+		return lib.WrapError(ErrValidation, fmt.Errorf("sealed relay body too large"))
+	}
