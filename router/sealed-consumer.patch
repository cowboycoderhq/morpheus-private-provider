+		forged := &Attestation{KeyID: att.KeyID, PublicKey: att.PublicKey, Extensions: att.Extensions}
+		_, err := VerifyAssertion(cfg, forged, f.assertObj, f.assertCDH, 0)
+		require.ErrorIs(t, err, ErrFormat)
+	})
+	t.Run("nil attestation", func(t *testing.T) {
+		_, err := VerifyAssertion(cfg, nil, f.assertObj, f.assertCDH, 0)
+		require.ErrorIs(t, err, ErrFormat)
+	})
+	t.Run("missing challenge", func(t *testing.T) {
+		_, err := VerifyAssertion(cfg, att, f.assertObj, nil, 0)
+		require.ErrorIs(t, err, ErrFormat)
+	})
+}
