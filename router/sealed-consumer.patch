+// TestSendPromptV2RoutesSealedModels proves the routing hook: a tee-apple
+// prompt must go to the sealed relay (never the plaintext path), must be
+// refused without configuration, and ordinary models must not be diverted.
+func TestSendPromptV2RoutesSealedModels(t *testing.T) {
+	log := lib.NewTestLogger()
+	ss := storages.NewSessionStorage(storages.NewTestStorage())
+	sid := common.HexToHash("0xabc1")
+	provider := common.HexToAddress("0x00000000000000000000000000000000000000b0")
+	require.NoError(t, ss.AddUser(&storages.User{Addr: provider.Hex(), PubKey: "0x00", Url: "127.0.0.1:1"}))
+	require.NoError(t, ss.AddSession(&storages.Session{
+		Id: sid.Hex(), UserAddr: common.Address{}.Hex(), ProviderAddr: provider.Hex(),
+		EndsAt: big.NewInt(time.Now().Add(time.Hour).Unix()), ModelID: common.HexToHash("0x0a").Hex(),
+	}))
+	repo := sessionrepo.NewSessionRepositoryCached(ss, nil, nil, log)
+	prompt := &gcs.OpenAICompletionRequestExtra{ChatCompletionRequest: openai.ChatCompletionRequest{
+		Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "CANARY"}},
+	}}
+	cb := func(context.Context, gcs.Chunk, *gcs.AiEngineErrorResponse) error { return nil }
+	errRelayStub := errors.New("relay stub")
+
+	newSender := func(cfg *SealedConfig, tags []string) (*ProxyServiceSender, *[]string) {
+		p := NewProxySender(big.NewInt(1), noKey{}, nil, ss, repo, time.Second, 0, 0, log)
+		p.SetSealed(cfg, &fakeTags{tags: tags})
+		var ops []string
+		p.sealed.relay = func(_ context.Context, _ common.Hash, _ *storages.User, op string, _ []byte) (int, []byte, error) {
+			ops = append(ops, op)
+			return 0, nil, errRelayStub
+		}
+		return p, &ops
+	}
+
+	pin := &SealedConfig{Models: map[common.Hash][][]byte{common.HexToHash("0x0a"): {make([]byte, 32)}}}
+	other := &SealedConfig{Models: map[common.Hash][][]byte{common.HexToHash("0x0b"): {make([]byte, 32)}}}
+	p, ops := newSender(pin, []string{"tee-apple"})
+	_, err := p.SendPromptV2(context.Background(), sid, prompt, cb)
+	require.ErrorIs(t, err, errRelayStub, "sealed model must take the sealed relay")
+	require.Equal(t, []string{"attest"}, *ops)
+
+	p, ops = newSender(nil, []string{"tee-apple"})
+	_, err = p.SendPromptV2(context.Background(), sid, prompt, cb)
+	require.ErrorIs(t, err, ErrSealedNotConfigured)
+	require.Empty(t, *ops)
+
+	p, ops = newSender(pin, []string{"llm"}) // owner removed the tag; the pin still seals it
+	_, err = p.SendPromptV2(context.Background(), sid, prompt, cb)
+	require.ErrorIs(t, err, errRelayStub, "pinned model stays sealed without its tag")
+	require.Equal(t, []string{"attest"}, *ops)
+
+	p, ops = newSender(pin, []string{"tee-apple"})
+	_, err = p.SendEmbeddings(context.Background(), sid, &gcs.EmbeddingsRequest{}, cb)
+	require.ErrorIs(t, err, ErrSealedRequestType, "embeddings on a sealed model must be refused before the plaintext path")
+	require.Empty(t, *ops)
+
+	p, ops = newSender(pin, []string{"tee-apple"})
+	_, err = p.SendAudioSpeech(context.Background(), sid, &gcs.AudioSpeechRequest{}, cb)
+	require.ErrorIs(t, err, ErrSealedRequestType)
+	_, err = p.SendAudioTranscriptionV2(context.Background(), sid, &gcs.AudioTranscriptionRequest{}, cb)
+	require.ErrorIs(t, err, ErrSealedRequestType)
+	_, err = p.CallAgentTool(context.Background(), sid, "tool", map[string]interface{}{"q": "CANARY"})
+	require.ErrorIs(t, err, ErrSealedRequestType)
+	// GetAgentTools reads the local key first (no network), so give it one.
+	withKey := NewProxySender(big.NewInt(1), testKey{}, nil, ss, repo, time.Second, 0, 0, log)
+	withKey.SetSealed(pin, &fakeTags{tags: []string{"tee-apple"}})
+	_, err = withKey.GetAgentTools(context.Background(), sid)
+	require.ErrorIs(t, err, ErrSealedRequestType)
+	require.Empty(t, *ops)
+
+	unwired := NewProxySender(big.NewInt(1), noKey{}, nil, ss, repo, time.Second, 0, 0, log)
+	_, err = unwired.SendPromptV2(context.Background(), sid, prompt, cb)
+	require.ErrorIs(t, err, ErrSealedLaneUnwired, "an unwired binary must refuse, not send plaintext")
+
+	p, ops = newSender(other, []string{"llm"})
+	_, err = p.SendPromptV2(context.Background(), sid, prompt, cb)
+	require.ErrorIs(t, err, ErrMissingPrKey, "ordinary model takes the plaintext path (stopped here by the stub key)")
+	require.Empty(t, *ops, "ordinary models must not be diverted to the sealed relay")
+}
