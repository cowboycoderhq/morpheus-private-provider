+	"github.com/stretchr/testify/require"
+)
+
+func newTestController(t *testing.T) (*MORRPCController, *storages.SessionStorage) {
+	t.Helper()
+	ss := storages.NewSessionStorage(storages.NewTestStorage())
+	c := &MORRPCController{sessionStorage: ss}
+	return c, ss
+}
+
+func TestSessionUserPubKeyAcceptsMatchingRecord(t *testing.T) {
+	c, ss := newTestController(t)
+
+	key, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	pub := crypto.FromECDSAPub(key.Public().(*ecdsa.PublicKey))
+	addr := crypto.PubkeyToAddress(key.PublicKey)
+
+	require.NoError(t, ss.AddUser(&storages.User{Addr: addr.Hex(), PubKey: lib.HexString(pub).Hex()}))
+
+	user, pubHex, err := c.sessionUserPubKey(addr)
+	require.NoError(t, err)
+	require.NotNil(t, user)
+	require.Equal(t, lib.HexString(pub).Hex(), pubHex.Hex())
+}
+
+func TestSessionUserPubKeyRejectsMismatchedRecord(t *testing.T) {
+	c, ss := newTestController(t)
+
+	victim, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	victimAddr := crypto.PubkeyToAddress(victim.PublicKey)
+
+	other, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	otherPub := crypto.FromECDSAPub(other.Public().(*ecdsa.PublicKey))
+
+	// a stale record where the stored key does not derive to the address
+	require.NoError(t, ss.AddUser(&storages.User{Addr: victimAddr.Hex(), PubKey: lib.HexString(otherPub).Hex()}))
+
+	_, _, err = c.sessionUserPubKey(victimAddr)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "does not match")
+}
+
+type fakeAuthResolver struct {
+	signers map[common.Address]common.Address
+	err     error
+}
+
+func (f fakeAuthResolver) AuthorizedSigner(_ context.Context, provider common.Address) (common.Address, error) {
+	if f.err != nil {
+		return common.Address{}, f.err
+	}
+	if s, ok := f.signers[provider]; ok {
+		return s, nil
+	}
+	return provider, nil // EOA signs as itself
+}
+
+func TestServesProvider(t *testing.T) {
+	me := common.HexToAddress("0x1111111111111111111111111111111111111111")
+	contract := common.HexToAddress("0xc0dec0dec0dec0dec0dec0dec0dec0dec0dec0de")
+	other := common.HexToAddress("0x2222222222222222222222222222222222222222")
+	ctx := context.Background()
+
+	// no resolver: only sessions opened directly against my address
+	c := &MORRPCController{providerAddr: me}
+	require.True(t, c.servesProvider(ctx, me))
+	require.False(t, c.servesProvider(ctx, contract))
+	require.False(t, c.servesProvider(ctx, other))
+
+	// resolver: contract whose owner() is me is served; foreign EOA/contract is not
+	c.SetProviderAuthResolver(fakeAuthResolver{signers: map[common.Address]common.Address{
+		contract: me,
+		other:    other,
+	}})
+	require.True(t, c.servesProvider(ctx, me))
+	require.True(t, c.servesProvider(ctx, contract))
+	require.False(t, c.servesProvider(ctx, other))
+
+	// resolver error fails closed for anything that is not my own address
+	c.SetProviderAuthResolver(fakeAuthResolver{err: errors.New("rpc down")})
+	require.True(t, c.servesProvider(ctx, me))
+	require.False(t, c.servesProvider(ctx, contract))
+
+	// unknown node key fails closed everywhere
+	z := &MORRPCController{}
+	z.SetProviderAuthResolver(fakeAuthResolver{signers: map[common.Address]common.Address{contract: common.Address{}}})
+	require.False(t, z.servesProvider(ctx, common.Address{}))
+	require.False(t, z.servesProvider(ctx, contract))
+}
+
+func TestSessionUserPubKeyMissingUser(t *testing.T) {
+	c, _ := newTestController(t)
+	key, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	_, _, err = c.sessionUserPubKey(crypto.PubkeyToAddress(key.PublicKey))
+	require.Error(t, err)
+}
+
+// newReportTestController wires enough of the controller to run sessionReport
+// end-to-end: a provider key, a bound user record, and a cached session owned
+// by that user on this provider.
+func newReportTestController(t *testing.T, endsAt *big.Int) (*MORRPCController, *ecdsa.PrivateKey, common.Hash) {
+	t.Helper()
+
+	providerKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	providerPrKey := lib.HexString(crypto.FromECDSA(providerKey))
+	providerPub := lib.HexString(crypto.FromECDSAPub(&providerKey.PublicKey))
+	providerAddr := crypto.PubkeyToAddress(providerKey.PublicKey)
+
+	userKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	userPub := lib.HexString(crypto.FromECDSAPub(&userKey.PublicKey))
+	userAddr := crypto.PubkeyToAddress(userKey.PublicKey)
+
+	ss := storages.NewSessionStorage(storages.NewTestStorage())
+	require.NoError(t, ss.AddUserBound(&storages.User{Addr: userAddr.Hex(), PubKey: userPub.Hex()}))
+
+	sessionID := common.HexToHash("0xabcd1234567890abcdef1234567890abcdef1234567890abcdef1234567890ab")
+	require.NoError(t, ss.AddSession(&storages.Session{
+		Id:           sessionID.Hex(),
+		UserAddr:     userAddr.Hex(),
+		ProviderAddr: providerAddr.Hex(),
+		EndsAt:       endsAt,
+	}))
+
+	valid, err := config.NewValidator()
+	require.NoError(t, err)
+	receiver := NewProxyReceiver(providerPrKey, providerPub, ss, nil, big.NewInt(1), nil, nil, nil)
+	c := NewMORRPCController(receiver, valid, nil, ss, providerPrKey, nil)
+	return c, userKey, sessionID
+}
+
+func runSessionReport(t *testing.T, c *MORRPCController, userKey *ecdsa.PrivateKey, sessionID common.Hash) (*msg.RpcResponse, error) {
+	t.Helper()
+	req, err := c.morRpc.SessionReportRequest(sessionID, lib.HexString(crypto.FromECDSA(userKey)), "req-1")
+	require.NoError(t, err)
+
+	var got *msg.RpcResponse
+	send := func(r *msg.RpcResponse) error { got = r; return nil }
+	err = c.sessionReport(context.Background(), *req, send, lib.NewTestLogger())
+	return got, err
+}
+
+// A session that has already passed EndsAt must still yield a provider-signed
+// report: the consumer closes after expiry and a refused report becomes an
+// on-chain dispute against the provider.
+func TestSessionReportServedAfterExpiry(t *testing.T) {
+	expired := big.NewInt(time.Now().Add(-2 * time.Hour).Unix())
+	c, userKey, sessionID := newReportTestController(t, expired)
+
+	got, err := runSessionReport(t, c, userKey, sessionID)
+	require.NoError(t, err)
+	require.NotNil(t, got)
+	require.NotNil(t, got.Result)
+}
+
+// The binding checks still gate the report: a signer whose key is not the
+// session user's bound key is refused even for a live session.
+func TestSessionReportRejectsForeignSigner(t *testing.T) {
+	live := big.NewInt(time.Now().Add(2 * time.Hour).Unix())
+	c, _, sessionID := newReportTestController(t, live)
+
+	otherKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+
+	_, err = runSessionReport(t, c, otherKey, sessionID)
+	require.Error(t, err)
+}
