+
+func TestParseExtensions(t *testing.T) {
+	cd := sha256.Sum256([]byte("code"))
+	b, err := cbor.Marshal(map[string][]byte{
+		ExtCDHash: cd[:], ExtCDHashType: {CDHashTypeSHA256}, ExtValidationCategory: {3, 0, 0, 0},
+	})
+	require.NoError(t, err)
+	ext, err := parseExtensions(b)
+	require.NoError(t, err)
+	require.Equal(t, cd[:], ext.CDHash)
+	require.Equal(t, byte(CDHashTypeSHA256), ext.CDHashType)
+	require.Equal(t, uint32(3), ext.ValidationCategory)
+}
+
+func TestParseExtensionsStrictCBOR(t *testing.T) {
+	// {"apple_cd_hash_hash_01": h'01', "apple_cd_hash_hash_01": h'02'} — duplicate key.
+	key := []byte(ExtCDHash)
+	dup := []byte{0xa2}
+	for _, v := range []byte{1, 2} {
+		dup = append(dup, 0x60|byte(len(key)))
+		dup = append(dup, key...)
+		dup = append(dup, 0x41, v)
+	}
+	_, err := parseExtensions(dup)
+	require.ErrorIs(t, err, ErrFormat, "duplicate map keys must be rejected")
+
+	indef := []byte{0xbf, 0x60 | byte(len(key))}
+	indef = append(indef, key...)
+	indef = append(indef, 0x41, 1, 0xff)
+	_, err = parseExtensions(indef)
+	require.ErrorIs(t, err, ErrFormat, "indefinite-length maps must be rejected")
+
+	b, err := cbor.Marshal(map[string]interface{}{"future_int_ext": 7, ExtValidationCategory: []byte{3, 0, 0, 0}})
+	require.NoError(t, err)
+	ext, err := parseExtensions(b)
+	require.NoError(t, err, "unknown non-bytes extensions are tolerated")
+	require.Equal(t, uint32(3), ext.ValidationCategory)
+
+	b, err = cbor.Marshal(map[string]interface{}{ExtCDHash: 7})
+	require.NoError(t, err)
+	_, err = parseExtensions(b)
+	require.ErrorIs(t, err, ErrFormat, "known keys must be byte strings")
+}
+
+func TestConfigFailsClosed(t *testing.T) {
