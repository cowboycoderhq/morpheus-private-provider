+func TestSealedChannelHousekeeping(t *testing.T) {
+	st := &sealedState{channels: map[common.Hash]*sealedChannel{}}
+	old := &sealedChannel{created: time.Now().Add(-2 * sealedChannelTTL)}
+	st.channels[common.HexToHash("0x01")] = old
+	st.storeChannel(common.HexToHash("0x02"), &sealedChannel{created: time.Now()})
+	require.NotContains(t, st.channels, common.HexToHash("0x01"), "expired channel evicted")
+
+	for i := 0; i < sealedMaxChannels+5; i++ {
+		st.storeChannel(common.BigToHash(big.NewInt(int64(1000+i))), &sealedChannel{created: time.Now().Add(time.Duration(i) * time.Millisecond)})
+	}
+	require.LessOrEqual(t, len(st.channels), sealedMaxChannels, "cap enforced")
+	require.Contains(t, st.channels, common.BigToHash(big.NewInt(int64(1000+sealedMaxChannels+4))), "newest kept")
+
+	// An expired channel is never reused: the next prompt re-attests.
+	p := &ProxyServiceSender{}
+	p.SetSealed(&SealedConfig{Models: map[common.Hash][][]byte{{}: {make([]byte, 32)}}}, &fakeTags{})
+	var ops []string
+	p.sealed.relay = func(_ context.Context, _ common.Hash, _ *storages.User, op string, _ []byte) (int, []byte, error) {
+		ops = append(ops, op)
+		return 0, nil, errors.New("stub")
+	}
+	p.sealed.channels[common.HexToHash("0x09")] = &sealedChannel{created: time.Now().Add(-2 * sealedChannelTTL)}
+	_, err := p.sealedChannelFor(context.Background(), common.HexToHash("0x09"), common.Hash{}, &storages.User{})
+	require.Error(t, err)
+	require.Equal(t, []string{"attest"}, ops)
