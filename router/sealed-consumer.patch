+// SealedRelay forwards an opaque sealed-protocol body to the session model's
+// sealed engine and returns the engine's status and body, provider-signed.
+func (s *ProxyReceiver) SealedRelay(ctx context.Context, msgID string, req *m.SealedRelayReq, sourceLog lib.ILogger) (*msg.RpcResponse, error) {
+	session, err := s.sessionRepo.GetSession(ctx, req.SessionID)
+	if err != nil {
+		return nil, lib.WrapError(fmt.Errorf("failed to get session"), err)
+	}
+	adapter, err := s.aiEngine.GetAdapter(ctx, common.Hash{}, session.ModelID(), common.Hash{}, false, false)
+	if err != nil {
+		return nil, lib.WrapError(fmt.Errorf("failed to get adapter"), err)
+	}
+	relayer, ok := adapter.(aiengine.SealedRelayer)
+	if !ok {
+		return nil, fmt.Errorf("model %s is not a sealed-mac model", session.ModelID().Hex())
+	}
+	body, err := base64.StdEncoding.DecodeString(req.Body)
+	if err != nil {
+		return nil, lib.WrapError(ErrUnmarshal, err)
+	}
+	status, out, err := relayer.SealedRelay(ctx, req.Op, body)
+	if err != nil {
+		return nil, err
+	}
+	sourceLog.Debugf("sealed relay %s: engine status %d, %d bytes", req.Op, status, len(out))
+	return s.morRpc.SealedRelayResponse(status, out, s.privateKeyHex, msgID)
+}
+
+// SealedProbe relays a public attest/probe request to a sealed-mac model's engine.
+func (s *ProxyReceiver) SealedProbe(ctx context.Context, msgID string, req *m.SealedProbeReq, sourceLog lib.ILogger) (*msg.RpcResponse, error) {
+	if req.Op != "attest" && req.Op != "probe" {
+		return nil, fmt.Errorf("sealed probe: op %q not allowed", req.Op)
+	}
+	adapter, err := s.aiEngine.GetAdapter(ctx, common.Hash{}, req.ModelID, common.Hash{}, false, false)
+	if err != nil {
+		return nil, lib.WrapError(fmt.Errorf("unknown model"), err)
+	}
+	relayer, ok := adapter.(aiengine.SealedRelayer)
+	if !ok {
+		return nil, fmt.Errorf("model %s is not a sealed-mac model", req.ModelID.Hex())
+	}
+	body, err := base64.StdEncoding.DecodeString(req.Body)
+	if err != nil {
+		return nil, lib.WrapError(ErrUnmarshal, err)
+	}
+	status, out, err := relayer.SealedRelay(ctx, req.Op, body)
+	if err != nil {
+		return nil, err
+	}
+	sourceLog.Debugf("sealed probe %s: engine status %d", req.Op, status)
+	return s.morRpc.SealedRelayResponse(status, out, s.privateKeyHex, msgID)
+}
