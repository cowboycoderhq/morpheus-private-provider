+	if !shouldRetryRPCError(rpc.HTTPError{StatusCode: 404, Status: "404 Not Found"}) {
+		t.Fatal("404 must rotate to the next endpoint")
+	}
+	if shouldRetryRPCError(rpc.HTTPError{StatusCode: 400, Status: "400 Bad Request"}) {
+		t.Fatal("400 is the request's fault; another endpoint will not help")
+	}
