diff --git a/proxy-router/cmd/sealed-chat/main.go b/proxy-router/cmd/sealed-chat/main.go
new file mode 100644
index 00000000..55be7e29
--- /dev/null
+++ b/proxy-router/cmd/sealed-chat/main.go
@@ -0,0 +1,187 @@
+// sealed-chat is a consumer for a sealed engine: it verifies the engine
+// exactly as a consumer node does (Apple App Attest chain, app ID, the
+// running binary's CD hash against the published list, the session
+// assertion over challenge ‖ client key ‖ engine key ‖ model hash), then
+// sends ONE prompt sealed to that session and prints the opened reply.
+// The prompt leaves this process only as envelope ciphertext.
+//
+//	sealed-chat --engine http://127.0.0.1:29452 --app-id TEAM.bundle --cdhash <hex> \
+//	            --weights <hex> [--env development] [--prompt "..."] [--max-tokens 64]
+package main
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/attestation/appleattest"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/sealed"
+)
+
+func main() {
+	engine := flag.String("engine", "http://127.0.0.1:29452", "engine base URL")
+	appID := flag.String("app-id", "", "published engine app ID <TeamID>.<BundleID>")
+	cdhash := flag.String("cdhash", "", "published engine CD hash (hex)")
+	weights := flag.String("weights", "", "published model hash (hex)")
+	env := flag.String("env", "production", "App Attest environment: production | development")
+	prompt := flag.String("prompt", "Name the capital of France in one word.", "user message")
+	maxTokens := flag.Int("max-tokens", 64, "max output tokens")
+	thinking := flag.String("thinking", "off", "chat template enable_thinking: on | off | default")
+	inspect := flag.Bool("inspect-attestation", false, "diagnostic: accept any code identity, print the attestation extensions, and stop")
+	noCode := flag.Bool("unverified-code-identity", false, "DIAGNOSTIC ONLY: accept any binary of the app ID (when the attestation carries no CD hash); the run is then NOT a code-identity check")
+	replyFile := flag.String("reply-file", "", "also write the opened reply bytes to this file (for byte-exact checks)")
+	temperature := flag.Float64("temperature", 0, "sampling temperature sent in the sealed request (0 = greedy)")
+	flag.Parse()
+	pin, err1 := hex.DecodeString(*cdhash)
+	w, err2 := hex.DecodeString(*weights)
+	if *appID == "" || err1 != nil || len(pin) != 32 || err2 != nil || len(w) != 32 {
+		fmt.Fprintln(os.Stderr, "need --app-id, --cdhash (64 hex, the full SHA-256 CD hash) and --weights (64 hex)")
+		os.Exit(64)
+	}
+	cfg := appleattest.Config{AppID: *appID, ExpectedCDHashes: [][]byte{pin}}
+	if *inspect || *noCode {
+		cfg = appleattest.Config{AppID: *appID, AllowAnyCode: true}
+	}
+	if *noCode {
+		fmt.Println("WARN code identity NOT verified: --unverified-code-identity accepts any binary signed for this app ID")
+	}
+	if *env == "development" {
+		cfg.Environment = appleattest.Development
+	}
+	client := &http.Client{Timeout: 400 * time.Second}
+	call := func(method, path string, body any) (int, map[string]any) {
+		var rdr io.Reader = bytes.NewReader(nil)
+		if body != nil {
+			b, _ := json.Marshal(body)
+			rdr = bytes.NewReader(b)
+		}
+		req, _ := http.NewRequest(method, *engine+path, rdr)
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := client.Do(req)
+		if err != nil {
+			fail("reach engine", err)
+		}
+		defer resp.Body.Close()
+		var out map[string]any
+		_ = json.NewDecoder(resp.Body).Decode(&out)
+		return resp.StatusCode, out
+	}
+	b64 := func(v any) []byte {
+		s, _ := v.(string)
+		b, err := base64.StdEncoding.DecodeString(s)
+		if err != nil {
+			fail("decode", err)
+		}
+		return b
+	}
+
+	status, att := call("GET", "/attest", nil)
+	if status != 200 {
+		fail("attest", fmt.Errorf("status %d", status))
+	}
+	attCDH := sha256.Sum256(b64(att["clientData"]))
+	verified, err := appleattest.VerifyAttestation(cfg, b64(att["attestation"]), b64(att["keyId"]), attCDH[:])
+	if err != nil {
+		fail("apple chain", err)
+	}
+	if *inspect {
+		for k, v := range verified.Extensions.Raw {
+			fmt.Printf("extension %s = %x\n", k, v)
+		}
+		fmt.Printf("OS %+v\n", verified.OS)
+		ch := make([]byte, 32)
+		_, _ = rand.Read(ch)
+		st, pr := call("POST", "/probe", map[string]string{"challenge": base64.StdEncoding.EncodeToString(ch)})
+		if st != 200 {
+			fail("probe", fmt.Errorf("status %d", st))
+		}
+		rep, err := sealed.VerifyProbe(cfg, verified, ch, b64(pr["clientData"]), b64(pr["assertion"]), "", nil)
+		if err != nil {
+			fail("probe assertion", err)
+		}
+		fmt.Printf("assertion: CD hash %x counter %d weights %x\n", rep.CDHash, rep.Counter, rep.WeightsHash)
+		return
+	}
+	fmt.Printf("PASS apple chain: App Attest certificate chain ends at Apple's root; app %s; environment %s; OS %s %s\n", *appID, *env, verified.OS.Version, verified.OS.Build)
+
+	key, err := sealed.NewClientKey()
+	if err != nil {
+		fail("client key", err)
+	}
+	ch := make([]byte, 32)
+	_, _ = rand.Read(ch)
+	status, out := call("POST", "/session", map[string]string{
+		"challenge": base64.StdEncoding.EncodeToString(ch),
+		"clientPub": base64.StdEncoding.EncodeToString(key.Public()),
+	})
+	if status != 200 {
+		fail("session", fmt.Errorf("status %d: %v", status, out))
+	}
+	h := sealed.Handshake{SessionID: out["sessionId"].(string), Challenge: ch, Key: key,
+		ClientData: b64(out["clientData"]), Assertion: b64(out["assertion"])}
+	cs, counter, err := sealed.Establish(cfg, verified, h, [][]byte{w})
+	if err != nil {
+		fail("session binding", err)
+	}
+	ident := "CD hash " + *cdhash + " matches the pinned hash"
+	if *noCode {
+		ident = "CD hash NOT checked"
+	}
+	fmt.Printf("PASS session: assertion (counter %d) by the attested key over our challenge, our key, the engine key and model hash %s; %s\n", counter, *weights, ident)
+
+	req := map[string]any{"messages": []map[string]string{{"role": "user", "content": *prompt}}, "max_tokens": *maxTokens, "temperature": *temperature}
+	switch *thinking {
+	case "on":
+		req["enable_thinking"] = true
+	case "off":
+		req["enable_thinking"] = false
+	}
+	pt, _ := json.Marshal(req)
+	f, err := cs.Seal(pt)
+	if err != nil {
+		fail("seal", err)
+	}
+	fmt.Printf("SENT %d ciphertext bytes (prompt is %d plaintext bytes; plaintext never leaves this process)\n", len(f.Ciphertext), len(pt))
+	start := time.Now()
+	status, out = call("POST", "/infer", f)
+	if status != 200 {
+		fail("infer", fmt.Errorf("status %d: %v", status, out))
+	}
+	var frames []sealed.Frame
+	raw, _ := json.Marshal(out["frames"])
+	_ = json.Unmarshal(raw, &frames)
+	chunks, err := cs.OpenResponse(frames)
+	if err != nil {
+		fail("open reply", err)
+	}
+	var answer strings.Builder
+	for _, c := range chunks {
+		answer.Write(c)
+	}
+	sizes := make([]string, len(frames))
+	for i, fr := range frames {
+		sizes[i] = fmt.Sprint(len(fr.Ciphertext))
+	}
+	fmt.Printf("FRAMES ciphertext bytes: %s\n", strings.Join(sizes, ","))
+	fmt.Printf("REPLY (%d sealed frames, %.1f s): %q\n", len(frames), time.Since(start).Seconds(), answer.String())
+	if *replyFile != "" {
+		if err := os.WriteFile(*replyFile, []byte(answer.String()), 0o600); err != nil {
+			fail("write reply file", err)
+		}
+	}
+}
+
+func fail(step string, err error) {
+	fmt.Printf("FAIL %s: %v\n", step, err)
+	os.Exit(1)
+}
diff --git a/proxy-router/cmd/sealed-verify/main.go b/proxy-router/cmd/sealed-verify/main.go
new file mode 100644
index 00000000..4c0a45bb
--- /dev/null
+++ b/proxy-router/cmd/sealed-verify/main.go
@@ -0,0 +1,437 @@
+// sealed-verify lets anyone check, from their own machine and without trusting
+// the provider, that a provider's model is served by a published sealed engine
+// on a Mac booted in Full Security. It runs the same checks a consumer node
+// runs before sending a prompt.
+//
+//	sealed-verify --provider host:port --model 0x… --provider-addr 0x… --app-id TEAM.bundle --cdhash <hex>[,<hex>] [--min-os 27.0] [--weights <hex>,…]
+//	sealed-verify --engine http://127.0.0.1:29451 …   (direct, on the engine's own host)
+//	sealed-verify rebuild --published <signed .app> --rebuild <verify-mode .app> --app-id TEAM.bundle [--cdhash <hex>]
+//
+// The rebuild mode ties a published engine to its source: rebuild the engine
+// with sealed-engine/scripts/build-reproducible.sh verify, then compare. It
+// prints the CD hash App Attest reports for the published app.
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/attestation/appleattest"
+	msgs "github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/proxyapi/morrpcmessage"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/sealed"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/sealed/codesig"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+const maxReply = 4 << 20
+
+type transport func(op string, body []byte) (int, []byte, error)
+
+type options struct {
+	cfg            appleattest.Config
+	providerAddr   string
+	allowedWeights [][]byte
+}
+
+func main() {
+	if len(os.Args) > 1 && os.Args[1] == "rebuild" {
+		os.Exit(rebuildMain(os.Args[2:], os.Stdout, os.Stderr))
+	}
+	provider := flag.String("provider", "", "provider MOR-RPC endpoint host:port (public)")
+	model := flag.String("model", "", "model ID (hex) served by the provider")
+	providerAddr := flag.String("provider-addr", "", "provider's on-chain address; the engine must be bound to it (required with --provider)")
+	engine := flag.String("engine", "", "engine base URL, e.g. http://127.0.0.1:29451 (direct mode)")
+	appID := flag.String("app-id", "", "published engine app ID <TeamID>.<BundleID>")
+	cdhashes := flag.String("cdhash", "", "comma-separated published CD hashes (hex)")
+	weights := flag.String("weights", "", "comma-separated allowed weights hashes (hex); omitted = weights check SKIPPED")
+	minOS := flag.String("min-os", "", "minimum macOS version, e.g. 27.0.1")
+	env := flag.String("env", "production", "App Attest environment: production | development")
+	asJSON := flag.Bool("json", false, "print the report as JSON")
+	hashModel := flag.String("hash-model", "", "print the weights manifest hash of a local model directory and exit")
+	hashModelV2 := flag.String("hash-model-v2", "", "print the v2 (sealed Splash) model hash of a package root and exit; needs --child-cdhash")
+	childCD := flag.String("child-cdhash", "", "child CD hash (hex) for --hash-model-v2")
+	flag.Parse()
+
+	if *hashModelV2 != "" {
+		c, err := hex.DecodeString(*childCD)
+		if err != nil || len(c) == 0 {
+			fmt.Fprintf(os.Stderr, "sealed-verify: --hash-model-v2 needs --child-cdhash <hex>\n")
+			os.Exit(2)
+		}
+		h, err := sealed.ModelHashV2(*hashModelV2, c)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "sealed-verify: %v\n", err)
+			os.Exit(2)
+		}
+		fmt.Println(hex.EncodeToString(h))
+		return
+	}
+
+	if *hashModel != "" {
+		h, err := sealed.WeightsManifestHash(*hashModel)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "sealed-verify: %v\n", err)
+			os.Exit(2)
+		}
+		fmt.Println(hex.EncodeToString(h))
+		return
+	}
+
+	fail := func(msg string, args ...any) {
+		fmt.Fprintf(os.Stderr, "sealed-verify: "+msg+"\n", args...)
+		os.Exit(2)
+	}
+	if *appID == "" || *cdhashes == "" {
+		fail("--app-id and --cdhash are required")
+	}
+	pinned, err := parseHashes(*cdhashes)
+	if err != nil {
+		fail("--cdhash: %v", err)
+	}
+	allowed, err := parseHashes(*weights)
+	if err != nil {
+		fail("--weights: %v", err)
+	}
+	o := options{
+		cfg:            appleattest.Config{AppID: *appID, ExpectedCDHashes: pinned, MinOSVersion: *minOS},
+		providerAddr:   *providerAddr,
+		allowedWeights: allowed,
+	}
+	switch *env {
+	case "production":
+	case "development":
+		o.cfg.Environment = appleattest.Development
+	default:
+		fail("--env must be production or development")
+	}
+
+	var send transport
+	var target string
+	switch {
+	case *engine != "":
+		send, target = engineTransport(strings.TrimRight(*engine, "/")), *engine
+	case *provider != "" && *model != "":
+		if *providerAddr == "" {
+			fail("--provider-addr is required with --provider (the engine must be bound to the provider you are checking)")
+		}
+		send, target = providerTransport(*provider, common.HexToHash(*model)), *provider+" model "+*model
+	default:
+		fail("need --engine, or --provider and --model")
+	}
+
+	r := run(send, o)
+	r.Target = target
+	if *asJSON {
+		out, _ := json.MarshalIndent(r, "", "  ")
+		fmt.Println(string(out))
+	} else {
+		r.print(os.Stdout)
+	}
+	if !r.Verified {
+		os.Exit(1)
+	}
+}
+
+const (
+	statusPass = "PASS"
+	statusFail = "FAIL"
+	statusSkip = "SKIP"
+)
+
+type check struct {
+	Name   string `json:"name"`
+	Status string `json:"status"`
+	Detail string `json:"detail"`
+}
+
+type report struct {
+	Target   string   `json:"target"`
+	Checks   []check  `json:"checks"`
+	Verified bool     `json:"verified"`
+	Skipped  []string `json:"skipped,omitempty"`
+	Error    string   `json:"error,omitempty"`
+}
+
+func (r *report) add(name, status, detail string) {
+	r.Checks = append(r.Checks, check{name, status, clean(detail)})
+	if status == statusSkip {
+		r.Skipped = append(r.Skipped, name)
+	}
+}
+
+// clean strips control characters (ANSI escapes, \r) from anything that may
+// have come from the provider, so it cannot redraw the report.
+func clean(s string) string {
+	return strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) {
+			return -1
+		}
+		return r
+	}, s)
+}
+
+func (r *report) print(w io.Writer) {
+	fmt.Fprintf(w, "Sealed engine verification: %s\n\n", clean(r.Target))
+	for _, c := range r.Checks {
+		fmt.Fprintf(w, "  [%s] %-16s %s\n", c.Status, c.Name, c.Detail)
+	}
+	switch {
+	case !r.Verified:
+		fmt.Fprintf(w, "\nNOT VERIFIED: %s\n", clean(r.Error))
+	case len(r.Skipped) > 0:
+		fmt.Fprintf(w, "\nVERIFIED (with SKIPPED checks: %s): a published sealed engine answered on a genuine Apple device in Full Security.\n", strings.Join(r.Skipped, ", "))
+	default:
+		fmt.Fprintln(w, "\nVERIFIED: a published sealed engine, bound to this provider, answered on a genuine Apple device in Full Security.")
+	}
+}
+
+// checkName maps a verification error to the claim it refutes.
+func checkName(err error, fallback string) string {
+	switch {
+	case errors.Is(err, appleattest.ErrCode):
+		return "code identity"
+	case errors.Is(err, appleattest.ErrOSVersion):
+		return "os version"
+	case errors.Is(err, appleattest.ErrRPID):
+		return "app identity"
+	case errors.Is(err, appleattest.ErrChain), errors.Is(err, appleattest.ErrAAGUID):
+		return "apple chain"
+	case errors.Is(err, appleattest.ErrConfig):
+		return "configuration"
+	case errors.Is(err, sealed.ErrProbeChallenge), errors.Is(err, appleattest.ErrSignature), errors.Is(err, appleattest.ErrCounter):
+		return "freshness"
+	case errors.Is(err, sealed.ErrProviderBinding):
+		return "provider binding"
+	}
+	return fallback
+}
+
+func run(send transport, o options) *report {
+	r := &report{}
+	stop := func(name string, err error) *report {
+		r.add(name, statusFail, err.Error())
+		r.Error = fmt.Sprintf("%s: %v", name, err)
+		return r
+	}
+
+	status, body, err := send("attest", nil)
+	if err == nil && status != 200 {
+		err = fmt.Errorf("engine status %d", status)
+	}
+	if err != nil {
+		return stop("reachability", err)
+	}
+	var att struct {
+		KeyID       string `json:"keyId"`
+		Attestation string `json:"attestation"`
+		ClientData  string `json:"clientData"`
+	}
+	if err := json.Unmarshal(body, &att); err != nil {
+		return stop("apple chain", err)
+	}
+	keyID, e1 := base64.StdEncoding.DecodeString(att.KeyID)
+	attObj, e2 := base64.StdEncoding.DecodeString(att.Attestation)
+	attCD, e3 := base64.StdEncoding.DecodeString(att.ClientData)
+	if err := errors.Join(e1, e2, e3); err != nil {
+		return stop("apple chain", err)
+	}
+	attCDH := sha256.Sum256(attCD)
+	verified, err := appleattest.VerifyAttestation(o.cfg, attObj, keyID, attCDH[:])
+	if err != nil {
+		return stop(checkName(err, "apple chain"), err)
+	}
+	r.add("apple chain", statusPass, "certificate chain ends at Apple App Attestation Root CA: key lives in a genuine Secure Enclave, app "+o.cfg.AppID)
+
+	challenge := make([]byte, 32)
+	if _, err := rand.Read(challenge); err != nil {
+		return stop("freshness", err)
+	}
+	req, _ := json.Marshal(map[string]string{"challenge": base64.StdEncoding.EncodeToString(challenge)})
+	status, body, err = send("probe", req)
+	if err == nil && status != 200 {
+		err = fmt.Errorf("engine status %d", status)
+	}
+	if err != nil {
+		return stop("freshness", err)
+	}
+	var pr struct {
+		ClientData string `json:"clientData"`
+		Assertion  string `json:"assertion"`
+	}
+	if err := json.Unmarshal(body, &pr); err != nil {
+		return stop("freshness", err)
+	}
+	cd, e1 := base64.StdEncoding.DecodeString(pr.ClientData)
+	as, e2 := base64.StdEncoding.DecodeString(pr.Assertion)
+	if err := errors.Join(e1, e2); err != nil {
+		return stop("freshness", err)
+	}
+	rep, err := sealed.VerifyProbe(o.cfg, verified, challenge, cd, as, o.providerAddr, o.allowedWeights)
+	if err != nil {
+		return stop(checkName(err, "weights"), err)
+	}
+	r.add("freshness", statusPass, fmt.Sprintf("Secure Enclave signed this run's random challenge (App Attest counter %d)", rep.Counter))
+	r.add("boot security", statusPass, "the key signing now was attested in this boot, in Full Security: App Attest keys stop signing after any restart (measured 3/3) and are never attested in weakened boots (measured 4/4)")
+	switch {
+	case verified.OS.Version == "":
+		r.add("os version", statusSkip, "unknown (attestation carries no OS version)")
+	case o.cfg.MinOSVersion != "":
+		r.add("os version", statusPass, fmt.Sprintf("%s %s (%s) ≥ minimum %s, as of this boot", verified.OS.Platform, verified.OS.Version, verified.OS.Build, o.cfg.MinOSVersion))
+	default:
+		r.add("os version", statusSkip, fmt.Sprintf("%s %s (%s): no --min-os given", verified.OS.Platform, verified.OS.Version, verified.OS.Build))
+	}
+	r.add("code identity", statusPass, "running binary CD hash "+hex.EncodeToString(rep.CDHash)+" is a published build")
+	if rep.ProviderBound {
+		r.add("provider binding", statusPass, "engine is bound to provider "+o.providerAddr+" (a relayed probe would fail)")
+	} else {
+		r.add("provider binding", statusSkip, "no --provider-addr: the engine could belong to a different provider")
+	}
+	if rep.WeightsChecked {
+		r.add("weights", statusPass, "weights hash "+hex.EncodeToString(rep.WeightsHash)+" is in the allowlist")
+	} else {
+		r.add("weights", statusSkip, "weights hash "+hex.EncodeToString(rep.WeightsHash)+" not checked: no --weights given")
+	}
+	r.Verified = true
+	return r
+}
+
+func parseHashes(s string) ([][]byte, error) {
+	var out [][]byte
+	for _, h := range strings.Split(s, ",") {
+		h = strings.TrimPrefix(strings.TrimSpace(h), "0x")
+		if h == "" {
+			continue
+		}
+		b, err := hex.DecodeString(h)
+		if err != nil || len(b) != 32 {
+			return nil, fmt.Errorf("%q is not a 32-byte hex hash", h)
+		}
+		out = append(out, b)
+	}
+	return out, nil
+}
+
+func engineTransport(base string) transport {
+	client := &http.Client{Timeout: 30 * time.Second}
+	return func(op string, body []byte) (int, []byte, error) {
+		method, path := http.MethodGet, "/attest"
+		if op == "probe" {
+			method, path = http.MethodPost, "/probe"
+		}
+		req, err := http.NewRequest(method, base+path, bytes.NewReader(body))
+		if err != nil {
+			return 0, nil, err
+		}
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := client.Do(req)
+		if err != nil {
+			return 0, nil, err
+		}
+		defer resp.Body.Close()
+		out, err := io.ReadAll(io.LimitReader(resp.Body, maxReply))
+		return resp.StatusCode, out, err
+	}
+}
+
+func providerTransport(addr string, modelID common.Hash) transport {
+	mor := msgs.NewMorRpc()
+	return func(op string, body []byte) (int, []byte, error) {
+		msg, err := mor.SealedProbeRequest(modelID, op, body, fmt.Sprintf("sealed-verify-%d", time.Now().UnixNano()))
+		if err != nil {
+			return 0, nil, err
+		}
+		conn, err := net.DialTimeout("tcp", addr, 10*time.Second)
+		if err != nil {
+			return 0, nil, err
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(60 * time.Second))
+		raw, _ := json.Marshal(msg)
+		if _, err := conn.Write(raw); err != nil {
+			return 0, nil, err
+		}
+		var res msgs.RpcResponse
+		if err := json.NewDecoder(bufio.NewReader(io.LimitReader(conn, maxReply))).Decode(&res); err != nil {
+			return 0, nil, err
+		}
+		if res.Error != nil {
+			return 0, nil, fmt.Errorf("provider error: %s", clean(fmt.Sprint(res.Error.Message)))
+		}
+		if res.Result == nil {
+			return 0, nil, fmt.Errorf("provider returned no result")
+		}
+		var rr msgs.SealedRelayRes
+		if err := json.Unmarshal(*res.Result, &rr); err != nil {
+			return 0, nil, err
+		}
+		out, err := base64.StdEncoding.DecodeString(rr.Body)
+		return rr.Status, out, err
+	}
+}
+
+// rebuildMain compares a published signed engine with a verifier's rebuild.
+// Exit status: 0 match, 1 mismatch, 2 usage error.
+func rebuildMain(args []string, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("rebuild", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	published := fs.String("published", "", "the published, signed SealedEngine.app")
+	rebuild := fs.String("rebuild", "", "your rebuild: SealedEngine.app from build-reproducible.sh verify")
+	appID := fs.String("app-id", "", "published engine app ID <TeamID>.<BundleID>")
+	cdhash := fs.String("cdhash", "", "optional: the CD hash published for this app (hex); the app must have it")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	team, bundle, ok := strings.Cut(*appID, ".")
+	if *published == "" || *rebuild == "" || !ok || team == "" || bundle == "" || fs.NArg() != 0 {
+		fmt.Fprintln(stderr, "sealed-verify rebuild: --published, --rebuild and --app-id TEAM.bundle are required")
+		return 2
+	}
+	want := codesig.Expect{Team: team, BundleID: bundle}
+	if *cdhash != "" {
+		h, err := hex.DecodeString(strings.TrimSpace(*cdhash))
+		if err != nil || len(h) != 32 {
+			fmt.Fprintln(stderr, "sealed-verify rebuild: --cdhash must be 64 hex characters")
+			return 2
+		}
+		want.CDHash = h
+	}
+	r := codesig.Compare(*published, *rebuild, want)
+	if *asJSON {
+		out, _ := json.MarshalIndent(r, "", "  ")
+		fmt.Fprintln(stdout, string(out))
+	} else {
+		fmt.Fprintf(stdout, "Rebuild comparison: %s vs %s\n\n", clean(*published), clean(*rebuild))
+		for _, c := range r.Checks {
+			status := statusPass
+			if !c.Pass {
+				status = statusFail
+			}
+			fmt.Fprintf(stdout, "  [%s] %-20s %s\n", status, c.Name, clean(c.Detail))
+		}
+		if r.OK {
+			fmt.Fprintf(stdout, "\nMATCH: the published app is this source's build. App Attest will report CD hash %s\nAt runtime the kernel enforces the executable's pages only; the other bundle files are proven for this copy, not for whatever a provider's disk holds later.\n", r.CDHash)
+		} else {
+			fmt.Fprintln(stdout, "\nNO MATCH: the published app is not a build of this source, or its signature says something it must not.")
+		}
+	}
+	if !r.OK {
+		return 1
+	}
+	return 0
+}
diff --git a/proxy-router/cmd/sealed-verify/main_test.go b/proxy-router/cmd/sealed-verify/main_test.go
new file mode 100644
index 00000000..9aa37828
--- /dev/null
+++ b/proxy-router/cmd/sealed-verify/main_test.go
@@ -0,0 +1,68 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/attestation/appleattest"
+	"github.com/stretchr/testify/require"
+)
+
+func opts() options {
+	return options{cfg: appleattest.Config{AppID: "A.b", ExpectedCDHashes: [][]byte{make([]byte, 32)}}}
+}
+
+// Every failure path must produce NOT VERIFIED, never a VERIFIED report.
+func TestRunFailurePathsNeverVerify(t *testing.T) {
+	cases := map[string]transport{
+		"unreachable":    func(string, []byte) (int, []byte, error) { return 0, nil, errors.New("dial refused") },
+		"engine error":   func(string, []byte) (int, []byte, error) { return 503, nil, nil },
+		"garbage attest": func(string, []byte) (int, []byte, error) { return 200, []byte("not json"), nil },
+		"bad base64": func(string, []byte) (int, []byte, error) {
+			return 200, []byte(`{"keyId":"!!","attestation":"!!","clientData":"!!"}`), nil
+		},
+		"bogus attestation": func(string, []byte) (int, []byte, error) {
+			return 200, []byte(`{"keyId":"AAAA","attestation":"oA==","clientData":"AAAA"}`), nil
+		},
+	}
+	for name, tr := range cases {
+		t.Run(name, func(t *testing.T) {
+			r := run(tr, opts())
+			require.False(t, r.Verified)
+			var out bytes.Buffer
+			r.print(&out)
+			require.Contains(t, out.String(), "NOT VERIFIED")
+			require.NotContains(t, strings.ReplaceAll(out.String(), "NOT VERIFIED", ""), "VERIFIED")
+		})
+	}
+}
+
+// Provider-supplied text cannot redraw the terminal report.
+func TestReportStripsControlCharacters(t *testing.T) {
+	evil := "boom\r\x1b[2K\x1b[1A  [PASS] everything\nVERIFIED: all good"
+	r := run(func(string, []byte) (int, []byte, error) { return 0, nil, errors.New(evil) }, opts())
+	var out bytes.Buffer
+	r.print(&out)
+	require.NotContains(t, out.String(), "\x1b")
+	require.NotContains(t, out.String(), "\r")
+	require.Equal(t, 1, strings.Count(out.String(), "\n\nNOT VERIFIED"), "exactly one verdict line")
+	require.NotContains(t, out.String(), "\nVERIFIED")
+}
+
+func TestSkippedChecksAreNamedInVerdict(t *testing.T) {
+	r := &report{Verified: true}
+	r.add("weights", statusSkip, "not checked")
+	var out bytes.Buffer
+	r.print(&out)
+	require.Contains(t, out.String(), "VERIFIED (with SKIPPED checks: weights)")
+}
+
+func TestParseHashes(t *testing.T) {
+	h, err := parseHashes("0x" + strings.Repeat("ab", 32) + ", " + strings.Repeat("cd", 32))
+	require.NoError(t, err)
+	require.Len(t, h, 2)
+	_, err = parseHashes("abcd")
+	require.Error(t, err)
+}
diff --git a/proxy-router/docs/SECURITY_NOTES_SESSION_AUDIO.md b/proxy-router/docs/SECURITY_NOTES_SESSION_AUDIO.md
new file mode 100644
index 00000000..bd626242
--- /dev/null
+++ b/proxy-router/docs/SECURITY_NOTES_SESSION_AUDIO.md
@@ -0,0 +1,98 @@
+# Session and audio stream hardening (change notes)
+
+## Session front door (MORRPC)
+
+- `session.request` requires the supplied key to derive to the supplied wallet
+  address (`PubKeyBytesToAddr` must equal `user`).
+- The stored `user:<addr>` record is a cache, not a trust anchor. Every handler
+  that authenticates a session owner (`session.prompt`, `session.report`,
+  `session.prompt.stream.*`) re-derives the stored key and requires it to match
+  the session's on-chain user before verifying the signature
+  (`sessionUserPubKey`). A stale or mismatched record cannot authenticate.
+- Records learned from inbound peers are written through `AddUserBound`, which
+  itself refuses any key that does not derive to the address, so the
+  key<->wallet invariant is enforced by the store and not only by the call
+  site. Overwrite is allowed because only the wallet owner can satisfy the
+  bound write; this also lets an owner replace a stale record on the next
+  `session.request` without operator intervention.
+- The unbound `AddUser` remains for consumer-side provider records only: a
+  contract provider's record legitimately holds the owner's key under the
+  contract address after the caller validated it against the resolved signer.
+- Session expiry uses server time (`sessionExpiredByServerTime`); the client
+  timestamp is not used for expiry. The expiry gate applies to inference
+  (`session.prompt`, `session.prompt.stream.*`) only. `session.report` is
+  intentionally **not** expiry-gated: the consumer's auto-closer runs after
+  `EndsAt` and asks for this report first; refusing it forces a user-signed
+  receipt, which the contract records as a dispute against the provider
+  (success count and stats not updated). Stale receipts are already rejected
+  on-chain (`SIGNATURE_TTL`), a session cannot be closed twice, and the
+  provider/signer binding below still gates who can obtain a report.
+- A session is only usable on the provider it was opened with. `isSessionValid`
+  (prompt/stream) checks the on-chain `ProviderAddr()`; `session.report` checks
+  the cached session's `ProviderAddr`. The check (`servesProvider`) accepts the
+  node's own key address directly, and a contract provider whose on-chain
+  `owner()` is this node's key via the shared `ProviderAuthResolver` (cached
+  per provider). Fails closed on an unknown node key or resolver error.
+
+## Audio stream sandbox (MORRPC)
+
+- The client `streamid` is accepted for wire compatibility (existing consumers
+  reuse it on `chunk`/`end`) but is validated (`^[A-Za-z0-9_-]{1,64}$`) and
+  used only as an in-memory key scoped to the owning session
+  (`sessionID:streamID`). It never influences a filesystem path.
+- Temp files are created with `os.CreateTemp` under a fixed directory
+  (`morpheus-audio-streams`) and verified with `PathUnderDir`.
+- Bounds per stream: `totalchunks` in `1..4096` and `<= filesize`, `filesize`
+  in `1..256 MiB`, decoded chunk `<= 8 MiB`, cumulative bytes `<= filesize`,
+  and `end` requires exactly `filesize` bytes. At most 4 concurrent streams per
+  session and 2 GiB of declared size in flight across all sessions. Chunks must
+  arrive in order.
+- Remove/process only operate on managed paths
+  (`SafeRemoveManagedAudioPath` / `IsManagedAudioPath`); a `FilePath` on
+  `session.prompt` that is not a managed path is refused.
+
+## Consumer side
+
+- `sendStreamStart` continues with the stream ID the provider acknowledges.
+  Providers echo the client ID today, so this is a no-op; it keeps consumers
+  compatible if a provider ever issues its own.
+
+## HTTP (`:8082`, operator-authenticated)
+
+- Audio upload `createTempFile` uses `os.CreateTemp`; only an allowlisted
+  audio extension is preserved from the client filename so the engine can
+  infer the format.
+- Chat file storage builds paths from sanitized ids and rejects path elements.
+- `POST /ipfs/add` is unchanged: it is operator-authenticated and reads a file
+  the operator chose on their own machine (MorpheusUI model pinning). Accepted
+  residual: if `:8082` admin credentials are compromised the endpoint can read
+  any path the process can; the same credentials already expose
+  wallet-spending endpoints, so the control for this surface is keeping `:8082`
+  off the public network and running non-root, not a path allowlist.
+
+## Known follow-ups (out of scope for this hotfix)
+
+- Consumer-side provider key records (`proxy_sender.go` `InitiateSession`) are
+  verified self-consistently against the response signature but not bound to
+  the provider address; binding needs the resolved signer for contract
+  providers. Not part of the inbound provider surface this hotfix addresses.
+
+## Compatibility
+
+All MORRPC changes are wire-compatible with unpatched consumers. Providers can
+upgrade first; consumers can upgrade at their own pace.
+
+## Ops
+
+- Run the process as a non-root user.
+- Consumers should not expose inbound MORRPC `:3333` publicly.
+
+## Tests
+
+- `internal/lib`: `PathUnderDir`, `PubKeyBytesToAddr`
+- `internal/storages`: `AddUserBound` key<->address enforcement, `AddUser`
+  overwrite semantics
+- `internal/proxyapi`: stream id validation, session-scoped lookup, per-stream
+  and global bounds, ordered append, managed-path remove, stored-key derivation
+  check, server-time expiry helper
+- `internal/chatstorage`: id sanitization
