+// TestLiveSealedProviderView runs the real consumer sealed path through the
+// real provider adapter to a running sealed-engine, recording every byte the
+// provider handles. Env: SEALED_ENGINE_URL, APPLEATTEST_APPID, SEALED_EXPECT_CDHASH.
+func TestLiveSealedProviderView(t *testing.T) {
+	url, appID, want := os.Getenv("SEALED_ENGINE_URL"), os.Getenv("APPLEATTEST_APPID"), os.Getenv("SEALED_EXPECT_CDHASH")
+	if url == "" || appID == "" || want == "" {
+		t.Skip("SEALED_ENGINE_URL / APPLEATTEST_APPID / SEALED_EXPECT_CDHASH not set")
+	}
+	if os.Getenv("SEALED_EXPECT_WEIGHTS") != "" {
+		t.Skip("engine is in model mode (this test expects echo mode)")
+	}
+	cd, err := hex.DecodeString(want)
+	require.NoError(t, err)
+	model := common.HexToHash("0x0a")
+	cfg := &SealedConfig{
+		Attest: appleattest.Config{AppID: appID, ExpectedCDHashes: [][]byte{cd}},
+		Models: map[common.Hash][][]byte{model: {make([]byte, 32)}},
+	}
+	p := &ProxyServiceSender{}
+	p.SetSealed(cfg, &fakeTags{tags: []string{"tee-apple"}})
+
+	engine := aiengine.NewSealedMacEngine("m", url, 0, lib.NewTestLogger())
+	var providerSaw bytes.Buffer // everything the provider relays, both directions
+	tamperNext := false
+	p.sealed.relay = func(ctx context.Context, _ common.Hash, _ *storages.User, op string, body []byte) (int, []byte, error) {
+		providerSaw.Write(body)
+		status, out, err := engine.SealedRelay(ctx, op, body)
+		providerSaw.Write(out)
+		if tamperNext && op == "infer" {
+			// Well-formed JSON and base64; one ciphertext bit flipped, so only
+			// the envelope's authentication can catch it.
+			tamperNext = false
+			var r struct {
+				Frames []sealed.Frame `json:"frames"`
+			}
+			require.NoError(t, json.Unmarshal(out, &r))
+			r.Frames[0].Ciphertext[0] ^= 1
+			out, _ = json.Marshal(r)
+		}
+		return status, out, err
+	}
+
+	const canary = "CANARY-PROVIDER-MUST-NOT-SEE-9f2c"
+	prompt := &gcs.OpenAICompletionRequestExtra{ChatCompletionRequest: openai.ChatCompletionRequest{
+		Model:    "m",
+		Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "hello " + canary}},
+	}}
+	plain, _ := json.Marshal(prompt)
+	sum := sha256.Sum256(plain)
+	sid := common.HexToHash("0x5eed")
+
+	var got []string
+	cb := func(_ context.Context, c gcs.Chunk, _ *gcs.AiEngineErrorResponse) error {
+		txt, _ := json.Marshal(c.Data())
+		got = append(got, string(txt))
+		return nil
+	}
+	for i := 0; i < 2; i++ { // second prompt reuses the established channel
+		_, err = p.sendPromptSealed(context.Background(), sid, model, &storages.User{}, prompt, cb)
+		require.NoError(t, err)
+	}
+	require.Len(t, got, 2)
+	for _, g := range got {
+		require.Contains(t, g, "sha256="+hex.EncodeToString(sum[:]), "engine must have decrypted the exact prompt")
+	}
+
+	tamperNext = true
+	_, err = p.sendPromptSealed(context.Background(), sid, model, &storages.User{}, prompt, cb)
+	require.Error(t, err, "tampered engine reply must be rejected")
+	_, err = p.sendPromptSealed(context.Background(), sid, model, &storages.User{}, prompt, cb)
+	require.NoError(t, err, "channel re-establishes after a rejection")
+
+	// Per-model weights: a model pinned to other weights must be refused even
+	// though the engine and its attestation are otherwise valid.
+	other := common.HexToHash("0x0b")
+	cfg.Models[other] = [][]byte{bytes.Repeat([]byte{7}, 32)}
+	_, err = p.sendPromptSealed(context.Background(), common.HexToHash("0x5eee"), other, &storages.User{}, prompt, cb)
+	require.ErrorIs(t, err, sealed.ErrBinding, "engine's weights are not allowed for this model")
+
+	require.NotContains(t, providerSaw.String(), canary, "the provider must never see the prompt")
+	require.NotContains(t, providerSaw.String(), "hello ", "the provider must never see prompt text")
+	t.Logf("provider relayed %d bytes; no plaintext", providerSaw.Len())
+}
