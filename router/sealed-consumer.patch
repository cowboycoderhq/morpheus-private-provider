+// SEALED_MODEL_WEIGHTS=listing: a tee-apple model is sealed and pinned to the
+// weights its own listing commits to; without that mode, or without a
+// weights hash, it is refused (never sent plaintext).
+func TestSealedPinFromListing(t *testing.T) {
+	ctx := context.Background()
+	model := common.HexToHash("0x5e")
+	w := [32]byte{0x93, 0x17}
+
+	listing := &fakeListing{fakeTags: fakeTags{tags: []string{"LLM", "tee-apple"}}, weights: w}
+	p := &ProxyServiceSender{}
+	p.SetSealed(&SealedConfig{PinFromListing: true}, listing)
+	sealed, err := p.sealedDecision(ctx, model)
+	require.NoError(t, err)
+	require.True(t, sealed)
+	got, err := p.sealed.weightsFor(ctx, model)
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{w[:]}, got)
+
+	// Not in listing mode: the same model is refused.
+	p2 := &ProxyServiceSender{}
+	p2.SetSealed(&SealedConfig{}, listing)
+	_, err = p2.sealedDecision(ctx, model)
+	require.ErrorIs(t, err, ErrSealedNotConfigured)
+
+	// An ordinary model is unaffected.
+	plain := &ProxyServiceSender{}
+	plain.SetSealed(&SealedConfig{PinFromListing: true}, &fakeListing{fakeTags: fakeTags{tags: []string{"LLM"}}})
+	sealed, err = plain.sealedDecision(ctx, model)
+	require.NoError(t, err)
+	require.False(t, sealed)
+
+	// A listing with no weights hash, a failed read, or a lookup that cannot
+	// read weights: no pin, so no channel (and no request to the provider).
+	for name, tags := range map[string]ModelTagsLookup{
+		"zero hash":   &fakeListing{fakeTags: fakeTags{tags: []string{"tee-apple"}}},
+		"read failed": &fakeListing{fakeTags: fakeTags{tags: []string{"tee-apple"}}, err: errors.New("rpc down")},
+		"no lookup":   &fakeTags{tags: []string{"tee-apple"}},
+	} {
+		q := &ProxyServiceSender{}
+		q.SetSealed(&SealedConfig{PinFromListing: true}, tags)
+		var ops []string
+		q.sealed.relay = func(_ context.Context, _ common.Hash, _ *storages.User, op string, _ []byte) (int, []byte, error) {
+			ops = append(ops, op)
+			return 0, nil, errors.New("stub")
+		}
+		_, err := q.sealedChannelFor(ctx, common.HexToHash("0x01"), model, &storages.User{})
+		require.Error(t, err, name)
+		require.Empty(t, ops, name+": nothing may be sent without a weights pin")
+	}
+
+	// A configured pin wins over the listing.
+	fixed := [32]byte{0x01}
+	p3 := &ProxyServiceSender{}
+	p3.SetSealed(&SealedConfig{PinFromListing: true, Models: map[common.Hash][][]byte{model: {fixed[:]}}}, listing)
+	got, err = p3.sealed.weightsFor(ctx, model)
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{fixed[:]}, got)
+}
