+package sealed
+
+import (
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The package bytes are synthetic. The two child values are synthetic too.
+// Neither child value is a CD hash from a build. The expected digest is the
+// output of scripts/model-hash.py on these same bytes.
+func TestModelHashV2Vector(t *testing.T) {
+	d := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(d, "tokenizer"), 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(d, "sealed-manifest.bin"), []byte("sealed-manifest-v2\x01\x02payload"), 0o600))
+	for i, n := range v2TokenizerFiles {
+		require.NoError(t, os.WriteFile(filepath.Join(d, "tokenizer", n), []byte(fmt.Sprintf("file-%d", i)), 0o600))
+	}
+	child, err := hex.DecodeString("4ff50c14258ba6e249670b9fa1dc9739a170d61a")
+	require.NoError(t, err)
+	got, err := ModelHashV2(d, child)
+	require.NoError(t, err)
+	require.Equal(t, "3a2af3a1819d9c583861fa11acded326159fe0aef894125629c78523f7b901b3", hex.EncodeToString(got))
+
+	other, err := hex.DecodeString("51b1e493c8fcdff4138c694c55555426fbbcbfb5")
+	require.NoError(t, err)
+	got2, err := ModelHashV2(d, other)
+	require.NoError(t, err)
+	require.NotEqual(t, got, got2, "the child CD hash is part of the model hash")
+}
+
+func TestModelHashV2RefusesV1Manifest(t *testing.T) {
+	d := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(d, "sealed-manifest.bin"), []byte("sealed-manifest-v1xxxx"), 0o600))
+	_, err := ModelHashV2(d, []byte{1})
+	require.ErrorIs(t, err, ErrModelDir)
+}
diff --git a/proxy-router/internal/sealed/padding_test.go b/proxy-router/internal/sealed/padding_test.go
new file mode 100644
index 00000000..de7fb569
--- /dev/null
+++ b/proxy-router/internal/sealed/padding_test.go
@@ -0,0 +1,125 @@
+package sealed
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// padBody mirrors the Swift engine's padded frame body (2-byte length + 1024 data bytes).
+const padBody = 1026
+
+// padFrame builds a padded plaintext like Engine.sealFrames: flag | u16 len | data | zeros.
+func padFrame(flag byte, data []byte) []byte {
+	pt := []byte{flag, byte(len(data) >> 8), byte(len(data))}
+	pt = append(pt, data...)
+	return append(pt, make([]byte, padBody-2-len(data))...)
+}
+
+// respondPadded seals bodies as one padded response, rounded up to a power of two
+// with empty frames, as the engine does.
+func (e *engineSide) respondPadded(sid string, bodies ...string) []Frame {
+	n := 1
+	for n < len(bodies) {
+		n <<= 1
+	}
+	for len(bodies) < n {
+		bodies = append(bodies, "")
+	}
+	out := make([]Frame, 0, len(bodies))
+	for i, b := range bodies {
+		flag := byte(flagPadMore)
+		if i == len(bodies)-1 {
+			flag = flagPadFinal
+		}
+		seq, ct := e.send.seal(padFrame(flag, []byte(b)))
+		out = append(out, Frame{SessionID: sid, Seq: seq, Ciphertext: ct})
+	}
+	return out
+}
+
+func TestPaddedFramesRoundTrip(t *testing.T) {
+	c, e := setup(t)
+	frames := e.respondPadded("s1", "Paris", "and more")
+	chunks, err := c.OpenResponse(frames)
+	require.NoError(t, err)
+	require.Equal(t, "Parisand more", string(joinChunks(chunks)))
+}
+
+// Every ciphertext has the same length, whatever the reply length.
+func TestPaddedFramesHideLength(t *testing.T) {
+	_, e := setup(t)
+	short := e.respondPadded("s1", "a")
+	long := e.respondPadded("s1", string(make([]byte, 1024)))
+	require.Len(t, short, 1)
+	require.Len(t, long, 1)
+	require.Equal(t, len(short[0].Ciphertext), len(long[0].Ciphertext))
+}
+
+// Frame counts are rounded up to a power of two.
+func TestPaddedFrameCountBuckets(t *testing.T) {
+	_, e := setup(t)
+	require.Len(t, e.respondPadded("s1", "1", "2", "3"), 4)
+	require.Len(t, e.respondPadded("s1", "1", "2", "3", "4", "5"), 8)
+}
+
+func TestPaddedFrameRejections(t *testing.T) {
+	t.Run("non-zero padding", func(t *testing.T) {
+		c, e := setup(t)
+		pt := padFrame(flagPadFinal, []byte("x"))
+		pt[len(pt)-1] = 1
+		seq, ct := e.send.seal(pt)
+		_, err := c.OpenResponse([]Frame{{SessionID: "s1", Seq: seq, Ciphertext: ct}})
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("length past the frame", func(t *testing.T) {
+		c, e := setup(t)
+		pt := padFrame(flagPadFinal, []byte("x"))
+		pt[1], pt[2] = 0xff, 0xff
+		seq, ct := e.send.seal(pt)
+		_, err := c.OpenResponse([]Frame{{SessionID: "s1", Seq: seq, Ciphertext: ct}})
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("final not last", func(t *testing.T) {
+		c, e := setup(t)
+		seq1, ct1 := e.send.seal(padFrame(flagPadFinal, []byte("a")))
+		seq2, ct2 := e.send.seal(padFrame(flagPadFinal, []byte("b")))
+		_, err := c.OpenResponse([]Frame{{SessionID: "s1", Seq: seq1, Ciphertext: ct1}, {SessionID: "s1", Seq: seq2, Ciphertext: ct2}})
+		require.ErrorIs(t, err, ErrTruncated)
+	})
+}
+
+func joinChunks(cs [][]byte) []byte {
+	var out []byte
+	for _, c := range cs {
+		out = append(out, c...)
+	}
+	return out
+}
+
+
+// Downgrade refusals (audit R2-E-04): an engine before reply padding sends
+// flags 0x00/0x01 with no length field; the client must refuse them.
+func TestUnpaddedFramesRefused(t *testing.T) {
+	for _, flag := range []byte{flagMore, flagFinal} {
+		c, e := setup(t)
+		seq, ct := e.send.seal(append([]byte{flag}, []byte("reply in clear length")...))
+		_, err := c.OpenResponse([]Frame{{SessionID: "s1", Seq: seq, Ciphertext: ct}})
+		require.ErrorIs(t, err, ErrOpen, "flag 0x%02x must be refused", flag)
+	}
+}
+
+func TestPaddedFrameWrongSizeRefused(t *testing.T) {
+	c, e := setup(t)
+	pt := padFrame(flagPadFinal, []byte("x"))
+	pt = pt[:len(pt)-1] // one byte short of padPlain
+	seq, ct := e.send.seal(pt)
+	_, err := c.OpenResponse([]Frame{{SessionID: "s1", Seq: seq, Ciphertext: ct}})
+	require.ErrorIs(t, err, ErrOpen)
+}
+
+func TestFrameCountNotPowerOfTwoRefused(t *testing.T) {
+	c, e := setup(t)
+	_, err := c.OpenResponse(e.respond("s1", "a", "b", "c")) // 3 frames
+	require.ErrorIs(t, err, ErrOpen)
+}
diff --git a/proxy-router/internal/sealed/sealed.go b/proxy-router/internal/sealed/sealed.go
new file mode 100644
index 00000000..f0fc4b32
--- /dev/null
+++ b/proxy-router/internal/sealed/sealed.go
@@ -0,0 +1,362 @@
+// Package sealed implements the consumer side of the sealed-inference envelope:
+// prompts are encrypted to an attested engine's per-session X25519 key, so the
+// provider operator and proxy-router relay only ciphertext.
+//
+// Handshake (the consumer's key is bound BEFORE the engine answers):
+//
+//	consumer → engine  /session {challenge(32), clientPub(32)}
+//	engine   → consumer clientData = challenge ‖ clientPub ‖ enginePub ‖ weightsHash  (128 bytes)
+//	                    + App Attest assertion over SHA256(clientData)
+//
+// Establish verifies that assertion (CD-hash policy included), checks every
+// field of clientData against what the consumer sent and expects, and only
+// then derives keys. The engine derives the same keys at /session time and
+// accepts no other client key for the session.
+//
+// Envelope v1 (must match sealed-engine/Sources/SealedEngine/Envelope.swift):
+//
+//	shared  = X25519(client_priv, engine_pub)                 (all-zero rejected)
+//	okm     = HKDF-SHA256(ikm=shared, salt=challenge,
+//	                      info="morpheus-sealed/v1" ‖ client_pub ‖ engine_pub, L=64)
+//	k_c2e   = okm[0:32], k_e2c = okm[32:64]
+//	frame n = ChaCha20-Poly1305(k_dir, nonce = 0x00000000 ‖ uint64_be(n),
+//	                            aad = "morpheus-sealed/v1" ‖ dir, plaintext)
+//
+// Engine → consumer plaintexts are padded: flag(1) ‖ uint16_be(len) ‖
+// payload(len) ‖ zeros, exactly 1027 bytes; flag 0x02 = more, 0x03 = final.
+// A response has a power-of-two number of frames and is complete only when
+// its final frame opened. The unpadded flags 0x00/0x01 are refused.
+// Each direction's counter starts at 0 and must strictly increase. Any
+// rejected frame ends the session (the counters cannot resynchronise).
+package sealed
+
+import (
+	"bytes"
+	"crypto/ecdh"
+	"crypto/hkdf"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/attestation/appleattest"
+	"golang.org/x/crypto/chacha20poly1305"
+)
+
+const (
+	Version        = "morpheus-sealed/v1"
+	ClientDataSize = 128
+	flagMore       = 0x00
+	flagFinal      = 0x01
+	// Padded frames (engine with reply-length padding): flag | u16 len | data | zeros.
+	flagPadMore  = 0x02
+	flagPadFinal = 0x03
+	// padPlain is the exact plaintext size of a padded frame: 1-byte flag,
+	// 2-byte length, 1024-byte body. The engine's padBody is 1026.
+	padPlain = 1027
+)
+
+var (
+	ErrKey       = errors.New("sealed: invalid key material")
+	ErrBinding   = errors.New("sealed: handshake data does not match what was sent or expected")
+	ErrSequence  = errors.New("sealed: unexpected sequence number")
+	ErrOpen      = errors.New("sealed: authentication failed")
+	ErrTruncated = errors.New("sealed: response incomplete (no final frame)")
+)
+
+// Frame is one sealed message on the wire.
+type Frame struct {
+	SessionID  string `json:"sessionId"`
+	Seq        uint64 `json:"seq"`
+	Ciphertext []byte `json:"ct"`
+}
+
+// ClientKey is the consumer's ephemeral key, generated before the handshake so
+// its public half can be sent in /session and bound into the engine's assertion.
+type ClientKey struct{ priv *ecdh.PrivateKey }
+
+func NewClientKey() (*ClientKey, error) {
+	priv, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		return nil, err
+	}
+	return &ClientKey{priv: priv}, nil
+}
+
+func (k *ClientKey) Public() []byte { return k.priv.PublicKey().Bytes() }
+
+// ClientSession is one consumer ↔ engine session. Not safe for concurrent use.
+type ClientSession struct {
+	sessionID string
+	send      *direction
+	recv      *direction
+	failed    bool
+}
+
+// Handshake is what the consumer holds for one /session exchange.
+type Handshake struct {
+	SessionID   string
+	Challenge   []byte // the 32 bytes the consumer sent
+	Key         *ClientKey
+	ClientData  []byte // returned by the engine
+	Assertion   []byte // returned by the engine
+	PrevCounter uint32 // last accepted App Attest counter for this engine key
+}
+
+// Establish verifies the engine's assertion over the handshake data (App
+// Attest signature, counter, rpId and CD-hash policy via cfg), checks that the
+// asserted clientData is exactly challenge ‖ our key ‖ engine key ‖ one of
+// allowedWeights, and only then derives the session keys. It returns the new
+// App Attest counter. Freshness comes from the consumer's 32-byte challenge
+// bound into clientData; the counter is informational unless the caller tracks
+// it per engine key (pass the stored value as Handshake.PrevCounter).
+func Establish(cfg appleattest.Config, att *appleattest.Attestation, h Handshake, allowedWeights [][]byte) (*ClientSession, uint32, error) {
+	if h.Key == nil || h.SessionID == "" || len(h.Challenge) != 32 || len(allowedWeights) == 0 {
+		return nil, 0, fmt.Errorf("%w: handshake incomplete", ErrKey)
+	}
+	for _, w := range allowedWeights {
+		if len(w) != 32 {
+			return nil, 0, fmt.Errorf("%w: weights hash must be 32 bytes", ErrKey)
+		}
+	}
+	if len(h.ClientData) != ClientDataSize {
+		return nil, 0, fmt.Errorf("%w: clientData is %d bytes", ErrBinding, len(h.ClientData))
+	}
+	cdh := sha256.Sum256(h.ClientData)
+	as, err := appleattest.VerifyAssertion(cfg, att, h.Assertion, cdh[:], h.PrevCounter)
+	if err != nil {
+		return nil, 0, err
+	}
+	cd := h.ClientData
+	if !bytes.Equal(cd[0:32], h.Challenge) || !bytes.Equal(cd[32:64], h.Key.Public()) || !containsHash(allowedWeights, cd[96:128]) {
+		return nil, 0, ErrBinding
+	}
+	s, err := newSession(h.SessionID, h.Challenge, cd[64:96], h.Key.priv)
+	if err != nil {
+		return nil, 0, err
+	}
+	return s, as.Counter, nil
+}
+
+func containsHash(list [][]byte, h []byte) bool {
+	for _, w := range list {
+		if bytes.Equal(w, h) {
+			return true
+		}
+	}
+	return false
+}
+
+func newSession(sessionID string, challenge, enginePub []byte, priv *ecdh.PrivateKey) (*ClientSession, error) {
+	c2e, e2c, err := deriveKeys(priv, enginePub, challenge)
+	if err != nil {
+		return nil, err
+	}
+	send, err := newDirection(c2e, "c2e")
+	if err != nil {
+		return nil, err
+	}
+	recv, err := newDirection(e2c, "e2c")
+	if err != nil {
+		return nil, err
+	}
+	return &ClientSession{sessionID: sessionID, send: send, recv: recv}, nil
+}
+
+type direction struct {
+	aead interface {
+		Seal(dst, nonce, plaintext, additionalData []byte) []byte
+		Open(dst, nonce, ciphertext, additionalData []byte) ([]byte, error)
+	}
+	aad []byte
+	seq uint64
+}
+
+func deriveKeys(priv *ecdh.PrivateKey, peerPub, challenge []byte) ([]byte, []byte, error) {
+	peer, err := ecdh.X25519().NewPublicKey(peerPub)
+	if err != nil {
+		return nil, nil, fmt.Errorf("%w: %v", ErrKey, err)
+	}
+	shared, err := priv.ECDH(peer) // errors on the all-zero (low-order) result
+	if err != nil {
+		return nil, nil, fmt.Errorf("%w: %v", ErrKey, err)
+	}
+	return deriveFromShared(shared, challenge, priv.PublicKey().Bytes(), peerPub)
+}
+
+func deriveFromShared(shared, challenge, clientPub, enginePub []byte) ([]byte, []byte, error) {
+	info := append(append([]byte(Version), clientPub...), enginePub...)
+	okm, err := hkdf.Key(sha256.New, shared, challenge, string(info), 64)
+	if err != nil {
+		return nil, nil, err
+	}
+	return okm[:32], okm[32:], nil
+}
+
+func newDirection(key []byte, dir string) (*direction, error) {
+	a, err := chacha20poly1305.New(key)
+	if err != nil {
+		return nil, err
+	}
+	return &direction{aead: a, aad: []byte(Version + dir)}, nil
+}
+
+func nonce(seq uint64) []byte {
+	n := make([]byte, chacha20poly1305.NonceSize)
+	binary.BigEndian.PutUint64(n[4:], seq)
+	return n
+}
+
+func (d *direction) seal(pt []byte) (uint64, []byte) {
+	seq := d.seq
+	d.seq++
+	return seq, d.aead.Seal(nil, nonce(seq), pt, d.aad)
+}
+
+func (d *direction) open(seq uint64, ct []byte) ([]byte, error) {
+	if seq != d.seq {
+		return nil, fmt.Errorf("%w: got %d, want %d", ErrSequence, seq, d.seq)
+	}
+	pt, err := d.aead.Open(nil, nonce(seq), ct, d.aad)
+	if err != nil {
+		return nil, ErrOpen
+	}
+	d.seq++
+	return pt, nil
+}
+
+// Seal encrypts one consumer → engine message (a whole prompt).
+func (s *ClientSession) Seal(plaintext []byte) (Frame, error) {
+	if s.failed {
+		return Frame{}, fmt.Errorf("%w: session ended by an earlier rejection", ErrOpen)
+	}
+	seq, ct := s.send.seal(plaintext)
+	return Frame{SessionID: s.sessionID, Seq: seq, Ciphertext: ct}, nil
+}
+
+// OpenResponse decrypts one complete engine response. Frames must be in
+// order, only the last may be final, and the last must be final.
+func (s *ClientSession) OpenResponse(frames []Frame) ([][]byte, error) {
+	if s.failed {
+		return nil, fmt.Errorf("%w: session ended by an earlier rejection", ErrOpen)
+	}
+	// The engine rounds the frame count up to a power of two. A zero count
+	// fails this test too (0&(0-1) is 0 only for the explicit n == 0 case).
+	if n := len(frames); n == 0 || n&(n-1) != 0 {
+		s.failed = true
+		return nil, fmt.Errorf("%w: %d frames is not a power of two", ErrOpen, n)
+	}
+	out := make([][]byte, 0, len(frames))
+	for i, f := range frames {
+		if f.SessionID != s.sessionID {
+			s.failed = true
+			return nil, fmt.Errorf("%w: session id", ErrOpen)
+		}
+		pt, err := s.recv.open(f.Seq, f.Ciphertext)
+		if err != nil || len(pt) == 0 {
+			s.failed = true
+			if err == nil {
+				err = fmt.Errorf("%w: empty frame", ErrOpen)
+			}
+			return nil, err
+		}
+		var body []byte
+		var final bool
+		// Only padded frames are accepted. The unpadded flags 0x00/0x01 came
+		// from engines before reply padding; accepting them lets a provider run
+		// such an engine and show the reply length (audit R2-E-04).
+		switch pt[0] {
+		case flagPadMore, flagPadFinal:
+			if len(pt) != padPlain {
+				s.failed = true
+				return nil, fmt.Errorf("%w: padded frame is %d bytes, want %d", ErrOpen, len(pt), padPlain)
+			}
+			n := int(pt[1])<<8 | int(pt[2])
+			if 3+n > len(pt) {
+				s.failed = true
+				return nil, fmt.Errorf("%w: padded length past the frame", ErrOpen)
+			}
+			for _, b := range pt[3+n:] {
+				if b != 0 {
+					s.failed = true
+					return nil, fmt.Errorf("%w: non-zero padding", ErrOpen)
+				}
+			}
+			final, body = pt[0] == flagPadFinal, pt[3:3+n]
+		default:
+			s.failed = true
+			return nil, fmt.Errorf("%w: bad frame flag", ErrOpen)
+		}
+		if final != (i == len(frames)-1) {
+			s.failed = true
+			return nil, ErrTruncated
+		}
+		out = append(out, body)
+	}
+	if len(frames) == 0 {
+		return nil, ErrTruncated
+	}
+	return out, nil
+}
+
+// ProbeReport is what a third-party verifier learns from a provider's engine.
+type ProbeReport struct {
+	CDHash         []byte // binary running on the provider, measured by the OS
+	WeightsHash    []byte // model weights the engine loaded
+	OS             appleattest.OSInfo
+	Counter        uint32
+	ProviderBound  bool // provider address checked against the engine's binding
+	WeightsChecked bool // weights hash checked against an allowlist
+}
+
+var (
+	ErrProbeChallenge  = errors.New("sealed: probe was not signed over this run's challenge")
+	ErrProviderBinding = errors.New("sealed: engine is bound to a different provider (probe relayed?)")
+)
+
+// ProviderTag binds an engine's probes to the provider it serves.
+func ProviderTag(providerAddr string) []byte {
+	h := sha256.Sum256([]byte("morpheus-sealed/provider/v1" + strings.ToLower(providerAddr)))
+	return h[:]
+}
+
+// VerifyProbe checks an engine's answer to a public /probe: the App Attest
+// assertion (signature, rpId, CD-hash policy) over clientData, which must be
+// challenge ‖ ProviderTag(providerAddr) ‖ 32 zero bytes ‖ weightsHash.
+// providerAddr "" skips the provider binding; empty allowedWeights skips the
+// weights check. Both are reported, never silently passed.
+func VerifyProbe(cfg appleattest.Config, att *appleattest.Attestation, challenge, clientData, assertion []byte, providerAddr string, allowedWeights [][]byte) (*ProbeReport, error) {
+	if att == nil || len(challenge) != 32 {
+		return nil, fmt.Errorf("%w: probe incomplete", ErrKey)
+	}
+	if len(clientData) != ClientDataSize {
+		return nil, fmt.Errorf("%w: clientData is %d bytes", ErrBinding, len(clientData))
+	}
+	cdh := sha256.Sum256(clientData)
+	as, err := appleattest.VerifyAssertion(cfg, att, assertion, cdh[:], 0)
+	if err != nil {
+		return nil, err
+	}
+	if !bytes.Equal(clientData[0:32], challenge) {
+		return nil, ErrProbeChallenge
+	}
+	if !bytes.Equal(clientData[64:96], make([]byte, 32)) {
+		return nil, fmt.Errorf("%w: not a probe (key field set)", ErrBinding)
+	}
+	rep := &ProbeReport{CDHash: as.Extensions.CDHash, WeightsHash: bytes.Clone(clientData[96:128]), OS: att.OS, Counter: as.Counter}
+	if providerAddr != "" {
+		if !bytes.Equal(clientData[32:64], ProviderTag(providerAddr)) {
+			return nil, ErrProviderBinding
+		}
+		rep.ProviderBound = true
+	}
+	if len(allowedWeights) > 0 {
+		if !containsHash(allowedWeights, rep.WeightsHash) {
+			return nil, fmt.Errorf("%w: weights not in allowlist", ErrBinding)
+		}
+		rep.WeightsChecked = true
+	}
+	return rep, nil
+}
diff --git a/proxy-router/internal/sealed/sealed_test.go b/proxy-router/internal/sealed/sealed_test.go
new file mode 100644
index 00000000..0e3672fb
--- /dev/null
+++ b/proxy-router/internal/sealed/sealed_test.go
@@ -0,0 +1,173 @@
+package sealed
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// engineSide mirrors the Swift engine, for in-process tests of the envelope.
+type engineSide struct {
+	recv, send *direction
+}
+
+func newEngineSide(t *testing.T, enginePriv *ecdh.PrivateKey, clientPub, challenge []byte) *engineSide {
+	t.Helper()
+	peer, err := ecdh.X25519().NewPublicKey(clientPub)
+	require.NoError(t, err)
+	shared, err := enginePriv.ECDH(peer)
+	require.NoError(t, err)
+	c2e, e2c, err := deriveFromShared(shared, challenge, clientPub, enginePriv.PublicKey().Bytes())
+	require.NoError(t, err)
+	recv, err := newDirection(c2e, "c2e")
+	require.NoError(t, err)
+	send, err := newDirection(e2c, "e2c")
+	require.NoError(t, err)
+	return &engineSide{recv: recv, send: send}
+}
+
+// respond seals chunks as one response: every frame "more" except the last.
+// respond seals chunks as padded frames, the format of the current engine.
+// It does not add filler frames: tests pick power-of-two counts, or test the
+// count rule on purpose.
+func (e *engineSide) respond(sid string, chunks ...string) []Frame {
+	out := make([]Frame, 0, len(chunks))
+	for i, c := range chunks {
+		flag := byte(flagPadMore)
+		if i == len(chunks)-1 {
+			flag = flagPadFinal
+		}
+		seq, ct := e.send.seal(padFrame(flag, []byte(c)))
+		out = append(out, Frame{SessionID: sid, Seq: seq, Ciphertext: ct})
+	}
+	return out
+}
+
+func setup(t *testing.T) (*ClientSession, *engineSide) {
+	t.Helper()
+	enginePriv, err := ecdh.X25519().GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	key, err := NewClientKey()
+	require.NoError(t, err)
+	challenge := make([]byte, 32)
+	_, _ = rand.Read(challenge)
+	c, err := newSession("s1", challenge, enginePriv.PublicKey().Bytes(), key.priv)
+	require.NoError(t, err)
+	return c, newEngineSide(t, enginePriv, key.Public(), challenge)
+}
+
+func TestRoundTripBothDirections(t *testing.T) {
+	c, e := setup(t)
+	for i, msg := range []string{"first prompt", "second prompt"} {
+		f, err := c.Seal([]byte(msg))
+		require.NoError(t, err)
+		require.Equal(t, uint64(i), f.Seq)
+		pt, err := e.recv.open(f.Seq, f.Ciphertext)
+		require.NoError(t, err)
+		require.Equal(t, msg, string(pt))
+	}
+	chunks, err := c.OpenResponse(e.respond("s1", "tok1", "tok2", "tok3", ""))
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{[]byte("tok1"), []byte("tok2"), []byte("tok3"), {}}, chunks)
+	chunks, err = c.OpenResponse(e.respond("s1", "second response"))
+	require.NoError(t, err)
+	require.Equal(t, "second response", string(chunks[0]))
+}
+
+func TestRejections(t *testing.T) {
+	t.Run("replayed frame", func(t *testing.T) {
+		c, e := setup(t)
+		f, _ := c.Seal([]byte("x"))
+		_, err := e.recv.open(f.Seq, f.Ciphertext)
+		require.NoError(t, err)
+		_, err = e.recv.open(f.Seq, f.Ciphertext)
+		require.ErrorIs(t, err, ErrSequence)
+	})
+	t.Run("reordered frames", func(t *testing.T) {
+		c, e := setup(t)
+		_, _ = c.Seal([]byte("a"))
+		f2, _ := c.Seal([]byte("b"))
+		_, err := e.recv.open(f2.Seq, f2.Ciphertext)
+		require.ErrorIs(t, err, ErrSequence)
+	})
+	t.Run("tampered ciphertext", func(t *testing.T) {
+		c, e := setup(t)
+		f, _ := c.Seal([]byte("secret prompt"))
+		f.Ciphertext[0] ^= 1
+		_, err := e.recv.open(f.Seq, f.Ciphertext)
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("truncated response (final frame dropped)", func(t *testing.T) {
+		c, e := setup(t)
+		frames := e.respond("s1", "a", "b", "c", "d")
+		_, err := c.OpenResponse(frames[:2])
+		require.ErrorIs(t, err, ErrTruncated)
+	})
+	t.Run("empty response", func(t *testing.T) {
+		c, _ := setup(t)
+		_, err := c.OpenResponse(nil)
+		require.ErrorIs(t, err, ErrOpen) // 0 frames fails the power-of-two count rule
+	})
+	t.Run("final frame not last (spliced responses)", func(t *testing.T) {
+		c, e := setup(t)
+		first := e.respond("s1", "end of reply 1")
+		second := e.respond("s1", "reply 2")
+		_, err := c.OpenResponse(append(first, second...))
+		require.ErrorIs(t, err, ErrTruncated)
+	})
+	t.Run("reflected own frame", func(t *testing.T) {
+		c, _ := setup(t)
+		f, _ := c.Seal([]byte("x"))
+		_, err := c.OpenResponse([]Frame{{SessionID: "s1", Seq: 0, Ciphertext: f.Ciphertext}})
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("wrong challenge on the engine", func(t *testing.T) {
+		enginePriv, _ := ecdh.X25519().GenerateKey(rand.Reader)
+		key, _ := NewClientKey()
+		c, err := newSession("s1", make([]byte, 32), enginePriv.PublicKey().Bytes(), key.priv)
+		require.NoError(t, err)
+		other := make([]byte, 32)
+		other[0] = 1
+		e := newEngineSide(t, enginePriv, key.Public(), other)
+		f, _ := c.Seal([]byte("x"))
+		_, err = e.recv.open(f.Seq, f.Ciphertext)
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("wrong session id", func(t *testing.T) {
+		c, e := setup(t)
+		_, err := c.OpenResponse(e.respond("other", "x"))
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("session ends after a rejection", func(t *testing.T) {
+		c, e := setup(t)
+		frames := e.respond("s1", "a")
+		frames[0].Ciphertext[0] ^= 1
+		_, err := c.OpenResponse(frames)
+		require.ErrorIs(t, err, ErrOpen)
+		_, err = c.Seal([]byte("next"))
+		require.ErrorIs(t, err, ErrOpen)
+	})
+	t.Run("low-order engine key", func(t *testing.T) {
+		key, _ := NewClientKey()
+		_, err := newSession("s1", make([]byte, 32), make([]byte, 32), key.priv)
+		require.ErrorIs(t, err, ErrKey)
+	})
+	t.Run("establish rejects incomplete handshake", func(t *testing.T) {
+		_, _, err := Establish(testCfg(), nil, Handshake{SessionID: "s1", Challenge: make([]byte, 16)}, [][]byte{make([]byte, 32)})
+		require.ErrorIs(t, err, ErrKey)
+		key, _ := NewClientKey()
+		_, _, err = Establish(testCfg(), nil, Handshake{SessionID: "s1", Challenge: make([]byte, 32), Key: key, ClientData: make([]byte, 96)}, [][]byte{make([]byte, 32)})
+		require.ErrorIs(t, err, ErrBinding)
+	})
+}
+
+func TestCiphertextHidesPlaintext(t *testing.T) {
+	c, _ := setup(t)
+	canary := []byte("CANARY-PROMPT-7f3a")
+	f, err := c.Seal(canary)
+	require.NoError(t, err)
+	require.NotContains(t, string(f.Ciphertext), string(canary))
+	require.Len(t, f.Ciphertext, len(canary)+16)
+}
diff --git a/proxy-router/internal/sealed/weights.go b/proxy-router/internal/sealed/weights.go
new file mode 100644
index 00000000..04d5525d
--- /dev/null
+++ b/proxy-router/internal/sealed/weights.go
@@ -0,0 +1,71 @@
+package sealed
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// ErrModelDir means the model directory holds something outside the allowlist.
+var ErrModelDir = errors.New("sealed: model directory rejected")
+
+// allowedModelFiles mirrors sealed-engine ModelSnapshot.allowedNames; any
+// `*.safetensors` is also allowed.
+var allowedModelFiles = map[string]bool{
+	"config.json": true, "generation_config.json": true, "tokenizer.json": true, "tokenizer_config.json": true,
+	"special_tokens_map.json": true, "added_tokens.json": true, "vocab.json": true, "merges.txt": true,
+	"chat_template.jinja": true, "model.safetensors.index.json": true,
+}
+
+// WeightsManifestHash computes the weights hash a sealed engine binds into
+// every session and probe (must match sealed-engine ModelSnapshot):
+//
+//	SHA256 over, for each file sorted by name (byte order):
+//	name ‖ 0x00 ‖ SHA256(file contents) ‖ 0x0A
+//
+// Like the engine, it REFUSES a directory with any entry outside the allowlist
+// (hidden files, subdirectories, non-regular files after following symlinks),
+// so the hashed set and the loaded set can never differ. Publishers and
+// verifiers run it on a downloaded copy of the model to get the value to pin.
+func WeightsManifestHash(dir string) ([]byte, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	var names []string
+	for _, e := range entries {
+		name := e.Name()
+		if !allowedModelFiles[name] && !(strings.HasSuffix(name, ".safetensors") && !strings.HasPrefix(name, ".")) {
+			return nil, fmt.Errorf("%w: unexpected entry %q", ErrModelDir, name)
+		}
+		info, err := os.Stat(filepath.Join(dir, name)) // follows symlinks (Hugging Face caches)
+		if err != nil || !info.Mode().IsRegular() {
+			return nil, fmt.Errorf("%w: %q is not a regular file", ErrModelDir, name)
+		}
+		names = append(names, name)
+	}
+	sort.Strings(names) // byte order
+	manifest := sha256.New()
+	for _, name := range names {
+		f, err := os.Open(filepath.Join(dir, name))
+		if err != nil {
+			return nil, err
+		}
+		h := sha256.New()
+		_, err = io.Copy(h, f)
+		f.Close()
+		if err != nil {
+			return nil, err
+		}
+		manifest.Write([]byte(name))
+		manifest.Write([]byte{0})
+		manifest.Write(h.Sum(nil))
+		manifest.Write([]byte{0x0A})
+	}
+	return manifest.Sum(nil), nil
+}
diff --git a/proxy-router/internal/sealed/weights_test.go b/proxy-router/internal/sealed/weights_test.go
new file mode 100644
index 00000000..165e3efe
--- /dev/null
+++ b/proxy-router/internal/sealed/weights_test.go
@@ -0,0 +1,82 @@
+package sealed
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestWeightsManifestHash(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "model.safetensors"), []byte("BB"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "config.json"), []byte("A"), 0o600))
+
+	fa, fb := sha256.Sum256([]byte("A")), sha256.Sum256([]byte("BB"))
+	m := sha256.New()
+	for _, e := range []struct {
+		n string
+		h []byte
+	}{{"config.json", fa[:]}, {"model.safetensors", fb[:]}} {
+		m.Write([]byte(e.n))
+		m.Write([]byte{0})
+		m.Write(e.h)
+		m.Write([]byte{0x0A})
+	}
+	got, err := WeightsManifestHash(dir)
+	require.NoError(t, err)
+	require.Equal(t, hex.EncodeToString(m.Sum(nil)), hex.EncodeToString(got))
+
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "model.safetensors"), []byte("BX"), 0o600))
+	changed, err := WeightsManifestHash(dir)
+	require.NoError(t, err)
+	require.NotEqual(t, got, changed, "any weights change changes the hash")
+}
+
+// Every way to make the loader see weights the hash does not cover is refused.
+func TestWeightsManifestHashRejectsExtras(t *testing.T) {
+	base := func(t *testing.T) string {
+		d := t.TempDir()
+		require.NoError(t, os.WriteFile(filepath.Join(d, "config.json"), []byte("{}"), 0o600))
+		require.NoError(t, os.WriteFile(filepath.Join(d, "model.safetensors"), []byte("W"), 0o600))
+		return d
+	}
+	cases := map[string]func(t *testing.T, d string){
+		"hidden safetensors": func(t *testing.T, d string) {
+			require.NoError(t, os.WriteFile(filepath.Join(d, ".evil.safetensors"), []byte("X"), 0o600))
+		},
+		"subdirectory": func(t *testing.T, d string) {
+			require.NoError(t, os.Mkdir(filepath.Join(d, "sub"), 0o700))
+		},
+		"unknown file": func(t *testing.T, d string) {
+			require.NoError(t, os.WriteFile(filepath.Join(d, "notes.txt"), []byte("X"), 0o600))
+		},
+		"fifo posing as weights": func(t *testing.T, d string) {
+			require.NoError(t, syscall.Mkfifo(filepath.Join(d, "extra.safetensors"), 0o600))
+		},
+	}
+	for name, add := range cases {
+		t.Run(name, func(t *testing.T) {
+			d := base(t)
+			add(t, d)
+			_, err := WeightsManifestHash(d)
+			require.ErrorIs(t, err, ErrModelDir)
+		})
+	}
+}
+
+func TestWeightsManifestHashFollowsSymlinks(t *testing.T) {
+	real, linked, blobs := t.TempDir(), t.TempDir(), t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(real, "model.safetensors"), []byte("W"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(blobs, "abc123"), []byte("W"), 0o600))
+	require.NoError(t, os.Symlink(filepath.Join(blobs, "abc123"), filepath.Join(linked, "model.safetensors")))
+	a, err := WeightsManifestHash(real)
+	require.NoError(t, err)
+	b, err := WeightsManifestHash(linked)
+	require.NoError(t, err)
+	require.Equal(t, a, b, "a Hugging Face cache (symlinks) must hash like real files")
+}
