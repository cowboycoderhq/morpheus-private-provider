+				require.NoError(t, err)
+			}
+			require.Equal(t, c.want, got)
+		})
+	}
+	t.Run("unwired lane refuses", func(t *testing.T) {
+		_, err := (&ProxyServiceSender{}).sealedDecision(context.Background(), model)
+		require.ErrorIs(t, err, ErrSealedLaneUnwired)
+	})
+	t.Run("seen sealed once → never downgraded (owner re-tags)", func(t *testing.T) {
+		p := &ProxyServiceSender{}
