diff --git a/proxy-router/internal/attestation/appleattest/appleattest.go b/proxy-router/internal/attestation/appleattest/appleattest.go
new file mode 100644
index 00000000..6fe80eb9
--- /dev/null
+++ b/proxy-router/internal/attestation/appleattest/appleattest.go
@@ -0,0 +1,601 @@
+// Package appleattest verifies Apple App Attest attestations and assertions
+// locally (no third-party portal), following Apple's "Validating apps that
+// connect to your server" procedure, and exposes the authenticator-data
+// extensions macOS 27 adds — in particular the code-directory hash of the
+// running binary (apple_cd_hash_hash_01), which lets a consumer check exactly
+// which build is serving a session.
+//
+// The caller owns replay protection: the challenge (clientDataHash) must be
+// one the caller issued, and the assertion counter must be compared against
+// the last counter the caller stored for that key.
+//
+// Code identity fails closed: Config.ExpectedCDHashes must list the published
+// CD hash(es), or the caller must set AllowAnyCode explicitly. Pin the
+// ASSERTION's CD hash — it is measured for the binary serving this session.
+// Attestations are verified once per boot (App Attest keys do not survive a
+// restart); later assertions are checked against the verified *Attestation.
+package appleattest
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/sha256"
+	"crypto/subtle"
+	"crypto/x509"
+	_ "embed"
+	"encoding/asn1"
+	"encoding/binary"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/fxamacker/cbor/v2"
+)
+
+//go:embed apple_app_attestation_root_ca.pem
+var appleRootPEM []byte
+
+// AppleRootSHA256 pins the Apple App Attestation Root CA (valid 2020-03-18 → 2045-03-15).
+const AppleRootSHA256 = "1cb9823ba28ba6ad2d33a006941de2ae4f513ef1d4e831b9f7e0fa7b6242c932"
+
+var (
+	oidNonce  = asn1.ObjectIdentifier{1, 2, 840, 113635, 100, 8, 2}
+	oidOSInfo = asn1.ObjectIdentifier{1, 2, 840, 113635, 100, 8, 7}
+)
+
+// Context tags inside the OS-info extension (1.2.840.113635.100.8.7). Apple
+// does not document them; meanings are inferred from values that matched
+// sw_vers on macOS 27.0 (26A428): 1400 = OS version, 1403 = build, 1026 = platform.
+const (
+	osTagVersion  = 1400
+	osTagBuild    = 1403
+	osTagPlatform = 1026
+)
+
+// Environment is the App Attest environment an attestation must come from.
+type Environment int
+
+const (
+	Production Environment = iota
+	Development
+)
+
+var (
+	aaguidProduction  = append([]byte("appattest"), make([]byte, 7)...)
+	aaguidDevelopment = []byte("appattestdevelop")
+)
+
+// Extension keys in the authenticator-data CBOR map (macOS 27 / iOS 27).
+const (
+	ExtCDHash             = "apple_cd_hash_hash_01"
+	ExtCDHashType         = "apple_cd_hash_type_01"
+	ExtValidationCategory = "apple_validation_category_01"
+	ExtBundleVersion      = "apple_bundle_version_01"
+)
+
+// CDHashTypeSHA256 is the code-directory hash type for a full SHA-256 CD hash.
+const CDHashTypeSHA256 = 2
+
+var (
+	ErrFormat    = errors.New("appleattest: malformed input")
+	ErrChain     = errors.New("appleattest: certificate chain invalid")
+	ErrNonce     = errors.New("appleattest: nonce mismatch")
+	ErrKeyID     = errors.New("appleattest: key id mismatch")
+	ErrRPID      = errors.New("appleattest: relying party (app id) mismatch")
+	ErrCounter   = errors.New("appleattest: counter invalid")
+	ErrAAGUID    = errors.New("appleattest: wrong App Attest environment")
+	ErrSignature = errors.New("appleattest: assertion signature invalid")
+	ErrCode      = errors.New("appleattest: code identity (CD hash) not allowed")
+	ErrCategory  = errors.New("appleattest: validation category not allowed")
+	ErrConfig    = errors.New("appleattest: invalid verifier configuration")
+	ErrOSVersion = errors.New("appleattest: attesting device OS is older than the required minimum")
+)
+
+// Strict CBOR decoding: duplicate map keys, indefinite lengths and tags are rejected.
+var decMode = func() cbor.DecMode {
+	dm, err := cbor.DecOptions{
+		DupMapKey:   cbor.DupMapKeyEnforcedAPF,
+		IndefLength: cbor.IndefLengthForbidden,
+		TagsMd:      cbor.TagsForbidden,
+	}.DecMode()
+	if err != nil {
+		panic(err)
+	}
+	return dm
+}()
+
+// Config holds what a relying party pins.
+type Config struct {
+	// AppID is "<TeamID>.<BundleID>".
+	AppID       string
+	Environment Environment
+	// ExpectedCDHashes lists the SHA-256 code-directory hashes of the published
+	// builds allowed to serve. Required unless AllowAnyCode is set.
+	ExpectedCDHashes [][]byte
+	// AllowAnyCode disables the code-identity check. Tooling/tests only.
+	AllowAnyCode bool
+	// AllowedValidationCategories, if non-empty, requires the
+	// apple_validation_category_01 extension to be present and listed. The
+	// meaning of each value is not documented by Apple; 3 was observed for
+	// development-signed Mac apps. Not enforced when empty.
+	AllowedValidationCategories []uint32
+	// MinOSVersion, if set (e.g. "27.0.1"), rejects attestations from devices
+	// whose OS version (from the certificate) is older — a floor against
+	// known-unpatched macOS builds.
+	MinOSVersion string
+	// Now overrides the clock for certificate validity (tests); nil = time.Now.
+	Now func() time.Time
+	// roots overrides the embedded Apple root (tests only).
+	roots *x509.CertPool
+}
+
+// Extensions are the decoded authenticator-data extensions.
+type Extensions struct {
+	CDHash             []byte // SHA-256 code-directory hash of the attesting binary, if opted in
+	CDHashType         byte
+	ValidationCategory uint32 // little-endian as delivered; 3 observed for development-signed Mac apps
+	BundleVersion      string
+	Raw                map[string][]byte
+}
+
+// Attestation is a verified App Attest key.
+type Attestation struct {
+	KeyID      []byte
+	PublicKey  *ecdsa.PublicKey
+	Extensions Extensions
+	Leaf       *x509.Certificate
+	Receipt    []byte // not validated here; see Apple's fraud-metric receipt flow
+	OS         OSInfo
+	verified   bool
+}
+
+// OSInfo is the attesting device's OS as recorded in the certificate.
+type OSInfo struct {
+	Version  string // e.g. "27.0"
+	Build    string // e.g. "26A428"
+	Platform string // e.g. "macosx"
+}
+
+// Assertion is a verified per-request assertion.
+type Assertion struct {
+	Counter    uint32
+	Extensions Extensions
+}
+
+type attestationObject struct {
+	Fmt     string `cbor:"fmt"`
+	AttStmt struct {
+		X5C     [][]byte `cbor:"x5c"`
+		Receipt []byte   `cbor:"receipt"`
+	} `cbor:"attStmt"`
+	AuthData []byte `cbor:"authData"`
+}
+
+type assertionObject struct {
+	Signature         []byte `cbor:"signature"`
+	AuthenticatorData []byte `cbor:"authenticatorData"`
+}
+
+func (c *Config) now() time.Time {
+	if c.Now != nil {
+		return c.Now()
+	}
+	return time.Now()
+}
+
+func (c *Config) rootPool() (*x509.CertPool, error) {
+	if c.roots != nil {
+		return c.roots, nil
+	}
+	return AppleRootPool()
+}
+
+// AppleRootPool returns a pool holding only the pinned Apple App Attestation Root CA.
+func AppleRootPool() (*x509.CertPool, error) {
+	block, _ := pem.Decode(appleRootPEM)
+	if block == nil {
+		return nil, fmt.Errorf("%w: embedded root PEM", ErrFormat)
+	}
+	sum := sha256.Sum256(block.Bytes)
+	if fmt.Sprintf("%x", sum) != AppleRootSHA256 {
+		return nil, fmt.Errorf("%w: embedded root fingerprint mismatch", ErrChain)
+	}
+	root, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrFormat, err)
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(root)
+	return pool, nil
+}
+
+// VerifyAttestation validates an attestation object for keyID (the raw
+// SHA-256 of the key, i.e. base64-decoded keyId) against the challenge hash
+// the caller issued. It performs Apple's steps 1–9 (receipt excluded).
+func VerifyAttestation(cfg Config, attObj, keyID, clientDataHash []byte) (*Attestation, error) {
+	if err := cfg.validate(); err != nil {
+		return nil, err
+	}
+	if len(clientDataHash) != sha256.Size || len(keyID) != sha256.Size {
+		return nil, fmt.Errorf("%w: clientDataHash and keyID must be 32 bytes", ErrFormat)
+	}
+	var obj attestationObject
+	if err := decMode.Unmarshal(attObj, &obj); err != nil {
+		return nil, fmt.Errorf("%w: attestation cbor: %v", ErrFormat, err)
+	}
+	if obj.Fmt != "apple-appattest" || len(obj.AttStmt.X5C) < 2 {
+		return nil, fmt.Errorf("%w: fmt %q, %d certs", ErrFormat, obj.Fmt, len(obj.AttStmt.X5C))
+	}
+	// 1. Chain: leaf <- intermediate <- pinned Apple root, valid now.
+	leaf, err := x509.ParseCertificate(obj.AttStmt.X5C[0])
+	if err != nil {
+		return nil, fmt.Errorf("%w: leaf: %v", ErrFormat, err)
+	}
+	inters := x509.NewCertPool()
+	for _, der := range obj.AttStmt.X5C[1:] {
+		c, err := x509.ParseCertificate(der)
+		if err != nil {
+			return nil, fmt.Errorf("%w: intermediate: %v", ErrFormat, err)
+		}
+		inters.AddCert(c)
+	}
+	roots, err := cfg.rootPool()
+	if err != nil {
+		return nil, err
+	}
+	if _, err := leaf.Verify(x509.VerifyOptions{
+		Roots: roots, Intermediates: inters, CurrentTime: cfg.now(),
+		KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},
+	}); err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrChain, err)
+	}
+	// 2–4. nonce = SHA256(authData || clientDataHash) must equal the leaf's nonce extension exactly.
+	want := sha256.Sum256(append(append([]byte{}, obj.AuthData...), clientDataHash...))
+	got, err := leafNonce(leaf)
+	if err != nil {
+		return nil, err
+	}
+	if !bytes.Equal(got, want[:]) {
+		return nil, ErrNonce
+	}
+	// 5. keyID == SHA256(uncompressed leaf public key).
+	pub, ok := leaf.PublicKey.(*ecdsa.PublicKey)
+	if !ok || pub.Curve != elliptic.P256() {
+		return nil, fmt.Errorf("%w: leaf key is not P-256", ErrFormat)
+	}
+	raw, err := pub.Bytes()
+	if err != nil {
+		return nil, fmt.Errorf("%w: leaf key: %v", ErrFormat, err)
+	}
+	kh := sha256.Sum256(raw)
+	if !bytes.Equal(kh[:], keyID) {
+		return nil, ErrKeyID
+	}
+	ad, err := parseAuthData(obj.AuthData, true)
+	if err != nil {
+		return nil, err
+	}
+	// 6. rpIdHash == SHA256(AppID).
+	if err := checkRPID(cfg, ad.rpIDHash); err != nil {
+		return nil, err
+	}
+	// 7. counter == 0.
+	if ad.counter != 0 {
+		return nil, fmt.Errorf("%w: attestation counter %d", ErrCounter, ad.counter)
+	}
+	// 8. aaguid names the expected environment.
+	wantAAGUID := aaguidProduction
+	if cfg.Environment == Development {
+		wantAAGUID = aaguidDevelopment
+	}
+	if !bytes.Equal(ad.aaguid, wantAAGUID) {
+		return nil, fmt.Errorf("%w: aaguid %q", ErrAAGUID, ad.aaguid)
+	}
+	// 9. credentialId == keyID.
+	if !bytes.Equal(ad.credentialID, keyID) {
+		return nil, fmt.Errorf("%w: credential id", ErrKeyID)
+	}
+	if err := cfg.checkPolicy(ad.ext); err != nil {
+		return nil, err
+	}
+	osInfo := parseOSInfo(leaf)
+	if cfg.MinOSVersion != "" {
+		cmp, err := compareVersions(osInfo.Version, cfg.MinOSVersion)
+		if err != nil || cmp < 0 { // unknown or unparsable device version fails closed
+			return nil, fmt.Errorf("%w: device %q < minimum %q", ErrOSVersion, osInfo.Version, cfg.MinOSVersion)
+		}
+	}
+	return &Attestation{KeyID: keyID, PublicKey: pub, Extensions: ad.ext, Leaf: leaf, Receipt: obj.AttStmt.Receipt, OS: osInfo, verified: true}, nil
+}
+
+// VerifyAssertion validates an assertion made by att's key over the
+// challenge hash the caller issued. prevCounter is the last counter the
+// caller accepted for this key (0 right after attestation); the new counter
+// must be strictly greater, and the caller must store it.
+func VerifyAssertion(cfg Config, att *Attestation, assertion, clientDataHash []byte, prevCounter uint32) (*Assertion, error) {
+	if err := cfg.validate(); err != nil {
+		return nil, err
+	}
+	if att == nil || !att.verified || att.PublicKey == nil {
+		return nil, fmt.Errorf("%w: attestation not produced by VerifyAttestation", ErrFormat)
+	}
+	if len(clientDataHash) != sha256.Size {
+		return nil, fmt.Errorf("%w: clientDataHash must be 32 bytes", ErrFormat)
+	}
+	var obj assertionObject
+	if err := decMode.Unmarshal(assertion, &obj); err != nil {
+		return nil, fmt.Errorf("%w: assertion cbor: %v", ErrFormat, err)
+	}
+	nonce := sha256.Sum256(append(append([]byte{}, obj.AuthenticatorData...), clientDataHash...))
+	digest := sha256.Sum256(nonce[:])
+	if !ecdsa.VerifyASN1(att.PublicKey, digest[:], obj.Signature) {
+		return nil, ErrSignature
+	}
+	ad, err := parseAuthData(obj.AuthenticatorData, false)
+	if err != nil {
+		return nil, err
+	}
+	if err := checkRPID(cfg, ad.rpIDHash); err != nil {
+		return nil, err
+	}
+	if ad.counter <= prevCounter {
+		return nil, fmt.Errorf("%w: %d not greater than %d", ErrCounter, ad.counter, prevCounter)
+	}
+	if err := cfg.checkPolicy(ad.ext); err != nil {
+		return nil, err
+	}
+	return &Assertion{Counter: ad.counter, Extensions: ad.ext}, nil
+}
+
+func (c *Config) validate() error {
+	if c.AppID == "" {
+		return fmt.Errorf("%w: AppID required", ErrConfig)
+	}
+	if !c.AllowAnyCode && len(c.ExpectedCDHashes) == 0 {
+		return fmt.Errorf("%w: ExpectedCDHashes required (or AllowAnyCode)", ErrConfig)
+	}
+	for _, h := range c.ExpectedCDHashes {
+		if len(h) != sha256.Size {
+			return fmt.Errorf("%w: expected CD hash must be 32 bytes", ErrConfig)
+		}
+	}
+	if c.MinOSVersion != "" {
+		if _, err := parseVersion(c.MinOSVersion); err != nil {
+			return fmt.Errorf("%w: MinOSVersion %q: %v", ErrConfig, c.MinOSVersion, err)
+		}
+	}
+	return nil
+}
+
+// checkPolicy enforces code identity and validation category on signed extensions.
+func (c *Config) checkPolicy(ext Extensions) error {
+	if !c.AllowAnyCode {
+		if len(ext.CDHash) != sha256.Size || ext.CDHashType != CDHashTypeSHA256 {
+			return fmt.Errorf("%w: missing or non-SHA-256 CD hash", ErrCode)
+		}
+		ok := 0
+		for _, h := range c.ExpectedCDHashes {
+			ok |= subtle.ConstantTimeCompare(h, ext.CDHash)
+		}
+		if ok != 1 {
+			return ErrCode
+		}
+	}
+	if len(c.AllowedValidationCategories) > 0 {
+		if _, present := ext.Raw[ExtValidationCategory]; !present {
+			return fmt.Errorf("%w: category missing", ErrCategory)
+		}
+		allowed := false
+		for _, v := range c.AllowedValidationCategories {
+			allowed = allowed || v == ext.ValidationCategory
+		}
+		if !allowed {
+			return fmt.Errorf("%w: %d", ErrCategory, ext.ValidationCategory)
+		}
+	}
+	return nil
+}
+
+func checkRPID(cfg Config, rpIDHash []byte) error {
+	want := sha256.Sum256([]byte(cfg.AppID))
+	if cfg.AppID == "" || !bytes.Equal(rpIDHash, want[:]) {
+		return ErrRPID
+	}
+	return nil
+}
+
+// leafNonce extracts the octet string from the nonce extension:
+// SEQUENCE { [1] EXPLICIT OCTET STRING }.
+func leafNonce(leaf *x509.Certificate) ([]byte, error) {
+	for _, e := range leaf.Extensions {
+		if !e.Id.Equal(oidNonce) {
+			continue
+		}
+		var seq struct {
+			Nonce asn1.RawValue `asn1:"tag:1,explicit"`
+		}
+		rest, err := asn1.Unmarshal(e.Value, &seq)
+		if err != nil || len(rest) != 0 {
+			return nil, fmt.Errorf("%w: nonce extension", ErrFormat)
+		}
+		var octets []byte
+		rest, err = asn1.Unmarshal(seq.Nonce.Bytes, &octets)
+		if err != nil || len(rest) != 0 || len(octets) != sha256.Size {
+			return nil, fmt.Errorf("%w: nonce octets", ErrFormat)
+		}
+		return octets, nil
+	}
+	return nil, fmt.Errorf("%w: nonce extension missing", ErrNonce)
+}
+
+type authData struct {
+	rpIDHash     []byte
+	flags        byte
+	counter      uint32
+	aaguid       []byte
+	credentialID []byte
+	ext          Extensions
+}
+
+const (
+	flagAT = 0x40
+	flagED = 0x80
+)
+
+// parseAuthData decodes WebAuthn authenticator data. Attestations carry
+// attested credential data; App Attest assertions set the AT flag but carry
+// none, so credential parsing is gated on withCredential.
+func parseAuthData(b []byte, withCredential bool) (*authData, error) {
+	if len(b) < 37 {
+		return nil, fmt.Errorf("%w: authData %d bytes", ErrFormat, len(b))
+	}
+	ad := &authData{rpIDHash: b[:32], flags: b[32], counter: binary.BigEndian.Uint32(b[33:37])}
+	rest := b[37:]
+	if withCredential {
+		if ad.flags&flagAT == 0 || len(rest) < 18 {
+			return nil, fmt.Errorf("%w: attested credential data missing", ErrFormat)
+		}
+		ad.aaguid = rest[:16]
+		n := int(binary.BigEndian.Uint16(rest[16:18]))
+		if len(rest) < 18+n {
+			return nil, fmt.Errorf("%w: credential id length", ErrFormat)
+		}
+		ad.credentialID = rest[18 : 18+n]
+		rest = rest[18+n:]
+		// Skip the COSE credential public key (one CBOR item).
+		var cose cbor.RawMessage
+		dec := decMode.NewDecoder(bytes.NewReader(rest))
+		if err := dec.Decode(&cose); err != nil {
+			return nil, fmt.Errorf("%w: cose key: %v", ErrFormat, err)
+		}
+		rest = rest[dec.NumBytesRead():]
+	}
+	if ad.flags&flagED != 0 {
+		ext, err := parseExtensions(rest)
+		if err != nil {
+			return nil, err
+		}
+		ad.ext = ext
+	} else if len(rest) != 0 {
+		return nil, fmt.Errorf("%w: %d trailing bytes without ED flag", ErrFormat, len(rest))
+	}
+	return ad, nil
+}
+
+func parseExtensions(b []byte) (Extensions, error) {
+	// Unknown keys are tolerated with any CBOR type; known keys must be byte strings.
+	var items map[string]cbor.RawMessage
+	if err := decMode.Unmarshal(b, &items); err != nil {
+		return Extensions{}, fmt.Errorf("%w: extensions: %v", ErrFormat, err)
+	}
+	ext := Extensions{Raw: map[string][]byte{}}
+	for _, k := range []string{ExtCDHash, ExtCDHashType, ExtValidationCategory, ExtBundleVersion} {
+		rm, ok := items[k]
+		if !ok {
+			continue
+		}
+		var v []byte
+		if err := decMode.Unmarshal(rm, &v); err != nil {
+			return Extensions{}, fmt.Errorf("%w: extension %s is not a byte string", ErrFormat, k)
+		}
+		ext.Raw[k] = v
+	}
+	ext.CDHash = ext.Raw[ExtCDHash]
+	if v := ext.Raw[ExtCDHashType]; len(v) == 1 {
+		ext.CDHashType = v[0]
+	}
+	if v := ext.Raw[ExtValidationCategory]; len(v) == 4 {
+		ext.ValidationCategory = binary.LittleEndian.Uint32(v)
+	}
+	if v, ok := ext.Raw[ExtBundleVersion]; ok {
+		ext.BundleVersion = string(v)
+	}
+	return ext, nil
+}
+
+// parseOSInfo reads the OS-info extension: a SEQUENCE of context-tagged items,
+// each wrapping an OCTET STRING. Unknown or malformed items are skipped.
+func parseOSInfo(leaf *x509.Certificate) OSInfo {
+	var info OSInfo
+	for _, e := range leaf.Extensions {
+		if !e.Id.Equal(oidOSInfo) {
+			continue
+		}
+		var seq asn1.RawValue
+		if _, err := asn1.Unmarshal(e.Value, &seq); err != nil {
+			return info
+		}
+		rest := seq.Bytes
+		for len(rest) > 0 {
+			var item asn1.RawValue
+			var err error
+			rest, err = asn1.Unmarshal(rest, &item)
+			if err != nil {
+				return info
+			}
+			var val []byte
+			if _, err := asn1.Unmarshal(item.Bytes, &val); err != nil {
+				continue // not an OCTET STRING (e.g. INTEGER flags)
+			}
+			switch item.Tag {
+			case osTagVersion:
+				info.Version = string(val)
+			case osTagBuild:
+				info.Build = string(val)
+			case osTagPlatform:
+				info.Platform = string(val)
+			}
+		}
+	}
+	return info
+}
+
+// parseVersion parses a dotted numeric version ("27", "27.0.1"); any other
+// form is an error.
+func parseVersion(v string) ([]int, error) {
+	if v == "" {
+		return nil, errors.New("empty version")
+	}
+	parts := strings.Split(v, ".")
+	out := make([]int, len(parts))
+	for i, p := range parts {
+		n, err := strconv.Atoi(p)
+		if err != nil || n < 0 || p == "" {
+			return nil, fmt.Errorf("non-numeric part %q", p)
+		}
+		out[i] = n
+	}
+	return out, nil
+}
+
+// compareVersions compares dotted numeric versions ("27.0" vs "27.0.1").
+func compareVersions(a, b string) (int, error) {
+	pa, err := parseVersion(a)
+	if err != nil {
+		return 0, err
+	}
+	pb, err := parseVersion(b)
+	if err != nil {
+		return 0, err
+	}
+	for i := 0; i < len(pa) || i < len(pb); i++ {
+		var x, y int
+		if i < len(pa) {
+			x = pa[i]
+		}
+		if i < len(pb) {
+			y = pb[i]
+		}
+		if x != y {
+			if x < y {
+				return -1, nil
+			}
+			return 1, nil
+		}
+	}
+	return 0, nil
+}
