+func TestFixtureOSInfoAndMinimum(t *testing.T) {
+	f := loadFixture(t)
+	att, err := VerifyAttestation(cfgFor(f), f.attObj, f.keyID, f.attCDH)
+	require.NoError(t, err)
+	require.NotEmpty(t, att.OS.Version, "OS version must be read from the certificate")
+	require.NotEmpty(t, att.OS.Build)
+	t.Logf("attesting device: %s %s (%s)", att.OS.Platform, att.OS.Version, att.OS.Build)
+
+	ok := cfgFor(f)
+	ok.MinOSVersion = att.OS.Version
+	_, err = VerifyAttestation(ok, f.attObj, f.keyID, f.attCDH)
+	require.NoError(t, err, "device at exactly the minimum passes")
+
+	tooOld := cfgFor(f)
+	tooOld.MinOSVersion = att.OS.Version + ".99"
+	_, err = VerifyAttestation(tooOld, f.attObj, f.keyID, f.attCDH)
+	require.ErrorIs(t, err, ErrOSVersion)
+}
