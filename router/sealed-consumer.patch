+// cfgFor pins the expected CD hash when APPLEATTEST_EXPECT_CDHASH is set
+// (fixtures from an opted-in build); otherwise it opts out explicitly.
+func cfgFor(f fixture) Config {
+	c := Config{AppID: f.appID, Environment: Production}
+	if want := os.Getenv("APPLEATTEST_EXPECT_CDHASH"); want != "" {
+		h, err := hex.DecodeString(want)
+		if err == nil {
+			c.ExpectedCDHashes = [][]byte{h}
+			return c
+		}
+	}
+	c.AllowAnyCode = true
+	return c
+}
