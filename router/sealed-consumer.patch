+// A streaming client (the app's chat) gets a chat.completion.chunk delta and
+// [DONE]; before, it got one non-streaming message it could not read, and the
+// chat showed no answer.
+func TestSealedChunksMatchTheRequestedShape(t *testing.T) {
+	st := sealedChunks("1, 2, 3", true, "qwen")
+	require.Len(t, st, 2)
+	require.True(t, st[0].IsStreaming())
+	b, _ := json.Marshal(st[0].Data())
+	require.Contains(t, string(b), `"object":"chat.completion.chunk"`)
+	require.Contains(t, string(b), `"delta":{"content":"1, 2, 3","role":"assistant"}`)
+	require.Equal(t, "[DONE]", st[1].Data())
+	// The app's chat drops a stream event without an id.
+	require.Regexp(t, `"id":"chatcmpl-sealed-[0-9a-f]{24}"`, string(b))
+	require.Regexp(t, `"created":[1-9][0-9]+`, string(b))
+
+	one := sealedChunks("hello", false, "qwen")
+	require.Len(t, one, 1)
+	b, _ = json.Marshal(one[0].Data())
+	require.Contains(t, string(b), `"object":"chat.completion"`)
+	require.Contains(t, string(b), `"message":{"role":"assistant","content":"hello"}`)
+	require.Regexp(t, `"id":"chatcmpl-sealed-[0-9a-f]{24}"`, string(b))
