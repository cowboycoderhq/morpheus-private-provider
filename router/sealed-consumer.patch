diff --git a/proxy-router/internal/aiengine/sealed_mac.go b/proxy-router/internal/aiengine/sealed_mac.go
new file mode 100644
index 00000000..f639b60d
--- /dev/null
+++ b/proxy-router/internal/aiengine/sealed_mac.go
@@ -0,0 +1,101 @@
+package aiengine
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	gcs "github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/chatstorage/genericchatstorage"
+	"github.com/MorpheusAIs/Morpheus-Lumerin-Node/proxy-router/internal/lib"
+)
+
+// API_TYPE_SEALED_MAC is an attested sealed-engine on an Apple Silicon provider.
+// The provider never sees plaintext: prompts arrive already encrypted to the
+// engine's attested session key and are relayed as opaque bytes.
+const API_TYPE_SEALED_MAC = "sealed-mac"
+
+// ErrSealedPlaintext is returned for every plaintext request to a sealed model.
+var ErrSealedPlaintext = errors.New("sealed-mac model refuses plaintext requests; consumers must use sealed.relay")
+
+// SealedRelayer forwards opaque sealed-protocol bodies to the engine.
+type SealedRelayer interface {
+	SealedRelay(ctx context.Context, op string, body []byte) (int, []byte, error)
+}
+
+const sealedMaxResponse = 4 << 20
+
+type SealedMacEngine struct {
+	modelName string
+	baseURL   string
+	client    *http.Client
+	log       lib.ILogger
+}
+
+func NewSealedMacEngine(modelName, url string, timeout time.Duration, log lib.ILogger) *SealedMacEngine {
+	if timeout <= 0 {
+		timeout = 120 * time.Second
+	}
+	return &SealedMacEngine{modelName: modelName, baseURL: strings.TrimRight(url, "/"), client: &http.Client{Timeout: timeout}, log: log}
+}
+
+// SealedRelay maps a protocol op to the engine endpoint and returns its status
+// and body unmodified. Bodies are never logged or parsed.
+func (e *SealedMacEngine) SealedRelay(ctx context.Context, op string, body []byte) (int, []byte, error) {
+	var method, path string
+	switch op {
+	case "attest":
+		method, path = http.MethodGet, "/attest"
+	case "session":
+		method, path = http.MethodPost, "/session"
+	case "infer":
+		method, path = http.MethodPost, "/infer"
+	case "probe":
+		method, path = http.MethodPost, "/probe"
+	default:
+		return 0, nil, fmt.Errorf("sealed relay: unknown op %q", op)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, e.baseURL+path, bytes.NewReader(body))
+	if err != nil {
+		return 0, nil, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := e.client.Do(req)
+	if err != nil {
+		return 0, nil, fmt.Errorf("sealed relay: engine unreachable: %w", err)
+	}
+	defer resp.Body.Close()
+	out, err := io.ReadAll(io.LimitReader(resp.Body, sealedMaxResponse+1))
+	if err != nil {
+		return 0, nil, err
+	}
+	if len(out) > sealedMaxResponse {
+		return 0, nil, fmt.Errorf("sealed relay: engine response too large")
+	}
+	return resp.StatusCode, out, nil
+}
+
+func (e *SealedMacEngine) Prompt(context.Context, *gcs.OpenAICompletionRequestExtra, gcs.CompletionCallback) error {
+	return ErrSealedPlaintext
+}
+
+func (e *SealedMacEngine) AudioTranscription(context.Context, *gcs.AudioTranscriptionRequest, gcs.CompletionCallback) error {
+	return ErrSealedPlaintext
+}
+
+func (e *SealedMacEngine) AudioSpeech(context.Context, *gcs.AudioSpeechRequest, gcs.CompletionCallback) error {
+	return ErrSealedPlaintext
+}
+
+func (e *SealedMacEngine) Embeddings(context.Context, *gcs.EmbeddingsRequest, gcs.CompletionCallback) error {
+	return ErrSealedPlaintext
+}
+
+func (e *SealedMacEngine) ApiType() string { return API_TYPE_SEALED_MAC }
+
+var _ AIEngineStream = (*SealedMacEngine)(nil)
+var _ SealedRelayer = (*SealedMacEngine)(nil)
