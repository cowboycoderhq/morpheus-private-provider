+package codesig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// ---- DER entitlements ------------------------------------------------------
+
+func derTLV(tag byte, content ...[]byte) []byte {
+	c := bytes.Join(content, nil)
+	var l []byte
+	switch n := len(c); {
+	case n < 0x80:
+		l = []byte{byte(n)}
+	case n < 0x100:
+		l = []byte{0x81, byte(n)}
+	default:
+		l = []byte{0x82, byte(n >> 8), byte(n)}
+	}
+	return append(append([]byte{tag}, l...), c...)
+}
+
+func derStr(s string) []byte { return derTLV(derUTF8, []byte(s)) }
+
+func derEnt(pairs ...[]byte) []byte {
+	return derTLV(derEntitlement, derTLV(derInteger, []byte{1}), derTLV(derDict, pairs...))
+}
+
+func derPair(k string, v []byte) []byte { return derTLV(derSequence, derStr(k), v) }
+
+func TestDEREntitlements(t *testing.T) {
+	blob := derEnt(
+		derPair("com.apple.application-identifier", derStr("TEAMID1234.com.example.engine")),
+		derPair("com.apple.developer.devicecheck.app-attest-opt-in", derTLV(derSequence, derStr("CDhash"))),
+		derPair("com.apple.developer.team-identifier", derStr("TEAMID1234")),
+		derPair("flag", derTLV(derBoolean, []byte{0xff})),
+		derPair("n", derTLV(derInteger, []byte{0x01, 0x00})),
+		derPair("nested", derTLV(derDict, derPair("k", derStr("v")))),
+	)
+	got, err := decodeDEREntitlements(blob)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{
+		"com.apple.application-identifier":                  "TEAMID1234.com.example.engine",
+		"com.apple.developer.devicecheck.app-attest-opt-in": []any{"CDhash"},
+		"com.apple.developer.team-identifier":               "TEAMID1234",
+		"flag":                                              true,
+		"n":                                                 int64(256),
+		"nested":                                            map[string]any{"k": "v"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestDEREntitlementsRejects(t *testing.T) {
+	good := derPair("a", derStr("b"))
+	cases := map[string][]byte{
+		"duplicate key":     derEnt(good, good),
+		"trailing bytes":    append(derEnt(good), 0),
+		"version 2":         derTLV(derEntitlement, derTLV(derInteger, []byte{2}), derTLV(derDict, good)),
+		"pair with 3 elems": derEnt(derTLV(derSequence, derStr("a"), derStr("b"), derStr("c"))),
+		"non-string key":    derEnt(derTLV(derSequence, derTLV(derInteger, []byte{1}), derStr("b"))),
+		"bad boolean":       derEnt(derPair("a", derTLV(derBoolean, []byte{1}))),
+		"non-minimal int":   derEnt(derPair("a", derTLV(derInteger, []byte{0, 1}))),
+		"non-minimal len":   {derEntitlement, 0x81, 0x05, 0x02, 0x01, 0x01, 0xb0, 0x00},
+		"unknown tag":       derEnt(derPair("a", derTLV(0x04, []byte("x")))),
+		"truncated":         derEnt(good)[:10],
+	}
+	for name, b := range cases {
+		if _, err := decodeDEREntitlements(b); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+}
+
+// ---- XML plist ---------------------------------------------------------------
+
+const plistHead = `<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">`
+
+func TestXMLPlist(t *testing.T) {
+	v, err := decodeXMLPlist([]byte(plistHead + `<dict><key>a</key><string>x</string><key>b</key><array><string>y</string></array>
+	<key>c</key><true/><key>d</key><data>AAEC</data><key>e</key><integer>-3</integer><key>f</key><array/></dict></plist>`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{"a": "x", "b": []any{"y"}, "c": true, "d": []byte{0, 1, 2}, "e": int64(-3), "f": []any{}}
+	if !reflect.DeepEqual(v, want) {
+		t.Fatalf("got %#v", v)
+	}
+	for name, s := range map[string]string{
+		"duplicate key": `<dict><key>a</key><string>x</string><key>a</key><string>y</string></dict>`,
+		"two roots":     `<dict/><dict/>`,
+		"key w/o value": `<dict><key>a</key></dict>`,
+		"unknown elem":  `<dict><key>a</key><uid>1</uid></dict>`,
+		"bad real":      `<dict><key>a</key><real>x</real></dict>`,
+		"bad date":      `<dict><key>a</key><date>yesterday</date></dict>`,
+		"stray text":    `<dict>oops<key>a</key><string>x</string></dict>`,
+		"value w/o key": `<dict><string>x</string></dict>`,
+		"unclosed":      `<dict><key>a</key><string>x</string>`,
+	} {
+		if _, err := decodeXMLPlist([]byte(plistHead + s + `</plist>`)); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+}
+
+// ---- Real published/rebuild pair --------------------------------------------
+//
+// SEALED_REPRO_PUBLISHED  a signed app from `build-reproducible.sh sign`
+// SEALED_REPRO_REBUILD    an app from `build-reproducible.sh verify` of the same source
+// SEALED_REPRO_APPID      <TeamID>.<BundleID>
+// SEALED_REPRO_CDHASH     optional: the published CD hash
+// SEALED_REPRO_OTHER      optional: a verify build of different source (must be rejected)
+// These name the signing team, so they stay out of the repository.
+
+func pair(t *testing.T) (pub, reb string, want Expect) {
+	pub, reb, appID := os.Getenv("SEALED_REPRO_PUBLISHED"), os.Getenv("SEALED_REPRO_REBUILD"), os.Getenv("SEALED_REPRO_APPID")
+	if pub == "" || reb == "" || appID == "" {
+		t.Skip("SEALED_REPRO_PUBLISHED, SEALED_REPRO_REBUILD and SEALED_REPRO_APPID not set")
+	}
+	team, bundle, ok := strings.Cut(appID, ".")
+	if !ok {
+		t.Fatal("SEALED_REPRO_APPID must be TEAM.bundle")
+	}
+	want = Expect{Team: team, BundleID: bundle}
+	if h := os.Getenv("SEALED_REPRO_CDHASH"); h != "" {
+		var err error
+		if want.CDHash, err = hex.DecodeString(h); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return pub, reb, want
+}
+
+func report(t *testing.T, r *Result) {
+	t.Helper()
+	for _, c := range r.Checks {
+		t.Logf("pass=%v %-20s %s", c.Pass, c.Name, c.Detail)
+	}
+}
+
+func TestRealPairMatches(t *testing.T) {
+	pub, reb, want := pair(t)
+	r := Compare(pub, reb, want)
+	report(t, r)
+	if !r.OK {
+		t.Fatal("honest pair rejected")
+	}
+	t.Logf("CD hash App Attest will report: %s", r.CDHash)
+}
+
+// copyApp clones a bundle (APFS clone where possible) so a test can alter the copy.
+func copyApp(t *testing.T, src string) string {
+	dst := filepath.Join(t.TempDir(), "SealedEngine.app")
+	if out, err := exec.Command("cp", "-Rc", src, dst).CombinedOutput(); err != nil {
+		if out, err = exec.Command("cp", "-R", src, dst).CombinedOutput(); err != nil {
+			t.Fatalf("copy: %v %s", err, out)
+		}
+	}
+	return dst
+}
+
+func rewrite(t *testing.T, path string, f func([]byte) []byte) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, f(b), 0o755); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func failedCheck(r *Result) []string {
+	var names []string
+	for _, c := range r.Checks {
+		if !c.Pass {
+			names = append(names, c.Name)
+		}
+	}
+	return names
+}
+
+// Each case changes the rebuild (or the expectation) in one way; Compare must
+// reject it, and the named check must be among the failures.
+func TestRealPairMismatches(t *testing.T) {
+	pub, reb, want := pair(t)
+	exe := func(app string) string { return filepath.Join(app, exeRel) }
+	cases := []struct {
+		name, check string
+		edit        func(t *testing.T, app string)
+		want        func(Expect) Expect
+	}{
+		{"code byte in a middle page", "executable", func(t *testing.T, app string) {
+			rewrite(t, exe(app), func(b []byte) []byte { b[len(b)/2] ^= 1; return b })
+		}, nil},
+		{"code byte in the last page", "executable", func(t *testing.T, app string) {
+			rewrite(t, exe(app), func(b []byte) []byte { b[len(b)-1] ^= 1; return b })
+		}, nil},
+		{"load command byte in page 0", "executable", func(t *testing.T, app string) {
+			rewrite(t, exe(app), func(b []byte) []byte { b[mhSize+40] ^= 1; return b })
+		}, nil},
+		{"extra bytes appended", "executable", func(t *testing.T, app string) {
+			rewrite(t, exe(app), func(b []byte) []byte { return append(b, make([]byte, 64<<10)...) })
+		}, nil},
+		{"Info.plist changed", "Info.plist", func(t *testing.T, app string) {
+			rewrite(t, filepath.Join(app, "Contents/Info.plist"), func(b []byte) []byte { return append(b, '\n') })
+		}, nil},
+		{"resource changed", "resources", func(t *testing.T, app string) {
+			rewrite(t, filepath.Join(app, "Contents/Resources/mlx-swift_Cmlx.bundle/Contents/Resources/default.metallib"),
+				func(b []byte) []byte { b[len(b)/2] ^= 1; return b })
+		}, nil},
+		{"extra file", "bundle layout", func(t *testing.T, app string) {
+			if err := os.WriteFile(filepath.Join(app, "Contents/Resources/extra.txt"), []byte("x"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}, nil},
+		{"unsealed PkgInfo changed", "resources", func(t *testing.T, app string) {
+			rewrite(t, filepath.Join(app, "Contents/PkgInfo"), func(b []byte) []byte { b[0] ^= 1; return b })
+		}, nil},
+		{"missing file", "bundle layout", func(t *testing.T, app string) {
+			if err := os.Remove(filepath.Join(app, "Contents/PkgInfo")); err != nil {
+				t.Fatal(err)
+			}
+		}, nil},
+		{"symlink", "bundle layout", func(t *testing.T, app string) {
+			if err := os.Symlink("/etc/hosts", filepath.Join(app, "Contents/Resources/link")); err != nil {
+				t.Fatal(err)
+			}
+		}, nil},
+		{"wrong team", "identity", nil, func(e Expect) Expect { e.Team = "AAAAAAAAAA"; return e }},
+		{"wrong bundle ID", "identity", nil, func(e Expect) Expect { e.BundleID = "com.example.other"; return e }},
+		{"wrong published CD hash", "published CD hash", nil, func(e Expect) Expect { e.CDHash = make([]byte, 32); return e }},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			app, w := reb, want
+			if c.edit != nil {
+				app = copyApp(t, reb)
+				c.edit(t, app)
+			}
+			if c.want != nil {
+				w = c.want(w)
+			}
+			r := Compare(pub, app, w)
+			if r.OK {
+				report(t, r)
+				t.Fatal("accepted")
+			}
+			if f := failedCheck(r); !contains(f, c.check) {
+				t.Fatalf("failed %v, want %q among them", f, c.check)
+			}
+		})
+	}
+	// Changes to signer-only CodeDirectory fields of a copy of the published
+	// app. The CMS signature is not what the verifier relies on (App Attest
+	// pins the CD hash), so each change must be caught by its field check.
+	cdEdits := []struct {
+		name, check string
+		edit        func(cd []byte)
+	}{
+		{"platform binary", "signature", func(cd []byte) { cd[38] = 1 }},
+		{"version 0x20700", "signature", func(cd []byte) { cd[8], cd[9], cd[10], cd[11] = 0, 2, 7, 0 }},
+		{"runtime version lowered", "executable", func(cd []byte) { be.PutUint32(cd[88:], 0x000a0000) }},
+		{"exec-segment flag added", "code flags", func(cd []byte) { cd[86] |= 0x04 }},
+		{"get-task-allow flag", "code flags", func(cd []byte) { cd[15] |= csGetTaskAllow }},
+	}
+	for _, c := range cdEdits {
+		t.Run("published "+c.name, func(t *testing.T) {
+			app := copyApp(t, pub)
+			sig, err := ReadSignature(filepath.Join(app, exeRel))
+			if err != nil {
+				t.Fatal(err)
+			}
+			off := bytes.Index(sig.File, sig.CD.Raw)
+			rewrite(t, filepath.Join(app, exeRel), func(b []byte) []byte { c.edit(b[off : off+len(sig.CD.Raw)]); return b })
+			w := want
+			w.CDHash = nil
+			r := Compare(app, reb, w)
+			if r.OK {
+				report(t, r)
+				t.Fatal("accepted")
+			}
+			if f := failedCheck(r); !contains(f, c.check) {
+				t.Fatalf("failed %v, want %q among them", f, c.check)
+			}
+		})
+	}
+	t.Run("published extra requirement", func(t *testing.T) {
+		app := copyApp(t, pub)
+		sig, err := ReadSignature(filepath.Join(app, exeRel))
+		if err != nil {
+			t.Fatal(err)
+		}
+		off := bytes.Index(sig.File, sig.RequirementsRaw)
+		rewrite(t, filepath.Join(app, exeRel), func(b []byte) []byte { be.PutUint32(b[off+12:], 2); return b }) // type 3 -> 2 (host)
+		w := want
+		w.CDHash = nil
+		if r := Compare(app, reb, w); r.OK || !contains(failedCheck(r), "requirements") {
+			t.Fatalf("failed %v, want requirements", failedCheck(r))
+		}
+	})
+
+	if other := os.Getenv("SEALED_REPRO_OTHER"); other != "" {
+		t.Run("different source", func(t *testing.T) {
+			r := Compare(pub, other, want)
+			report(t, r)
+			if r.OK {
+				t.Fatal("a build of different source was accepted")
+			}
+		})
+	}
+}
+
+func contains(s []string, x string) bool {
+	for _, v := range s {
+		if v == x {
+			return true
+		}
+	}
+	return false
+}
